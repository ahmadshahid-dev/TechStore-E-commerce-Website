<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>500 - Server Error | TechStore</title>
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 
min-h-screen flex flex-col antialiased selection:bg-orange-500 selection:text-white">
  <!-- Header -->
  <%- include("../partials/header") %>
  <!-- Main Content -->
  <main class="flex-grow flex items-center justify-center py-8 sm:py-10 lg:py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Glowing Graphic Backdrop -->
      <div class="relative h-32 w-32 mx-auto mb-8">
        <div class="bg-orange-500/20 dark:bg-orange-500/15 blur-3xl absolute inset-0 rounded-full animate-pulse"></div>
        <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 relative h-32 w-32 flex items-center justify-center border-2 border-orange-200/80 dark:border-orange-500/20 rounded-full shadow-xl shadow-orange-500/10">
          <svg class="h-14 w-14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
      </div>
      <!-- 500 Badge -->
      <div class="bg-orange-100 dark:bg-orange-500/10 text-orange-700 dark:text-orange-400 inline-flex items-center gap-2 py-2 px-4 mb-5 rounded-full border border-orange-200/60 dark:border-orange-500/20">
        <span class="bg-orange-600 dark:bg-orange-400 h-2 w-2 rounded-full animate-ping"></span>
        <span class="text-xs font-montserrat font-bold leading-none uppercase tracking-widest">Error 500 • Server Issue</span>
      </div>
      <!-- Heading & Copy -->
      <h1 class="text-slate-900 dark:text-white text-3xl sm:text-5xl font-montserrat font-extrabold leading-none tracking-tight mb-3.5">
        Internal <span class="text-orange-600 dark:text-orange-400">Server Error</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base font-inter leading-relaxed max-w-lg mx-auto mb-6">
        We encountered an unexpected hiccup on our end while processing your request. Our team has been notified and is already on it.
      </p>
      <!-- Primary & Secondary Action CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 mb-10">
        <a class="bg-orange-600 text-white w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-2xl shadow-lg shadow-orange-600/25 py-4 px-8 hover:bg-orange-700 active:scale-[0.98] transition ease-out duration-[250ms]" href="/">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span class="text-sm font-montserrat font-semibold leading-none">Back to Home</span>
        </a>
        <a class="bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 w-full sm:w-auto inline-flex items-center justify-center gap-2 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm py-4 px-6 hover:bg-slate-50 dark:hover:bg-slate-800/80" href="/contact">
          <span class="text-sm font-montserrat font-semibold leading-none">Contact Support</span>
        </a>
      </div>
      <!-- Helpful Quick Links -->
      <div class="border-t border-slate-200 dark:border-slate-800 space-y-2 pt-6">
        <p class="text-slate-400 text-xs font-inter">Popular destinations:</p>
        <div class="flex flex-wrap items-center justify-center gap-x-2.5">
          <a class="text-slate-600 dark:text-slate-300 text-xs font-inter underline hover:text-orange-600 dark:hover:text-orange-400" href="/category/headphones">
            Headphones
          </a>
          <span>•</span>
          <a class="text-slate-600 dark:text-slate-300 text-xs font-inter underline hover:text-orange-600 dark:hover:text-orange-400" href="/category/keyboards">
            Keyboards
          </a>
          <span>•</span>
          <a class="text-slate-600 dark:text-slate-300 text-xs font-inter underline hover:text-orange-600 dark:hover:text-orange-400" href="/category/mice">
            Gaming Mice
          </a>
          <span>•</span>
          <a class="text-slate-600 dark:text-slate-300 text-xs font-inter underline hover:text-orange-600 dark:hover:text-orange-400" href="/contact">
            Contact Support
          </a>
        </div>
      </div>
    </div>
  </main>
  <!-- Footer -->
  <%- include("../partials/footer") %>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/app.js"></script>
</body>

</html>