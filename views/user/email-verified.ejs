<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TechStore | Email Verified</title>
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased selection:bg-orange-500 selection:text-white">
  <!-- Header -->
  <%- include("../partials/header") %>
  <!-- Main -->
  <main>
    <!-- ==================== Page Top Banner ==================== -->
    <section class="relative text-center pt-12 pb-8 sm:pt-12 sm:pb-8 lg:pt-16 lg:pb-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Decorative Glow Background Effects -->
        <div class="bg-emerald-500/10 dark:bg-emerald-500/15 h-96 w-96 absolute -top-24 left-1/2 -translate-x-1/2 rounded-full blur-3xl pointer-events-none"></div>
        <div class="max-w-3xl mx-auto relative z-10">
          <div class="flex flex-col space-y-5.5 items-center justify-center">
            <!-- Glowing Success Badge Icon -->
            <div class="inline-flex items-center justify-center relative mb-8">
              <div class="bg-emerald-500/20 dark:bg-emerald-500/30 absolute inset-0 rounded-full blur-xl animate-pulse"></div>
              <div class="bg-gradient-to-tr from-emerald-600 to-teal-500 text-white relative h-20 w-20 sm:h-24 sm:w-24 flex items-center justify-center rounded-full shadow-xl shadow-emerald-500/25 ring-10 ring-emerald-500/10 dark:ring-emerald-500/20">
                <svg class="h-10 w-10 sm:h-12 sm:w-12 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>
            <!-- Header Status Pill -->
            <span class="bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 w-fit inline-flex items-center gap-x-2.5 border border-emerald-300 dark:border-emerald-800/80 rounded-full py-2.5 px-5">
              <span class="bg-emerald-500 h-1.5 w-1.5 rounded-full animate-ping"></span>
              <span class="text-xs sm:text-sm font-montserrat font-semibold leading-none">Email Verified Successfully</span>
            </span>
            <!-- Heading -->
            <h1 class="text-slate-900 dark:text-white text-3xl sm:text-4xl md:text-5xl font-montserrat font-extrabold tracking-tight mb-4">
              <span class="text-orange-600 dark:text-orange-400">Thank You!</span>
              Your Email is
              <span class="text-orange-600 dark:text-orange-400">Verified</span>
            </h1>
            <!-- Clean English Description (No Email, No Extra Chips) -->
            <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base font-inter leading-relaxed max-w-2xl mx-auto">
              Thank you for choosing TechStore! Your email address has been verified successfully and your account is now fully activated. You can now access your profile, track your orders, and enjoy a seamless shopping experience.
            </p>
            <a class="bg-orange-600 text-white w-fit flex items-center justify-center gap-x-2.5 rounded-xl cursor-pointer shadow-lg shadow-orange-600/25 py-4 px-8 mt-1 hover:bg-orange-700 transition ease-out duration-[250ms]" href="/@<%= user.username %>/profile-overview">
              <span class="text-sm font-montserrat font-semibold">Back To Profile</span>
              <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14" />
                <path d="m19 12-7 7-7-7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <!-- Footer -->
  <%- include("../partials/footer") %>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/user.js"></script>
</body>

</html>