<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>My Orders | TechStore</title>
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased selection:bg-orange-500 selection:text-white">
  <!-- Header -->
  <%- include("../partials/header") %>
  <!-- Main -->
  <main>
    <!-- ==================== PAGE HEADER BANNER ==================== -->
    <section class="bg-white/60 dark:bg-slate-900/60 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 py-8 sm:py-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <!-- Breadcrumbs & Heading -->
          <div class="space-y-1.5">
            <div class="text-slate-500 dark:text-slate-400 text-xs font-inter flex items-center gap-2">
              <a class="hover:text-orange-600 dark:hover:text-orange-400 hover:transition-colors" href="/">Home</a>
              <span>/</span>
              <a class="hover:text-orange-600 dark:hover:text-orange-400 hover:transition-colors" href="/<%= '@' + user?.username %>/profile-overview">Account</a>
              <span>/</span>
              <span class="text-slate-800 dark:text-slate-200 font-semibold">My Orders</span>
            </div>
            <h1 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-extrabold leading-none tracking-tight">
              Order <span class="text-orange-600 dark:text-orange-400">History</span>
            </h1>
            <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm font-inter">
              Track recent shipments, inspect order summaries, or download previous invoices.
            </p>
          </div>
          <!-- Continue Shopping CTA -->
          <a href="/shop" class="bg-orange-600 text-white w-fit inline-flex items-center gap-x-2 rounded-xl py-3 px-5 hover:bg-orange-700 active:scale-[0.98] transition ease-out duration-200">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <span class="text-xs sm:text-sm font-montserrat font-semibold">Browse Products</span>
          </a>
        </div>
      </div>
    </section>
    <!-- ==================== MAIN SECTIONS & CONTENT ==================== -->
    <section class="backdrop-blur-md py-8 sm:py-10 overflow-hidden">
      <% if (!orders || orders.length === 0) { %>
      <!-- Empty State -->
      <div class="max-w-md mx-auto space-y-6 text-center py-8 sm:py-10 px-4">
        <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 h-24 w-24 flex items-center justify-center mx-auto border border-orange-200/80 dark:border-orange-900/50 rounded-3xl shadow-sm">
          <svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
        </div>
        <div class="space-y-2">
          <h2 class="text-slate-900 dark:text-white text-2xl font-montserrat font-bold">
            No Orders Found Yet
          </h2>
          <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm font-inter leading-relaxed">
            You haven't placed any orders with TechStore yet. Discover our tech gadgets and gaming accessories!
          </p>
        </div>
        <a class="bg-orange-600 text-white inline-flex items-center gap-x-2 rounded-xl py-3.5 px-8 shadow-lg shadow-orange-500/25 hover:bg-orange-700 active:scale-[0.98] transition ease-out duration-200" href="/shop">
          <span class="text-xs sm:text-sm font-montserrat font-semibold">Start Shopping Now</span>
        </a>
      </div>
      <% } else { %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- KPI Summary Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 mb-8 sm:mb-10">
          <% 
            const totalOrders = orders.length;
            const deliveredOrders = orders.filter(order => order.orderStatus === 'Delivered').length;
            const processingOrders = orders.filter(order => order.orderStatus !== 'Delivered' && order.orderStatus !== 'Cancelled').length;
          %>
          <div class="bg-white dark:bg-slate-900 flex items-center justify-between border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm p-5">
            <div>
              <p class="text-slate-500 dark:text-slate-400 text-xs font-inter font-semibold uppercase tracking-wider">Total Orders</p>
              <h3 class="text-slate-900 dark:text-white text-2xl font-montserrat font-extrabold mt-1"><%= totalOrders %></h3>
            </div>
            <div class="bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 h-11 w-11 flex items-center justify-center rounded-xl">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
            </div>
          </div>
          <div class="bg-white dark:bg-slate-900 flex items-center justify-between border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm p-5">
            <div>
              <p class="text-slate-500 dark:text-slate-400 text-xs font-inter font-semibold uppercase tracking-wider">In Progress</p>
              <h3 class="text-orange-600 dark:text-orange-400 text-2xl font-montserrat font-extrabold mt-1"><%= processingOrders %></h3>
            </div>
            <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 h-11 w-11 flex items-center justify-center rounded-xl">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
          </div>
          <div class="bg-white dark:bg-slate-900 flex items-center justify-between border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm p-5">
            <div>
              <p class="text-slate-500 dark:text-slate-400 text-xs font-inter font-semibold uppercase tracking-wider">Delivered</p>
              <h3 class="text-emerald-600 dark:text-emerald-400 text-2xl font-montserrat font-extrabold mt-1"><%= deliveredOrders %></h3>
            </div>
            <div class="bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 h-11 w-11 flex items-center justify-center rounded-xl">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
          </div>
        </div>
        <!-- Filter Chips Bar -->
        <div class="flex items-center gap-2 overflow-x-auto pb-6 [scrollbar-width:none]">
          <button type="button" data-status="All" class="orderStatus-chip active-chip bg-orange-600 text-white text-xs font-montserrat font-bold rounded-xl shadow-sm shadow-orange-500/20 cursor-pointer whitespace-nowrap py-2 px-4 hover:transition hover:ease-out hover:duration-[250ms]">
            All Orders (<%= totalOrders %>)
          </button>
          <button class="orderStatus-chip bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold border border-slate-200 dark:border-slate-800 rounded-xl cursor-pointer whitespace-nowrap py-2 px-4 hover:bg-slate-100 dark:hover:bg-slate-800 hover:transition hover:ease-out hover:duration-[250ms]" type="button" data-status="Processing">
            Processing
          </button>
          <button class="orderStatus-chip bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold border border-slate-200 dark:border-slate-800 rounded-xl cursor-pointer whitespace-nowrap py-2 px-4 hover:bg-slate-100 dark:hover:bg-slate-800 hover:transition hover:ease-out hover:duration-[250ms]" type="button" data-status="Shipped">
            Shipped
          </button>
          <button class="orderStatus-chip bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold border border-slate-200 dark:border-slate-800 rounded-xl cursor-pointer whitespace-nowrap py-2 px-4 hover:bg-slate-100 dark:hover:bg-slate-800 hover:transition hover:ease-out hover:duration-[250ms]" type="button" data-status="Delivered">
            Delivered
          </button>
          <button class="orderStatus-chip bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold border border-slate-200 dark:border-slate-800 rounded-xl cursor-pointer whitespace-nowrap py-2 px-4 hover:bg-slate-100 dark:hover:bg-slate-800 hover:transition hover:ease-out hover:duration-[250ms]" type="button" data-status="Cancelled">
            Cancelled
          </button>
        </div>
        <!-- Orders Cards List -->
        <div class="space-y-6">
          <% orders.forEach((order) => { %>
          <div class="order-card bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-3xl overflow-hidden shadow-sm hover:shadow-md hover:transition hover:ease-in-out hover:duration-300" data-status="<%= order.orderStatus %>">
            <!-- Order Card Header -->
            <div class="bg-slate-50/70 dark:bg-slate-800/40 p-5 sm:px-6 border-b border-slate-100 dark:border-slate-800/80 flex flex-wrap items-center justify-between gap-4">
              <div class="flex flex-wrap items-center gap-y-2 gap-x-6 text-xs font-inter">
                <div>
                  <span class="text-slate-400 text-[10px] font-inter font-semibold uppercase tracking-wider block">Order ID</span>
                  <span class="text-slate-800 dark:text-slate-200 font-montserrat font-mono font-bold">#<%= order.orderId %></span>
                </div>
                <div>
                  <span class="text-slate-400 text-[10px] font-inter font-semibold uppercase tracking-wider block">Placed On</span>
                  <span class="text-slate-700 dark:text-slate-300 font-inter font-medium">
                    <%= new Date(order.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                  </span>
                </div>
                <div>
                  <span class="text-slate-400 block font-semibold uppercase tracking-wider text-[10px]">Total Paid</span>
                  <span class="font-montserrat font-bold text-orange-600 dark:text-orange-400">Rs <%= (order.grandTotal).toLocaleString() %></span>
                </div>
              </div>
              <!-- Status Pill Badge -->
              <div class="flex items-center gap-x-3">
                <%
                  let badgeClass = 'bg-amber-100 dark:bg-amber-950/70 text-amber-800 dark:text-amber-300 border-amber-300 dark:border-amber-800';
                  if (order.orderStatus === 'Confirmed') badgeClass = 'bg-blue-100 dark:bg-blue-950/70 text-blue-800 dark:text-blue-300 border-blue-300 dark:border-blue-800';
                  if (order.orderStatus === 'Processing') badgeClass = 'bg-purple-100 dark:bg-purple-950/70 text-purple-800 dark:text-purple-300 border-purple-300 dark:border-purple-800';
                  if (order.orderStatus === 'Shipped') badgeClass = 'bg-indigo-100 dark:bg-indigo-950/70 text-indigo-800 dark:text-indigo-300 border-indigo-300 dark:border-indigo-800';
                  if (order.orderStatus === 'Delivered') badgeClass = 'bg-emerald-100 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800';
                  if (order.orderStatus === 'Cancelled') badgeClass = 'bg-rose-100 dark:bg-rose-950/70 text-rose-800 dark:text-rose-300 border-rose-300 dark:border-rose-800';
                %>
                <span class="text-xs font-inter font-semibold inline-flex items-center gap-1.5 border rounded-full py-1 px-2.5 <%= badgeClass %>">
                  <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
                  <%= order.orderStatus %>
                </span>
                <!-- View Summary Button (Modal Trigger) -->
                <button class="openTrigger bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 text-xs font-montserrat font-semibold border border-slate-200 dark:border-slate-700 rounded-xl cursor-pointer py-1.5 px-4 hover:bg-orange-50 dark:hover:bg-orange-950/50 hover:text-orange-600 dark:hover:text-orange-400 hover:transition-colors hover:ease-out hover:duration-200" type="button" data-model="orderModel" data-order="<%= JSON.stringify(order) %>">
                  View Details
                </button>
              </div>
            </div>
            <!-- Items Preview List inside the card -->
            <div class="divide-y divide-slate-100 dark:divide-slate-800/60 p-5 sm:p-6">
              <% if (order.items && order.items.length > 0) { %>
              <% order.items.forEach(item => { %>
              <div class="flex items-center justify-between gap-4 first:pt-0 last:pb-0 py-3">
                <div class="flex items-center gap-4">
                  <div class="bg-slate-100 dark:bg-slate-800 h-14 w-14 flex items-center justify-center border border-slate-200/80 dark:border-slate-700/80 rounded-xl shrink-0 overflow-hidden">
                    <% if (item.image) { %>
                    <img class="h-full w-full object-contain" src="<%= item.image %>" alt="<%= item.name %>" />
                    <% } else { %>
                    <svg class="text-slate-400 h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                    <% } %>
                  </div>
                  <div class="space-y-0.5">
                    <h4 class="text-slate-900 dark:text-white text-xs sm:text-sm font-montserrat font-semibold line-clamp-1">
                      <%= item.name %>
                    </h4>
                    <p class="text-slate-500 dark:text-slate-400 text-[0.6875rem] font-inter">
                      Qty: <strong class="text-slate-700 dark:text-slate-300"><%= item.quantity %></strong>
                    </p>
                  </div>
                </div>
                <div class="text-right">
                  <span class="text-slate-900 dark:text-white text-xs sm:text-sm font-montserrat font-bold">
                    Rs: <%= item.price.toLocaleString() %>
                  </span>
                </div>
              </div>
              <% }); %>
              <% } %>
            </div>
            <!-- Card Bottom Bar: Quick Shipping Destination snippet -->
            <div class="bg-slate-50/40 dark:bg-slate-900/40 flex items-center justify-between flex-wrap gap-x-2 border-t border-slate-100 dark:border-slate-800 py-3 px-5 sm:px-6">
              <div class="flex items-center gap-1.5">
                <svg class="text-slate-400 h-3.5 w-3.5 " fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                </svg>
                <span class="text-slate-500 dark:text-slate-400 text-[0.6875rem] font-inter font-medium">Delivery: <%= order.address?.city %>, <%= order.address.country %></span>
              </div>
              <div>
                <span class="text-slate-500 dark:text-slate-400 text-[0.6875rem] font-inter">Payment: <strong class="text-slate-700 dark:text-slate-300 uppercase"><%= order.paymentMethod %></strong></span>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
        <!-- ==================== EMPTY FILTERING STATE ==================== -->
        <div class="py-10 sm:py-12 text-center space-y-3 hidden" id="no-matches">
          <div class="bg-orange-50 dark:bg-orange-500/10 h-16 w-16 text-orange-600 text-2xl mx-auto flex items-center justify-center rounded-2xl mb-4">
            🔍
          </div>
          <h3 class="text-slate-900 dark:text-white text-base sm:text-lg font-montserrat font-bold leading-none">No Matching Order</h3>
          <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm font-inter max-w-sm mx-auto mb-4.5">
            Try clearing your search query or selecting a different order filter.
          </p>
          <button class="clearOrderFilter bg-orange-600 text-white text-sm font-montserrat font-semibold inline-flex items-center gap-x-1.5 rounded-xl cursor-pointer py-2.5 px-4 hover:bg-orange-700 transition-colors ease-out duration-200">
            Reset All Filters
          </button>
        </div>
      </div>
      <% } %>
    </section>
    <!-- ==================== ORDER DETAILS/SUMMARY MODEL ==================== -->
    <div class="bg-slate-950/60 backdrop-blur-sm fixed fixed inset-0 items-center justify-center p-4 z-50 overflow-y-auto hidden" id="orderModel">
      <div class="bg-white dark:bg-slate-900 relative w-full max-w-2xl border border-slate-200 dark:border-slate-800 rounded-3xl shadow-2xl my-8 overflow-hidden">
        <!-- Model Header -->
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 py-5 px-6">
          <div class="space-y-0.5">
            <span class="text-orange-600 dark:text-orange-400 text-xs font-montserrat font-mono font-semibold block" id="orderId"></span>
            <h3 class="text-slate-900 dark:text-white text-lg font-montserrat font-bold leading-none block">
              Order Summary
            </h3>
          </div>
          <button class="closeTrigger text-slate-400 rounded-xl cursor-pointer p-2 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-600 dark:hover:text-slate-200 hover:transition-colors hover:ease-out hover:duration-150" type="button">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <!-- Model Body Content -->
        <div class="max-h-[75vh] space-y-6 p-6 overflow-y-auto">
          <!-- Items Ordered Section -->
          <div class="space-y-2.5">
            <h4 class="text-slate-900 dark:text-white text-xs font-montserrat font-bold uppercase tracking-wider">
              Items In This Order
            </h4>
            <div class="grid grid-cols-1 gap-4" id="orderItems">
            </div>
          </div>
          <!-- 2-Columns: Shipping Address & Payment Details -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Shipping Info -->
            <div class="bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-800 rounded-2xl space-y-2 p-4">
              <div class="flex items-center gap-x-2">
                <svg class="text-orange-600 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                </svg>
                <span class="text-slate-900 dark:text-white text-xs font-montserrat font-bold">Delivery Address</span>
              </div>
              <!-- Shipping Details -->
              <div class="space-y-1.5">
                <span class="text-slate-900 dark:text-white text-sm font-montserrat font-bold truncate" id="fullName"></span>
                <p class="text-slate-500 dark:text-slate-400 text-xs font-inter font-medium" id="stateAddress"></p>
                <p class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold" id="prvinceCtyPstlCd"></p>
                <p class="text-slate-500 text-xs font-inter font-medium">Email: <span class="text-slate-600 dark:text-slate-300 font-semibold" id="emailAddress"></span></p>
                <p class="text-slate-500 text-xs font-inter font-medium">
                  📞 Contact:
                  <span class="text-slate-600 dark:text-slate-300 font-semibold" id="phoneNumber"></span>
                </p>
              </div>
            </div>
            <!-- Payment Info -->
            <div class="bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-800 rounded-2xl space-y-2 p-4">
              <div class="flex items-center gap-x-2">
                <svg class="text-orange-600 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                </svg>
                <span class="text-slate-900 dark:text-white text-xs font-montserrat font-bold">Payment Summary</span>
              </div>
              <div class="space-y-1.5 pt-1">
                <div class="flex justify-between">
                  <span class="text-slate-400 text-xs font-inter">Method:</span>
                  <span class="text-slate-800 dark:text-slate-200 text-xs font-inter font-semibold uppercase">COD</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-400 text-xs font-inter">Shipping:</span>
                  <span class="text-emerald-600 dark:text-emerald-400 text-xs font-inter font-semibold" id="shippingRs"></span>
                </div>
                <div class="flex justify-between border-t border-slate-200 dark:border-slate-700/60 pt-2">
                  <span class="text-slate-900 dark:text-white text-sm font-montserrat font-bold leading-none">Grand Total:</span>
                  <span class="text-orange-600 dark:text-orange-400 text-sm font-montserrat font-extrabold leading-none" id="grandTotal"></span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Model Footer -->
        <div class="bg-slate-50/60 dark:bg-slate-800/50 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between py-4 px-6">
          <button class="text-slate-600 dark:text-slate-400 flex items-center gap-1.5 cursor-pointer hover:text-orange-600 hover:transition-colors hover:ease-out hover:duration-150" type="button" onclick="window.print()">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            <span class="text-xs font-montserrat font-semibold">Print Invoice</span>
          </button>
          <button class="cancelTrigger bg-orange-600 text-white text-xs font-montserrat font-bold rounded-xl cursor-pointer py-2 px-5 hover:bg-orange-700 hover:transition-colors hover:ease-out hover:duration-200" type="button">
            Done
          </button>
        </div>
      </div>
    </div>
  </main>
  <!-- Footer -->
  <%- include("../partials/footer") %>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/user.js"></script>
