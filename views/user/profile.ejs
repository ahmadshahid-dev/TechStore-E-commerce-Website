<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Customer Profile & Dashboard | TechStore</title>
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased selection:bg-orange-500 selection:text-white">
  <!-- Header -->
  <%- include("../partials/header") %>
  <!-- Main -->
  <main>
    <!-- ==================== 1. TOP HEADER BANNER ==================== -->
    <section class="bg-white/60 dark:bg-slate-900/60 backdrop-blur-md overflow-hidden py-8 sm:py-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <!-- Breadcrumb & Title -->
          <div class="space-y-1.5">
            <nav class="text-slate-500 dark:text-slate-400 text-xs font-inter flex items-center gap-2">
              <a class="hover:text-orange-600 dark:hover:text-orange-400 hover:transition-colors" href="/">Home</a>
              <span class="text-slate-300 dark:text-slate-700">/</span>
              <span class="text-slate-800 dark:text-slate-200 font-semibold">Account Dashboard</span>
            </nav>
            <h1 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-extrabold leading-none tracking-tight">
              Welcome back, <span class="text-orange-600 dark:text-orange-400"><%= _user.name.split(" ")[0] %></span> 👋
            </h1>
            <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm font-inter">
              Manage your personal credentials, order histories, addresses, and purchase activity.
            </p>
          </div>
          <!-- Action Buttons (Edit + Settings) -->
          <div class="flex items-center gap-x-2.5">
            <!-- Edit Profile Button -->
            <button class="openTrigger bg-orange-600 text-white inline-flex items-center gap-2 rounded-xl shadow-lg shadow-orange-500/25 cursor-pointer py-3 px-5 hover:bg-orange-700 hover:shadow-orange-500/35 active:scale-[0.98] transition ease-out duration-[250ms]" type="button" data-model="editProfileModel">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
              </svg>
              <span class="text-xs sm:text-sm font-montserrat font-bold">Edit Profile</span>
            </button>
            <!-- Settings Button -->
            <a class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800  rounded-xl shadow-sm hover:bg-slate-100 dark:hover:bg-slate-800 hover:transition-colors p-2.75" href="/@<%= _user.username %>/privacy-security">
              <svg class="text-slate-400 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
    <!-- ==================== 2. MAIN DASHBOARD ==================== -->
    <section class="border-t border-slate-200/80 dark:border-slate-800/80 py-8 sm:py-10 lg:py-12 ">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
        <!-- ==================== 4 KPI STATS METRIC CARDS ==================== -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          <!-- Card 1: Total Orders Placed -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-5 shadow-sm flex flex-col justify-between hover:border-orange-500/40 hover:transition-colors hover:ease-in-out hover:duration-300">
            <div class="flex items-center justify-between mb-2.5">
              <span class="text-slate-400 text-xs font-inter font-semibold uppercase tracking-wider">Total Orders</span>
              <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 h-10 w-10 rounded-xl flex items-center justify-center">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
              </div>
            </div>
            <h3 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-extrabold leading-none">
              <%= totalOrders %>
            </h3>
            <!-- Status Pills -->
            <div class="flex items-center gap-1.5 mt-2.5">
              <span class="bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 text-[0.6875rem] font-inter font-semibold rounded-md py-0.5 px-2">
                <%= deliveredOrders %> Delivered
              </span>
              <span class="bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 text-[0.6875rem] font-inter font-semibold rounded-md py-0.5 px-2">
                <%= activeOrders %> Active
              </span>
              <% if (cancelledOrders) { %>
              <span class="bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 text-[0.6875rem] font-inter font-semibold rounded-md py-0.5 px-2">
                <%= cancelledOrders %> Cancelled
              </span>
              <% } %>
            </div>
          </div>
          <!-- Card 2: Shopping Cart -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-5 shadow-sm flex flex-col justify-between hover:border-orange-500/40 hover:transition-colors hover:ease-in-out hover:duration-300">
            <div class="flex items-center justify-between mb-2.5">
              <span class="text-slate-400 text-xs font-inter font-semibold uppercase tracking-wider">Shopping Cart</span>
              <div class="bg-sky-50 dark:bg-sky-950/40 text-sky-600 dark:text-sky-400 h-10 w-10 rounded-xl flex items-center justify-center">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
            </div>
            <h3 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-extrabold leading-none">
              <%= _user.items.length %> <span class="text-slate-400 text-xs font-inter font-normal leading-none">Items</span>
            </h3>
            <a class="text-sky-600 dark:text-sky-400 text-xs font-montserrat font-bold inline-flex items-center gap-1 hover:underline mt-2.5" href="/@<%= _user.username %>/cart">
              <span>View My Cart</span>
              <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
          <!-- Card 3: Saved Wishlist -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-5 shadow-sm flex flex-col justify-between hover:border-orange-500/40 hover:transition-colors hover:ease-in-out hover:duration-300">
            <div class="flex items-center justify-between mb-2.5">
              <span class="text-slate-400 text-xs font-inter font-semibold uppercase tracking-wider">Saved Wishlist</span>
              <div class="bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 h-10 w-10 rounded-xl flex items-center justify-center">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              </div>
            </div>
            <h3 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-extrabold leading-none">
              <%= _user.favourites.length %> <span class="text-xs font-inter font-normal text-slate-400">Favourites</span>
            </h3>
            <a class="inline-flex items-center gap-1 text-xs font-montserrat font-bold text-rose-600 dark:text-rose-400 hover:underline mt-2.5" href="/@<%= _user.username %>/favourites">
              <span>Explore Wishlist</span>
              <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
          <!-- Card 4: Address Book -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-5 shadow-sm flex flex-col justify-between hover:border-orange-500/40 hover:transition-colors hover:ease-in-out hover:duration-300">
            <div class="flex items-center justify-between mb-2.5">
              <span class="text-slate-400 text-xs font-inter font-semibold uppercase tracking-wider">Saved Addresses</span>
              <div class="bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 h-10 w-10 rounded-xl flex items-center justify-center">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
            </div>
            <h3 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-extrabold leading-none">
              <%= totalAddresses %> <span class="text-xs font-inter font-normal text-slate-400">Locations</span>
            </h3>
            <a class="inline-flex items-center gap-1 text-xs font-montserrat font-bold text-emerald-600 dark:text-emerald-400 hover:underline mt-2.5" href="/@<%= _user.username %>/address-book">
              <span>Manage Address Book</span>
              <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
        <!-- ==================== 2-COLUMN MAIN LAYOUT ==================== -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <!-- LEFT COLUMN Unified Profile Identity & Contact Info Card -->
          <div class="lg:col-span-4">
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-3xl shadow-sm space-y-6 p-6 lg:p-8">
              <!-- Avatar & Status -->
              <div class="flex flex-col items-center text-center space-y-3">
                <div class="relative">
                  <div class="bg-slate-100 dark:bg-slate-800 w-28 h-28 sm:w-32 sm:h-32 border-4 border-orange-100 dark:border-orange-950/60 rounded-full shadow-inner flex items-center justify-center overflow-hidden">
                    <% if (_user.profileImg) { %>
                    <img class="h-full w-full object-cover" src="/uploads/<%= _user.profileImg %>" alt="<%= _user.name %>" />
                    <% } else { %>
                    <span class="text-orange-600 dark:text-orange-400 text-4xl font-montserrat font-black">
                      <%= _user.name ? _user.name.charAt(0).toUpperCase() : 'U' %>
                    </span>
                    <% } %>
                  </div>
                  <!-- Active Status Pill -->
                  <div class="bg-emerald-500 h-4 w-4 absolute bottom-1 right-1 border-2 border-white dark:border-slate-900 rounded-full" title="Online / Active"></div>
                </div>
                <!-- Name & Username -->
                <div class="space-y-0.5">
                  <h2 class="text-slate-900 dark:text-white text-xl font-montserrat font-bold">
                    <%= _user.name %>
                  </h2>
                  <p class="text-slate-500 dark:text-slate-400 text-xs font-inter font-mono">
                    @<%= _user.username %>
                  </p>
                </div>
                <!-- Verification Status Badge -->
                <div class="inline-flex items-center gap-1.5 rounded-full py-1 px-3 <%= _user.verificationStatus === 'Verified' ? 'bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/60' : 'bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-900/60' %>">
                  <% if (_user.verificationStatus === 'Verified') { %>
                  <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-xs font-inter font-semibold">Verified Account</span>
                  <% } else { %>
                  <span class="text-xs font-inter font-semibold">Unverified Account</span>
                  <% } %>
                </div>
              </div>
              <!-- Quick Info / Contact -->
              <div class="border-t border-slate-100 dark:border-slate-800/80 space-y-3 pt-6">
                <div class="flex items-center gap-x-3">
                  <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400  h-8 w-8 flex items-center justify-center shrink-0 rounded-lg">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div class="flex flex-col gap-y-0.5">
                    <p class="text-slate-400 text-[0.6250rem] font-inter uppercase font-semibold">Email</p>
                    <p class="text-slate-600 dark:text-slate-300 text-xs font-inter font-medium truncate"><%= _user.email %></p>
                  </div>
                </div>
                <div class="flex items-center gap-x-3">
                  <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400  h-8 w-8 flex items-center justify-center shrink-0 rounded-lg">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                  </div>
                  <div class="flex flex-col gap-y-0.5">
                    <p class="text-slate-400 text-[0.6250rem] font-inter uppercase font-semibold">Phone</p>
                    <p class="text-slate-600 dark:text-slate-300 text-xs font-inter font-medium truncate"><%= _user.phone || 'Not provided' %></p>
                  </div>
                </div>
              </div>
              <!-- Navigation Links -->
              <div class="pt-4 border-t border-slate-100 dark:border-slate-800/80 space-y-2.5">
                <a class="bg-slate-50 dark:bg-slate-800/50 text-slate-700 dark:text-slate-300
                 w-full flex items-center justify-between rounded-xl py-2 px-4 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950/30 dark:hover:text-red-400" href="/@<%= _user.username %>/address-book">
                  <div class="flex items-center gap-x-2.5">
                    <svg class="text-red-500 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span class="text-xs font-montserrat font-semibold leading-none">My Addresses</span>
                  </div>
                  <span class="text-slate-400">→</span>
                </a>
                <a class="bg-slate-50 dark:bg-slate-800/50 text-slate-700 dark:text-slate-300
                 w-full flex items-center justify-between rounded-xl py-2 px-4 hover:bg-orange-50 hover:text-orange-600 dark:hover:bg-orange-950/30 dark:hover:text-orange-400" href="/@<%= _user.username %>/my-orders">
                  <div class="flex items-center gap-x-2.5">
                    <svg class="text-orange-500 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                    <span class="text-xs font-montserrat font-semibold leading-none">My Orders</span>
                  </div>
                  <span class="text-slate-400">→</span>
                </a>
                <a class="bg-slate-50 dark:bg-slate-800/50 text-slate-700 dark:text-slate-300
                 w-full flex items-center justify-between rounded-xl py-2 px-4 hover:bg-amber-50 hover:text-amber-600 dark:hover:bg-amber-950/30 dark:hover:text-amber-400" href="/@<%= _user.username %>/order-tracking">
                  <div class="flex items-center gap-x-2.5">
                    <svg class="text-amber-500 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22V12" />
                      <path d="M20.27 18.27 22 20" />
                      <path d="M21 10.498V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.729l7 4a2 2 0 0 0 2 .001l.98-.559" />
                      <path d="M3.29 7 12 12l8.71-5" />
                      <path d="m7.5 4.27 8.997 5.148" />
                      <circle cx="18.5" cy="16.5" r="2.5" />
                    </svg>
                    <span class="text-xs font-montserrat font-semibold leading-none">Order Track</span>
                  </div>
                  <span class="text-slate-400">→</span>
                </a>
                <a class="bg-slate-50 dark:bg-slate-800/50 text-slate-700 dark:text-slate-300
                 w-full flex items-center justify-between rounded-xl py-2 px-4 hover:bg-purple-50 hover:text-purple-600 dark:hover:bg-purple-950/30 dark:hover:text-purple-400" href="/@<%= _user.username %>/privacy-security">
                  <div class="flex items-center gap-x-2.5">
                    <svg class="text-purple-500 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span class="text-xs font-montserrat font-semibold leading-none">Privacy & Security</span>
                  </div>
                  <span class="text-slate-400">→</span>
                </a>
                <button class="logout bg-rose-50 dark:bg-rose-950/30 text-rose-600 dark:text-rose-400 
                w-full flex items-center justify-center gap-2 rounded-xl cursor-pointer py-2.5 px-4 hover:bg-rose-100 dark:hover:bg-rose-900/50 border border-rose-200/80 dark:border-rose-900/40">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                  </svg>
                  <span class="text-xs font-montserrat font-bold">Log Out</span>
                </button>
              </div>
              <!-- Member Since Date -->
              <div class="text-xs font-inter border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between pt-6">
                <span class="text-slate-500 dark:text-slate-400">Member Since:</span>
                <span class="text-slate-800 dark:text-slate-200 font-montserrat font-semibold">
                  <%= _user.createdAt ? new Date(_user.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short' }) : '2026' %>
                </span>
              </div>
            </div>
          </div>
          <!-- RIGHT COLUMN Default Delivery Address & Recent Orders -->
          <div class="lg:col-span-8 space-y-6">
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-3xl shadow-sm sm:p-8 space-y-6 p-6">
              <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
                <h3 class="text-slate-900 dark:text-white text-base sm:text-lg font-montserrat font-bold leading-none">
                  Personal Information
                </h3>
                <button class="openTrigger text-orange-600 dark:text-orange-400 flex items-center gap-x-0.5 cursor-pointer hover:text-orange-700 hover:underline" type="button" data-model="editProfileModel">
                  <span class="text-xs font-montserrat font-semibold">Edit</span>
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </button>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="space-y-1">
                  <span class="text-slate-400 text-xs font-inter font-semibold uppercase tracking-wider block">First Name</span>
                  <p class="text-slate-800 dark:text-slate-200 text-sm font-inter font-medium"><%= _user.firstName || 'Not provided' %></p>
                </div>
                <div class="space-y-1">
                  <span class="text-slate-400 text-xs font-inter font-semibold uppercase tracking-wider block">Last Name</span>
                  <p class="text-slate-800 dark:text-slate-200 text-sm font-inter font-medium"><%= _user.lastName || 'Not provided' %></p>
                </div>
                <div class="space-y-1">
                  <span class="text-slate-400 text-xs font-inter font-semibold uppercase tracking-wider block">Date of Birth</span>
                  <p class="text-slate-800 dark:text-slate-200 text-sm font-inter font-medium">
                    <%= _user.dateOfBirth ? new Date(_user.dateOfBirth).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'Not provided' %>
                  </p>
                </div>
                <div class="space-y-1">
                  <span class="text-slate-400 text-xs font-inter font-semibold uppercase tracking-wider block">Gender</span>
                  <p class="text-slate-800 dark:text-slate-200 text-sm font-inter font-medium capitalize"><%= _user.gender || 'Not specified' %></p>
                </div>
              </div>
            </div>
            <!-- Default Delivery Address Spotlight Card -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-3xl shadow-sm space-y-4 p-6 sm:p-7">
              <div class="flex flex-col sm:flex-row items-start sm:items-center sm:justify-between gap-y-1.5 border-b border-slate-100 dark:border-slate-800 pb-4">
                <div class="flex items-start sm:items-center gap-x-3">
                  <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 h-9 w-9 flex items-center justify-center shrink-0 rounded-xl">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    </svg>
                  </div>
                  <div class="space-y-0.75">
                    <h3 class="text-slate-900 dark:text-white text-base font-montserrat font-bold leading-none">
                      Primary Shipping Address
                    </h3>
                    <p class="text-slate-400 text-xs font-inter">Default address used for 1-click checkout.</p>
                  </div>
                </div>
                <a class="text-orange-600 dark:text-orange-400 flex items-center gap-x-0.5 hover:text-orange-700" href="/@<%= _user.username %>/address-book">
                  <span class="text-xs font-montserrat font-bold">Manage</span>
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
              <% if (primaryAddress) { %>
              <div class="bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-2xl p-4">
                <div class="flex flex-col gap-y-1.25">
                  <div class="flex items-center gap-x-2.5">
                    <span class="text-slate-900 dark:text-white text-sm font-montserrat font-bold leading-none truncate">
                      <%= primaryAddress.fullName %>
                    </span>
                    <span class="bg-lime-50 dark:bg-lime-500/10 text-lime-600 dark:text-lime-400 text-[0.6250rem] font-inter font-semibold truncate border border-lime-200/50 rounded-md py-0.5 px-2">
                      <%= primaryAddress.label %>
                    </span>
                  </div>
                  <p class="text-slate-600 dark:text-slate-300 text-xs font-inter">
                    <%= primaryAddress.stateAddress %>
                  </p>
                  <p class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold">
                    <%= primaryAddress.city %>, <%= primaryAddress.province %> - <span class="text-orange-600 dark:text-orange-400"><%= primaryAddress.postalCode %></span>
                  </p>
                  <p class="text-slate-500 text-xs font-inter font-medium">
                    Phone: <span class="font-semibold"><%= primaryAddress.phone %></span>
                  </p>
                </div>
                <a class="bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold border border-slate-200 dark:border-slate-700 self-start sm:self-auto rounded-xl shadow-sm shrink-0 py-2 px-3.5 hover:text-orange-600 hover:transition-colors" href="/@<%= _user.username %>/address-book">
                  Change Address
                </a>
              </div>
              <% } else { %>
              <div class="border border-dashed border-slate-200 dark:border-slate-800 rounded-2xl text-center p-6">
                <p class="text-slate-500 dark:text-slate-400 text-xs font-inter mb-3.5">No default address registered yet.</p>
                <a class="bg-orange-600 text-white inline-flex items-center gap-x-1.5 rounded-xl shadow-md shadow-orange-500/20 py-2.5 px-4 hover:bg-orange-700 hover:transition-colors hover:ease-out hover:duration-[250ms]" href="/@<%= _user.username %>/address-add">
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                  <span class="text-xs font-montserrat font-semibold">Add First Address</span>
                </a>
              </div>
              <% } %>
            </div>
            <!-- Recent Orders Snippet -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-3xl shadow-sm space-y-4 p-6 sm:p-7">
              <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
                <div class="space-y-1">
                  <h3 class="text-slate-900 dark:text-white text-base sm:text-lg font-montserrat font-bold leading-none">
                    Recent Orders
                  </h3>
                  <p class="text-slate-400 text-xs font-inter">Live updates on your recent purchases.</p>
                </div>
                <a class="text-orange-600 dark:text-orange-400 text-xs font-montserrat font-bold truncate flex items-center gap-x-0.5 hover:text-orange-700" href="/@<%= _user.username %>/orders">
                  <span>View All</span>
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
              <% if (recentOrders && recentOrders.length > 0) { %>
              <div class="divide-y divide-slate-100 dark:divide-slate-800/80">
                <% recentOrders.forEach(order => { %>
                <div class="flex items-center justify-between py-3.5 first:pt-0 last:pb-0">
                  <div class="space-y-0.5">
                    <div class="flex items-center gap-x-2.5">
                      <span class="text-slate-900 dark:text-white text-sm font-montserrat font-mono font-bold leading-none">
                        #<%= order.orderId %>
                      </span>
                      <span class="text-slate-400 text-[0.6875rem] font-inter">
                        • <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                      </span>
                    </div>
                    <p class="text-slate-600 dark:text-slate-400 text-[0.6875rem] font-inter font-medium flex items-center gap-x-1.25 sm:gap-x-2.5">
                      <%= order.items.length %> <%= order.items.length > 1 ? 'Items' : 'Item' %> <span>• Grand Total: <strong class="text-orange-600 dark:text-orange-400 text-xs">Rs: <%= order.grandTotal.toLocaleString() %></strong></span>
                    </p>
                  </div>
                  <span class="text-[0.6875rem] font-montserrat font-bold <%= order.orderStatus === 'Delivered' ? 'bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400' : (order.orderStatus === 'Cancelled' ? 'bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400' : 'bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400') %> rounded-full py-1 px-2.5">
                    <%= order.orderStatus %>
                  </span>
                </div>
                <% }); %>
              </div>
              <% } else { %>
              <div class="text-center space-y-0.5 pt-5 pb-2.5">
                <p class="text-slate-400 text-xs font-inter">No recent orders found.</p>
                <a class="text-orange-600 text-xs font-montserrat font-bold inline-block hover:underline" href="/shop">Explore tech gear</a>
              </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- ==================== 4. EDIT PROFILE MODAL DIALOG ==================== -->
    <div class="bg-slate-950/60 backdrop-blur-sm hidden items-center justify-center overflow-y-auto fixed inset-0 z-50 p-4" id="editProfileModel">
      <div class="bg-white dark:bg-slate-900 relative w-full max-w-2xl border border-slate-200 dark:border-slate-800 rounded-3xl shadow-2xl my-8 overflow-hidden transition-transform ease-in-out duration-300">
        <!-- Modal Header -->
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 py-5 px-6">
          <div class="space-y-0.5">
            <h3 class="text-slate-900 dark:text-white text-lg font-montserrat font-bold">
              Edit Your Profile Details
            </h3>
            <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">
              Update your account details and profile photo.
            </p>
          </div>
          <button class="closeTrigger text-slate-400 rounded-xl cursor-pointer p-2 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-600 dark:hover:text-slate-200 hover:transition-colors" type="button">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <!-- Edit Form -->
        <form class="space-y-6 p-6" id="profileEditForm" enctype="multipart/form-data">
          <!-- Avatar Upload & Live Preview -->
          <div class="flex flex-col sm:flex-row items-center gap-5 border-b border-slate-100 dark:border-slate-800 pb-6">
            <div class="relative">
              <div class="bg-slate-100 dark:bg-slate-800 h-20 w-20 flex items-center justify-center border-2 border-orange-500 rounded-full shadow-inner overflow-hidden">
                <% if (_user.profileImg) { %>
                <img class="w-full h-full object-cover" id="profilePreview" src="<%= _user.profileImg %>" alt="<%= _user.name %>" />
                <% } else { %>
                <img class="w-full h-full object-cover hidden" id="profilePreview" src="" alt="Avatar Preview" />
                <span class="text-orange-600 dark:text-orange-400 text-2xl font-montserrat font-black" id="profilePreviewEmpty">
                  <%= _user.name ? _user.name.charAt(0).toUpperCase() : 'U' %>
                </span>
                <% } %>
              </div>
            </div>
            <div class="text-center sm:text-left flex-1 space-y-0.75">
              <label class="text-slate-600 dark:text-slate-300 text-[0.6875rem] font-inter font-bold uppercase tracking-wider block" for="profileImg">
                Profile Photo Avatar
              </label>
              <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">
                JPG, PNG or WEBP (Max 2MB).
              </p>
              <div class="pt-2 space-y-1.5">
                <label class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 inline-flex items-center gap-2 border border-slate-200 dark:border-slate-700 rounded-xl py-1.5 px-3 hover:bg-orange-50 dark:hover:bg-orange-950/40 hover:text-orange-600 dark:hover:text-orange-400 cursor-pointer hover:transition-colors hover:ease-out hover:duration-[250ms]" for="profileImg">
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span class="text-xs font-montserrat font-semibold">Choose Photo</span>
                </label>
                <input class="hidden" id="profileImg" type="file" name="profileImg" accept="image/*" />
                <p class="error text-rose-500 text-xs font-inter" id="error-profileImg"></p>
              </div>
            </div>
          </div>
          <!-- Form Fields Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- First Name -->
            <div class="space-y-1.25">
              <label class="text-slate-600 dark:text-slate-300 text-[0.6875rem] font-inter font-bold uppercase tracking-wider block" for="firstName">
                First Name <span class="text-rose-500">*</span>
              </label>
              <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-xs font-inter border border-slate-300 dark:border-slate-700 rounded-xl py-2.5 px-3.5 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400" id="firstName" type="text" name="firstName" value="<%= _user.firstName || '' %>" autocomplete="given-name" placeholder="Doe" required />
              <p class="error text-rose-500 text-xs font-inter" id="error-firstName"></p>
            </div>
            <!-- Last Name -->
            <div class="space-y-1.25">
              <label class="text-slate-600 dark:text-slate-300 text-[0.6875rem] font-inter font-bold uppercase tracking-wider block" for="lastName">
                Last Name <span class="text-rose-500">*</span>
              </label>
              <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-xs font-inter border border-slate-300 dark:border-slate-700 rounded-xl py-2.5 px-3.5 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400" id="lastName" type="text" name="lastName" value="<%= _user.lastName || '' %>" autocomplete="family-name" placeholder="John" required />
              <p class="error text-rose-500 text-xs font-inter" id="error-lastName"></p>
            </div>
            <!-- Date of Birth -->
            <div class="space-y-1.25">
              <label class="text-slate-600 dark:text-slate-300 text-[0.6875rem] font-inter font-bold uppercase tracking-wider block" for="dateOfBirth">
                Date of Birth
              </label>
              <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-xs font-inter border border-slate-300 dark:border-slate-700 rounded-xl py-2.5 px-3.5 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none" id="dateOfBirth" type="date" name="dateOfBirth" value="<%= _user.dateOfBirth ? new Date(_user.dateOfBirth).toISOString().split('T')[0] : '' %>" required />
              <p class="error text-rose-500 text-xs font-inter" id="error-dateOfBirth"></p>
            </div>
            <!-- Gender Selection -->
            <div class="space-y-1.25">
              <span class="text-slate-600 dark:text-slate-300 text-[0.6875rem] font-inter font-bold uppercase tracking-wider block">
                Gender
              </span>
              <div class="flex items-center gap-6 pt-2">
                <label class="inline-flex items-center gap-2">
                  <input class="text-orange-600 h-4 w-4 border-slate-300 dark:border-slate-700 focus:ring-orange-500" id="gender-male" type="radio" name="gender" value="Male" <%= _user.gender === "Male" ? 'checked' : '' %> required />
                  <span class="text-slate-700 dark:text-slate-300 text-sm font-inter cursor-pointer">Male</span>
                </label>
                <label class="inline-flex items-center gap-2">
                  <input class="text-orange-600 h-4 w-4 border-slate-300 dark:border-slate-700 focus:ring-orange-500" id="gender-female" type="radio" name="gender" value="Female" <%= _user.gender === "Female" ? 'checked' : '' %> required />
                  <span class="text-slate-700 dark:text-slate-300 text-sm font-inter cursor-pointer">Female</span>
                </label>
              </div>
              <p class="error text-rose-500 text-xs font-inter" id="error-gender"></p>
            </div>
            <!-- Username -->
            <div class="space-y-1.25">
              <label class="text-slate-600 dark:text-slate-300 text-[0.6875rem] font-inter font-bold uppercase tracking-wider block" for="username">
                Username
              </label>
              <div class="relative">
                <span class="text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 text-xs font-inter font-semibold pointer-events-none">@</span>
                <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-xs font-inter border border-slate-300 dark:border-slate-700 rounded-xl pl-8 pr-4 py-2.5 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400" type="text" id="username" name="username" value="<%= _user.username || '' %>" placeholder="doe_john" autocomplete="username" required />
              </div>
            </div>
            <!-- Phone Number -->
            <div class="space-y-1.25">
              <label class="text-slate-600 dark:text-slate-300 text-[0.6875rem] font-inter font-bold uppercase tracking-wider block" for="phone">
                Phone Number
              </label>
              <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-xs font-inter border border-slate-300 dark:border-slate-700 rounded-xl py-2.5 px-3.5 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400" id="phone" type="tel" name="phone" value="<%= _user.phone || '' %>" placeholder="+92 300 1234567" autocomplete="tel" />
              <p class="error text-rose-500 text-xs font-inter" id="error-phone"></p>
            </div>
          </div>
          <!-- Modal Actions Footer -->
          <div class="flex items-center justify-end gap-x-3 border-t border-slate-100 dark:border-slate-800 pt-5">
            <button class="cancelTrigger text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold border border-slate-200 dark:border-slate-700 rounded-xl cursor-pointer py-2.5 px-5 hover:bg-slate-100 dark:hover:bg-slate-800 hover:transition-colors hover:ease-out hover:duration-[250ms]" type="button">
              Cancel
            </button>
            <button class="bg-orange-600 text-white flex items-center justify-center gap-x-1.5 rounded-xl shadow-md shadow-orange-500/25 cursor-pointer py-2.5 px-6 hover:bg-orange-700 active:scale-[0.98] transition-colors ease-out duration-[250ms]" type="submit">
              <span class="Spinner h-3.5 w-3.5 border-[3px] border-orange-100 border-t-orange-500 shrink-0 rounded-full animate-spin drop-shadow-[0_0_4px_rgba(249,115,22,0.6)] hidden"></span>
              <span class="Text text-xs font-montserrat font-bold">Save Changes</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
  <!-- Footer -->
  <%- include("../partials/footer") %>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/user.js"></script>
</body>

</html>