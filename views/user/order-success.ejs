<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Order Confirmation - TechStore. Thank you for your purchase!" />
  <title>Order Confirmed | TechStore</title>
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white antialiased selection:bg-orange-500 selection:text-white">
  <!-- Header -->
  <%- include("../partials/header") %>
  <!-- Main -->
  <main>
    <!-- ==================== Page Top Banner ==================== -->
    <section class="relative text-center pt-12 pb-8 sm:pt-12 sm:pb-8 lg:pt-16 lg:pb-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Decorative Glow Background Effects -->
        <div class="bg-emerald-500/10 dark:bg-emerald-500/15 h-96 w-96 absolute -top-24 left-1/2 -translate-x-1/2 rounded-full blur-3xl pointer-events-none"></div>
        <div class="max-w-3xl mx-auto relative z-10">
          <div class="flex flex-col space-y-5.5 items-center justify-center">
            <!-- Glowing Success Badge Icon -->
            <div class="inline-flex items-center justify-center relative mb-8">
              <div class="bg-emerald-500/20 dark:bg-emerald-500/30 absolute inset-0 rounded-full blur-xl animate-pulse"></div>
              <div class="bg-gradient-to-tr from-emerald-600 to-teal-500 text-white relative h-20 w-20 sm:h-24 sm:w-24 flex items-center justify-center rounded-full shadow-xl shadow-emerald-500/25 ring-10 ring-emerald-500/10 dark:ring-emerald-500/20">
                <svg class="h-10 w-10 sm:h-12 sm:w-12 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>
            <!-- Header Status Pill -->
            <span class="bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 w-fit inline-flex items-center gap-x-2.5 border border-emerald-300 dark:border-emerald-800/80 rounded-full py-2.5 px-5">
              <span class="bg-emerald-500 h-1.5 w-1.5 rounded-full animate-ping"></span>
              <span class="text-xs sm:text-sm font-montserrat font-semibold leading-none">Order Placed Successfully</span>
            </span>
            <!-- Heading -->
            <h1 class="text-slate-900 dark:text-white text-3xl sm:text-4xl md:text-5xl font-montserrat font-extrabold tracking-tight mb-4">
              <span class="text-orange-600 dark:text-orange-400">Thank You!</span>
              Your Order is
              <span class="text-orange-600 dark:text-orange-400">Placed</span>
            </h1>
            <!-- Clean English Description (No Email, No Extra Chips) -->
            <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base font-inter leading-relaxed max-w-2xl mx-auto">
              Thank you for shopping with TechStore! Your order has been placed successfully and is currently being prepared for dispatch. Below you will find your complete order summary and delivery details.
            </p>
            <button class="bg-orange-600 text-white w-fit flex items-center justify-center gap-x-2.5 rounded-xl cursor-pointer shadow-lg shadow-orange-600/25 py-4 px-8 mt-1 hover:bg-orange-700 transition ease-out duration-[250ms]" onclick="document.getElementById('order-overview').scrollIntoView()">
              <span class="text-sm font-montserrat font-semibold">View Order Details</span>
              <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14" />
                <path d="m19 12-7 7-7-7" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </section>
    <!-- ==================== Order Overview & Summary ==================== -->
    <section class="border-t border-gray-200 dark:border-gray-800 py-8 sm:py-10 lg:py-12" id="order-overview">
      <!-- Container -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start">
          <!-- LEFT COLUMN (Order Overview & Purchased Items) - 8 Cols -->
          <div class="lg:col-span-8 space-y-6 sm:space-y-8">
            <!-- Order Meta Grid & Address Card -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-sm p-6 sm:p-8">
              <h2 class="text-slate-900 dark:text-white text-base sm:text-lg font-montserrat font-bold flex items-center gap-2.5 mb-6">
                <div class="bg-orange-100 dark:bg-orange-950/60 text-orange-600 dark:text-orange-400 rounded-xl p-2">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                </div>
                Order Summary Overview
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                <!-- Order Id -->
                <div class="bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 rounded-2xl space-y-1 p-4">
                  <span class="text-slate-500 dark:text-slate-400 font-inter text-xs font-semibold uppercase tracking-wider block">Order ID</span>
                  <p class="text-orange-600 dark:text-orange-400 text-base font-mono font-bold"><%= order.orderId %></p>
                </div>
                <!-- Order Email -->
                <div class="bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 rounded-2xl space-y-1 p-4">
                  <span class="text-slate-500 dark:text-slate-400 font-inter text-xs font-semibold uppercase tracking-wider block">Order ID</span>
                  <p class="text-slate-900 dark:text-white text-sm font-montserrat font-semibold truncate"><%= order.orderEmail %></p>
                </div>
                <!-- Order Payment Method -->
                <div class="bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 rounded-2xl space-y-1 p-4">
                  <span class="text-slate-500 dark:text-slate-400 text-xs font-inter font-semibold uppercase tracking-wider block">Payment Method</span>
                  <p class="text-slate-900 dark:text-white text-sm font-montserrat font-semibold flex items-center gap-2">
                    <span class="bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400 text-xs font-inter font-bold rounded py-0.5 px-2">COD</span>
                    Cash on Delivery
                  </p>
                </div>
                <!-- Shipping Method -->
                <div class="bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 rounded-2xl space-y-1 p-4">
                  <span class="text-slate-500 dark:text-slate-400 text-xs font-inter font-semibold uppercase tracking-wider block">Est. Delivery</span>
                  <p class="text-slate-900 dark:text-white text-sm font-montserrat font-semibold "><%= order.shippingMethod === "Express" ? '24 - 48 Hours Express Courier' : 'Delivered within 3 - 5 Business Days' %></p>
                </div>
              </div>
              <!-- Shipping Address Box -->
              <div class="bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 mt-6">
                <div class="flex items-center justify-between mb-2.5">
                  <h3 class="text-slate-900 dark:text-white text-sm font-montserrat font-bold flex items-center gap-2">
                    <svg class="text-orange-600 dark:text-orange-400 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    Delivery Address
                  </h3>
                  <span class="bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 text-xs font-montserrat font-semibold border border-emerald-200 dark:border-emerald-800 rounded-full py-1 px-2.5">Verified</span>
                </div>
                <div class="flex flex-col gap-y-1.5">
                  <span class="text-slate-900 dark:text-white text-sm font-montserrat font-bold truncate">
                    <%= order.address.fullName %>
                  </span>
                  <p class="text-slate-500 dark:text-slate-400 text-xs font-inter font-medium"><%= order.address.stateAddress %></p>
                  <p class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold">
                    <%= order.address.city %> <%= order.address.province %> <%= order.address.country %> -
                    <span class="text-orange-600 dark:text-orange-400 font-bold"><%= order.address.postalCode %></span>
                  </p>
                  <p class="text-slate-500 text-xs font-inter font-medium">
                    📞 Contact:
                    <span class="text-slate-600 dark:text-slate-300 font-semibold"><%= order.address.phone %></span>
                  </p>
                </div>
              </div>
            </div>
            <!-- View-Only Purchased Products List Card -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-sm p-6 sm:lg:p-8">
              <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4 mb-6">
                <h2 class="text-slate-900 dark:text-white text-base sm:text-lg font-montserrat font-bold flex items-center gap-x-2.5">
                  <div class="bg-orange-100 dark:bg-orange-950/60 text-orange-600 dark:text-orange-400 rounded-xl p-2">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                  </div>
                  Order Items (<%= order.items.length %>)
                </h2>
                <span class="bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 text-xs font-montserrat font-semibold rounded-full py-1 px-2.5">View Only</span>
              </div>
              <!-- Product Items List Loop / Fallback Items -->
              <div class="divide-y divide-slate-100 dark:divide-slate-800">
                <% order.items.forEach((item) => { %>
                <div class="flex items-center gap-4 sm:gap-6 py-4 sm:py-5 first:pt-0 last:pb-0">
                  <!-- Image -->
                  <div class="h-20 w-20 flex-shrink-0 border border-slate-200 dark:border-slate-700/60 rounded-2xl overflow-hidden">
                    <img class="w-full h-full object-contain object-center" src="<%= item.image %>" alt="<%= item.name %>" />
                  </div>
                  <!-- Details -->
                  <div class="flex-grow min-w-0 sm:space-y-1">
                    <h3 class="text-slate-900 dark:text-white text-sm sm:text-base font-montserrat font-semibold tracking-tight line-clamp-2 sm:line-clamp-1 sm:leading-none">
                      <%= item.name %>
                    </h3>
                    <div class="flex items-center justify-between">
                      <div class="flex flex-col gap-y-0.5">
                        <p class="text-slate-500 dark:text-slate-400 text-xs font-inter mb-0.5">
                          <span class="hidden sm:inline-block">Unit Price</span> Rs: <%= (item.price / item.quantity).toLocaleString() %>
                        </p>
                        <span class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 w-fit text-xs font-inter font-semibold inline-flex items-center gap-1.5 rounded-lg py-1 px-2.5">
                          Qty: <%= item.quantity %>
                        </span>
                      </div>
                      <div class="flex flex-col gap-y-1.25">
                        <span class="text-slate-900 dark:text-white text-sm sm:text-base font-inter font-bold leading-none text-end">
                          Rs: <%= item.price.toLocaleString() %>
                        </span>
                        <span class="text-emerald-600 dark:text-emerald-400 text-xs font-inter font-medium">Order Placed</span>
                      </div>
                    </div>
                  </div>
                </div>
                <% }); %>
              </div>
            </div>
          </div>
          <!-- RIGHT COLUMN (Sticky Order Summary Sidebar & Action CTAs) - 4 Cols -->
          <div class="lg:col-span-4 space-y-6 sm:space-y-8 sticky top-24">
            <!-- Pricing Receipt Summary -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-sm p-6 sm:p-8">
              <h2 class="text-slate-900 dark:text-white text-lg font-montserrat font-bold border-b border-slate-100 dark:border-slate-800 flex items-center justify-between pb-4 mb-6">
                <span>Payment Breakdown</span>
                <span class="bg-orange-50 dark:bg-orange-950/60 text-orange-600 dark:text-orange-400 text-xs font-montserrat font-semibold rounded-full py-1 px-2.5">Receipt</span>
              </h2>
              <%
              const subTotal = order.items.reduce((sum, item) => sum + item.price, 0);
              const shipping = order.shippingMethod === "Express" ? 500 : 200; 
              %>
              <div class="space-y-3.5 mb-6">
                <div class="flex items-center justify-between">
                  <span class="text-slate-600 dark:text-slate-400 text-sm font-inter">Items Subtotal</span>
                  <span class="text-slate-900 dark:text-white text-sm font-inter font-semibold">
                    Rs. <%= subTotal.toLocaleString() %>
                  </span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-slate-600 dark:text-slate-400 text-sm font-inter">Shipping & Handling</span>
                  <span class="text-emerald-600 dark:text-emerald-400 text-sm font-inter font-semibold">
                    Rs: <%= shipping.toLocaleString() %>
                  </span>
                </div>
                <div class="border-t border-slate-100 dark:border-slate-800 flex justify-between items-center pt-5">
                  <span class="text-slate-900 dark:text-white text-base font-montserrat font-bold leading-none">Grand Total</span>
                  <div class="flex flex-col text-right gap-y-1.5">
                    <span class="text-orange-600 dark:text-orange-400 text-2xl font-montserrat font-black leading-none">
                      Rs. <%= order.grandTotal.toLocaleString() %>
                    </span>
                    <span class="text-slate-400 text-xs font-inter">Includes all applicable taxes</span>
                  </div>
                </div>
              </div>
              <!-- Action CTAs -->
              <div class="space-y-3.5">
                <!-- Track Order CTA -->
                <a class="bg-orange-600 text-white w-full flex items-center justify-center gap-x-2 rounded-2xl shadow-lg shadow-orange-600/25 group py-3.5 px-8 hover:bg-orange-700 transition ease-out duration-[250ms]" href="/@<%= user.username %>/order-tracking">
                  <svg class="h-5 w-5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                  <span class="text-sm font-montserrat font-semibold">Track Order Status</span>
                </a>
                <!-- Continue Shopping CTA -->
                <a class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white w-full flex items-center justify-center gap-x-2 rounded-2xl py-3.5 px-8 hover:bg-slate-200 dark:hover:bg-slate-700" href="/shop">
                  <svg class="text-slate-500 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                  </svg>
                  <span class="text-sm font-montserrat font-semibold">Continue Shopping</span>
                </a>
              </div>
            </div>
            <!-- Customer Support Contact Card -->
            <div class="bg-gradient-to-br from-slate-900 to-slate-950 text-white border border-slate-800 rounded-3xl shadow-md p-6">
              <div class="flex items-center gap-3 mb-3">
                <div class="bg-orange-600/20 text-orange-400 h-10 w-10 flex items-center justify-center rounded-xl">
                  🎧
                </div>
                <div class="space-y-0.5">
                  <h3 class="text-sm font-montserrat font-bold">Need Order Help?</h3>
                  <p class="text-slate-400 text-xs font-inter">24/7 WhatsApp Support Available</p>
                </div>
              </div>
              <p class="text-slate-300 text-xs font-inter leading-relaxed mb-4">
                If you have any questions regarding order timing, address changes, or order tracking, please contact our WhatsApp support team.
              </p>
              <a class="bg-emerald-600 text-white w-full flex items-center justify-center gap-x-2 py-3 px-6 rounded-2xl transition-colors" href="https://wa.me/923001234567" target="_blank" rel="noopener noreferrer">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.031 2c-5.514 0-9.997 4.483-9.997 9.997 0 1.763.459 3.481 1.332 5.003l-1.366 4.997 5.115-1.341c1.472.802 3.136 1.226 4.916 1.226 5.514 0 9.997-4.483 9.997-9.997 0-5.514-4.483-9.997-9.997-9.997zm5.882 14.143c-.244.686-1.427 1.348-1.968 1.408-.501.056-1.155.084-3.693-.956-3.249-1.332-5.328-4.639-5.49-4.854-.16-.215-1.309-1.745-1.309-3.329 0-1.584.831-2.362 1.127-2.682.296-.32.645-.4.86-.4.215 0 .43.003.618.012.2.009.467-.075.727.55.269.645.914 2.23.993 2.391.08.161.134.35.027.564-.108.215-.162.348-.323.537-.161.188-.337.42-.482.564-.16.16-.328.334-.141.654.187.32.83 1.368 1.782 2.217 1.224 1.092 2.257 1.431 2.577 1.592.32.161.51.134.698-.08.188-.215.807-.94 1.022-1.262.215-.323.43-.269.726-.161.296.108 1.88.887 2.203 1.048.323.161.537.242.618.376.08.134.08.779-.164 1.465z" />
                </svg>
                <span class="text-xs font-montserrat font-semibold">Chat on WhatsApp (+92 300 1234567)</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- ==================== 4. TRUST & GUARANTEE BADGES ==================== -->
    <section class="border-t border-gray-200 dark:border-gray-800 py-8 sm:py-10 lg:py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-slate-900 dark:text-white text-2xl font-montserrat font-bold leading-none text-center mb-8">
          Why <span class="text-orange-600 dark:text-orange-400">Shop</span> With Us?
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center gap-4 rounded-3xl p-6">
            <div class="bg-orange-100 dark:bg-orange-950/60 text-orange-600 dark:text-orange-400 flex-shrink-0 rounded-2xl p-3">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div class="space-y-0.5">
              <h4 class="text-slate-900 dark:text-white text-sm font-montserrat font-bold">100% Genuine Guarantee</h4>
              <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">All products backed by official brand warranty</p>
            </div>
          </div>
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center gap-4 rounded-3xl p-6">
            <div class="bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex-shrink-0 rounded-2xl p-3">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
            </div>
            <div class="space-y-0.5">
              <h4 class="text-slate-900 dark:text-white text-sm font-montserrat font-bold">7-Day Easy Replacement</h4>
              <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">Hassle-free return policy if damaged</p>
            </div>
          </div>
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center gap-4 rounded-3xl p-6">
            <div class="bg-blue-100 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex-shrink-0 rounded-2xl p-3">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div class="space-y-0.5">
              <h4 class="text-slate-900 dark:text-white text-sm font-montserrat font-bold">Cash on Delivery</h4>
              <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">Pay cash directly when parcel arrives</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <!-- Footer -->
  <%- include("../partials/footer") %>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/user.js"></script>
</body>

</html>