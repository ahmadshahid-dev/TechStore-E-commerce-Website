<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Checkout | TechStore</title>
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 antialiased selection:bg-orange-500 selection:text-white">
  <!-- Header -->
  <%- include("../partials/header") %>
  <!-- Main -->
  <main>
    <!-- Page Header -->
    <section class="bg-gradient-to-b from-orange-50/40 via-white to-slate-50 dark:from-slate-900 dark:via-slate-900/80 dark:to-slate-950 border-b border-slate-200/80 dark:border-slate-800/80 
    py-8 sm:py-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-y-1.5">
          <!-- Breadcrumb Navigation -->
          <nav class="text-slate-500 dark:text-slate-400 text-xs font-inter font-medium flex items-center gap-2">
            <a class="hover:text-orange-600 dark:hover:text-orange-500 hover:transition-colors" href="/">Home</a>
            <svg class="text-slate-400 h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <a class="hover:text-orange-600 dark:hover:text-orange-500 hover:transition-colors" href="/@<%= user.username %>/cart">Cart</a>
            <svg class="text-slate-400 h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span class="text-slate-800 dark:text-slate-200 font-semibold">Checkout</span>
          </nav>
          <!-- Header Title & -->
          <div class="flex items-center gap-x-2.5 mb-1">
            <span class="bg-orange-50 dark:bg-orange-500/10 text-orange-500 dark:text-orange-400 h-10 w-10 border border-orange-200/60 dark:border-orange-500/20 rounded-2xl shadow-sm inline-flex items-center justify-center">
              🛍️
            </span>
            <h1 class="text-orange-600 dark:text-orange-400 text-2xl sm:text-3xl font-montserrat font-extrabold leading-none">
              Checkout
            </h1>
          </div>
          <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm font-inter">Complete your purchase securely and enjoy a smooth, simple checkout experience from start to finish.</p>
        </div>
      </div>
    </section>
    <!-- Checkout -->
    <section class="border-b border-slate-200 dark:border-slate-800 py-8 sm:py-10 lg:py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Populated Checkout Form Grid -->
        <form id="checkout-form">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <!-- Left Column (8 Columns) -->
            <div class="lg:col-span-8 space-y-6">
              <!-- View-Only Order Items Review -->
              <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-sm space-y-4 p-4 sm:p-6">
                <div class="flex items-start justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
                  <div class="flex items-center gap-x-3">
                    <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-10 w-10 flex items-center justify-center rounded-2xl">
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                      </svg>
                    </div>
                    <div class="flex-1 space-y-1.5">
                      <h2 class="text-slate-900 dark:text-white text-base font-montserrat font-bold leading-none">
                        Items to be Delivered
                      </h2>
                      <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">
                        View-only checklist of items included in this shipment.
                      </p>
                    </div>
                  </div>
                  <span class="text-slate-500 text-xs font-inter font-bold">
                    <%= cartItems.length %> <%= cartItems.length === 1 ? 'Item' : 'Items' %>
                  </span>
                </div>
                <!-- Items List (No Edit Buttons) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <% cartItems.forEach((item) => { %>
                  <div class="bg-slate-50/70 dark:bg-slate-800/40 flex items-center justify-between gap-4 border border-slate-200/60 dark:border-slate-800 rounded-2xl p-3.5">
                    <div class="flex items-center gap-x-2.5 sm:gap-x-3.5">
                      <div class="relative h-16 w-16 border border-slate-200/60 dark:border-slate-700 rounded-xl shrink-0 overflow-hidden">
                        <span class="bg-orange-500 text-white text-xs font-montserrat font-semibold leading-none border border-slate-200 rounded-full absolute z-5 p-0.75 px-1.5"><%= item.quantity %></span>
                        <img class="h-full w-full object-cover" src="<%= item.image %>" alt="<%= item.name %>" />
                      </div>
                      <div class="flex flex-col space-y-0.5">
                        <h4 class="text-slate-800 dark:text-slate-300 text-[0.8050rem] sm:text-sm font-montserrat font-semibold line-clamp-2">
                          <%= item.name %>
                        </h4>
                        <span class="text-slate-900 dark:text-slate-100 text-sm font-inter font-medium flex gap-x-[0.315rem]">
                          Rs:
                          <span class="font-bold"><%= (item.currentPrice * item.quantity).toLocaleString() %></span>
                        </span>
                      </div>
                    </div>
                  </div>
                  <% }) %>
                </div>
              </div>
              <!-- Delivery Address -->
              <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-sm space-y-4 p-4 sm:p-6">
                <div class="flex flex-col sm:flex-row items-start sm:items-center sm:justify-between gap-y-2.5 border-b border-slate-100 dark:border-slate-800 pb-4">
                  <div class="flex items-start sm:items-center gap-x-3">
                    <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-10 w-10 flex items-center justify-center rounded-2xl">
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                    </div>
                    <div class="flex-1 space-y-1.5">
                      <h2 class="text-slate-900 dark:text-white text-base font-montserrat font-bold leading-none">
                        Delivery Address
                      </h2>
                      <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">
                        Selected shipping destination from your address book.
                      </p>
                    </div>
                  </div>
                  <a class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 flex items-center gap-1.5 border border-slate-200 dark:border-slate-700 py-2 px-3.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-700" href="/<%= '@' + user?.username %>/address-book">
                    <span class="text-xs font-inter font-semibold">Change Address</span>
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
                <div class="bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-800 rounded-2xl flex items-start justify-between gap-4 p-4 sm:p-5">
                  <div class="space-y-1.5">
                    <input type="hidden" name="addressId" value="<%= address._id %>">
                    <div class="flex items-center gap-x-2.5">
                      <span class="text-slate-900 dark:text-white text-sm font-montserrat font-bold truncate">
                        <%= address.fullName %>
                      </span>
                      <span class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 text-[0.6250rem] font-inter font-semibold truncate border border-orange-200/50 rounded-md py-0.5 px-2"><%= address.isDefault ? 'Selected Default Add.' : '' %></span>
                    </div>
                    <p class="text-slate-500 dark:text-slate-400 text-xs font-inter font-medium"><%= address.stateAddress %></p>
                    <p class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold">
                      <%= address.city %> <%= address.province %> <%= address.country %> -
                      <span class="text-orange-600 dark:text-orange-400 font-bold"><%= address.postalCode %></span>
                    </p>
                    <p class="text-slate-500 text-xs font-inter font-medium">
                      📞 Contact:
                      <span class="text-slate-600 dark:text-slate-300 font-semibold"><%= address.phone %></span>
                    </p>
                  </div>
                </div>
              </div>
              <!-- Order Notification Email -->
              <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-sm space-y-4 p-4 sm:p-6">
                <div class="flex items-start gap-3 border-b border-slate-100 dark:border-slate-800 pb-3">
                  <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-10 w-10 flex items-center justify-center rounded-2xl">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div class="flex-1 space-y-1.5">
                    <h2 class="text-slate-900 dark:text-white text-base font-montserrat font-bold leading-none">
                      Order Notification Email
                    </h2>
                    <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">
                      Order receipts and shipping updates will be sent to this email.
                    </p>
                  </div>
                </div>
                <div class="space-y-1.5">
                  <label class="text-slate-700 dark:text-slate-300 text-xs font-inter font-semibold block" for="orderEmail">Email Address *</label>
                  <input class="bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white 
                  w-full text-sm font-inter border border-slate-200 dark:border-slate-700 rounded-xl focus:ring focus:ring-orange-500/20 focus:border-orange-500 outline-none py-2.5 px-5" id="orderEmail" type="email" name="orderEmail" placeholder="your.email@example.com" required />
                  <p class="error text-rose-500 text-xs font-inter" id="error-orderEmail"></p>
                </div>
              </div>
              <!-- Delivery Speed Method -->
              <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-sm space-y-4 p-4 sm:p-6">
                <div class="flex items-center gap-x-3 border-b border-slate-100 dark:border-slate-800 pb-3">
                  <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-10 w-10 flex items-center justify-center rounded-2xl">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  </div>
                  <div class="flex-1 space-y-1.5">
                    <h2 class="text-slate-900 dark:text-white text-base font-montserrat font-bold leading-none">
                      Delivery Speed Method
                    </h2>
                    <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">
                      Choose shipping speed for your hardware order.
                    </p>
                  </div>
                </div>
                <div class="block space-y-1.5">
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <label class="relative cursor-pointer">
                      <input class="sr-only peer" id="Standard" type="radio" name="shippingMethod" value="Standard" checked />
                      <div class="border-2 border-slate-200 dark:border-slate-800 peer-checked:bg-orange-50/50 dark:peer-checked:bg-orange-500/10 peer-checked:border-orange-600 rounded-2xl p-4">
                        <div class="flex items-center justify-between mb-1">
                          <span class="text-slate-900 dark:text-white text-sm font-montserrat font-bold">Standard Delivery</span>
                          <span class="text-emerald-600 dark:text-emerald-400 text-xs font-inter font-bold">FREE</span>
                        </div>
                        <p class="text-slate-500 text-xs font-inter">Delivered within 3 - 5 Business Days</p>
                      </div>
                    </label>
                    <label class="relative cursor-pointer">
                      <input class="sr-only peer" id="Express" type="radio" name="shippingMethod" value="Express" />
                      <div class="border-2 border-slate-200 dark:border-slate-800 peer-checked:bg-orange-50/50 dark:peer-checked:bg-orange-500/10 peer-checked:border-orange-600 rounded-2xl p-4">
                        <div class="flex items-center justify-between mb-1">
                          <span class="text-slate-900 dark:text-white text-sm font-montserrat font-bold flex gap-x-1">Express Delivery ⚡</span>
                          <span class="text-slate-900 dark:text-white text-xs font-inter font-medium">
                            Rs: <span class="font-bold">500</span></span>
                        </div>
                        <p class="text-slate-500 text-xs font-inter">24 - 48 Hours Express Courier</p>
                      </div>
                    </label>
                  </div>
                  <p class="error text-rose-500 text-xs font-inter" id="error-shippingMethod"></p>
                </div>
              </div>
              <!-- Payment Method (COD) -->
              <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-sm space-y-4 p-4 sm:p-6">
                <div class="flex items-center gap-x-3 border-b border-slate-100 dark:border-slate-800 pb-3">
                  <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-10 w-10 flex items-center justify-center rounded-2xl">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                  </div>
                  <div class="flex-1 space-y-1.5">
                    <h2 class="text-slate-900 dark:text-white text-base font-montserrat font-bold leading-none">
                      Payment Method
                    </h2>
                    <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">
                      Cash payment at doorstep service.
                    </p>
                  </div>
                </div>
                <div class="bg-orange-50/50 dark:bg-orange-500/10 border-2 border-orange-600 flex items-center justify-between rounded-2xl p-4">
                  <div class="flex items-center gap-x-3">
                    <span class="text-2xl">💵</span>
                    <div class="flex flex-col gap-y-1.5">
                      <span class="text-slate-900 dark:text-white text-sm font-montserrat font-bold leading-none">Cash on Delivery (COD)</span>
                      <span class="text-slate-500 text-xs font-inter">Pay cash in hand directly to rider upon receiving package at your doorstep.</span>
                    </div>
                  </div>
                  <span class="bg-orange-600 text-white h-5 w-5 text-xs font-montserrat font-bold flex items-center justify-center flex-shrink-0 rounded-full">✓</span>
                </div>
              </div>
            </div>
            <!-- Right Column: Order Summary (4 Columns) -->
            <div class="lg:col-span-4 lg:sticky lg:top-24">
              <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-sm flex flex-col gap-5 p-6">
                <h2 class="text-slate-900 dark:text-white text-lg font-montserrat font-bold border-b border-slate-100 dark:border-slate-800 pb-4">
                  Order Summary
                </h2>
                <% 
                 let subTotal = 0; 
                 cartItems.forEach(item => {
                 subTotal += item.currentPrice * item.quantity; 
                 });
                 let shipping = 200; 
                 let grandTotal = subTotal + shipping; 
                %>
                <!-- Price Breakdown -->
                <div class="space-y-2.5">
                  <div class="flex items-center justify-between">
                    <span class="text-slate-600 dark:text-slate-400 text-sm font-inter font-medium">Subtotal</span>
                    <span class="text-slate-900 dark:text-white text-sm font-inter font-medium">
                      Rs: <span class="font-bold" id="subTotal" data-sub-total="<%= subTotal %>">
                        <%= subTotal.toLocaleString() %></span>
                    </span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-slate-600 dark:text-slate-400 text-sm font-inter font-medium">Shipping</span>
                    <span class="text-slate-900 dark:text-white text-sm font-inter font-medium">
                      Rs:
                      <span class="text-emerald-600 dark:text-emerald-400 font-bold" id="shipping" data-shipping="<%= shipping %>"><%= shipping %></span>
                    </span>
                  </div>
                  <div class="border-t border-slate-100 dark:border-slate-800 flex items-center justify-between pt-4">
                    <div class="flex flex-col gap-y-0.75">
                      <span class="text-slate-900 dark:text-white text-base font-montserrat font-bold leading-none">Grand Total</span>
                      <span class="text-slate-400 text-[0.6875rem] font-inter font-medium">Payable via COD on delivery</span>
                    </div>
                    <span class="text-orange-600 dark:text-orange-400 text-xl sm:text-2xl font-montserrat font-extrabold">
                      Rs: <span id="grandTotal"><%= grandTotal.toLocaleString() %></span>
                    </span>
                  </div>
                </div>
                <!-- Place Order Button -->
                <button class="bg-orange-600 text-white w-full text-center flex items-center justify-center gap-2 rounded-2xl shadow-lg shadow-orange-600/25 py-4 px-6 cursor-pointer hover:bg-orange-700 active:scale-[0.98] transition ease-out duration-[250ms]" type="submit">
                  <span class="Spinner h-4.5 w-4.5 border-[3px] border-orange-100 border-t-orange-500 shrink-0 rounded-full animate-spin drop-shadow-[0_0_4px_rgba(249,115,22,0.6)] hidden"></span>
                  <span class="Text text-base font-montserrat font-semibold leading-none">Place Order (COD)</span>
                  <svg class="Icon h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </button>
                <!-- Security Trust Badges -->
                <div class="text-center flex items-center justify-center gap-2 pt-1.5">
                  <span class="text-slate-500 text-[0.6875rem] font-montserrat font-medium">🔒 256-Bit SSL Encrypted</span>
                  <span class="text-slate-400 text-[0.6875rem] font-inter font-bold">•</span>
                  <span class="text-slate-600 dark:text-slate-400 text-[0.6875rem] font-inter font-medium">30-Day Returns</span>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
    </section>
  </main>
  <!-- Footer -->
  <%- include("../partials/footer") %>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/user.js"></script>
</body>

</html>