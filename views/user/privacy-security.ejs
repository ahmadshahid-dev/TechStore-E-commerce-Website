<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Privacy & Security | TechStore</title>
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 antialiased selection:bg-orange-500 selection:text-white">
  <!-- Header -->
  <%- include("../partials/header") %>
  <!-- Main -->
  <main>
    <!-- ==================== PRIVACY/SECURITY SECTIONS & BREADCRUMB ==================== -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <!-- ==================== 1. BREADCRUMB & HEADER ==================== -->
      <div class="mb-5">
        <nav class="text-slate-500 dark:text-slate-400 text-xs font-inter font-medium flex items-center gap-x-2 mb-1.5">
          <a href="/" class="hover:text-orange-600 dark:hover:text-orange-500 hover:transition-colors">Home</a>
          <svg class="text-slate-400 h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <a class="hover:text-orange-600 dark:hover:text-orange-500 hover:transition-colors" href="/@<%= user.username %>/profile-overview">Account</a>
          <svg class="text-slate-400 h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-slate-800 dark:text-slate-200 font-semibold">Privacy &
            Security</span>
        </nav>
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div class="space-y-1.5">
            <h1 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-extrabold tracking-tight leading-none flex items-center gap-x-2.5">
              <span class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-11 w-11 flex items-center justify-center border border-orange-200/60 dark:border-orange-500/20 rounded-2xl shadow-sm shrink-0">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </span>
              Security & <span class="text-orange-600 dark:text-orange-400">Privacy</span>
            </h1>
            <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm font-inter">
              Manage your credentials, 2-factor authentication, active devices, and
              privacy rights.
            </p>
          </div>
          <!-- Shield Status Badge -->
          <div class="bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-500/20 self-start sm:self-auto inline-flex items-center gap-2.5 rounded-2xl shadow-sm py-2 px-4">
            <span class="bg-emerald-500 h-2.5 w-2.5 rounded-full animate-pulse"></span>
            <span class="text-xs font-montserrat font-bold">Account Shield:
              Active</span>
          </div>
        </div>
      </div>
      <!-- ==================== 2. STICKY QUICK-NAV TABS ==================== -->
      <div class="bg-slate-50/90 dark:bg-slate-950/90 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800 sticky top-18 py-3 mb-8 z-45">
        <div class="flex items-center gap-x-2.5 overflow-x-auto no-scrollbar scroll-smooth py-1.5">
          <button class="sec-tab-btn bg-orange-600 text-white text-xs font-montserrat font-bold whitespace-nowrap rounded-xl shadow-md shadow-orange-600/20 cursor-pointer py-2.5 px-4 transition ease-out duration-[250ms]" id="tab-sec-email" onclick="scrollToSection('sec-email')">
            📧 Email & Verification
          </button>
          <button class="sec-tab-btn bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold border border-slate-200 dark:border-slate-800 rounded-xl cursor-pointer whitespace-nowrap py-2.5 px-4 hover:bg-slate-100 dark:hover:bg-slate-800 hover:transition hover:ease-out hover:duration-[250ms]" id="tab-sec-password" onclick="scrollToSection('sec-password')">
            🔑 Password & 2FA
          </button>
          <button class="sec-tab-btn bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold border border-slate-200 dark:border-slate-800 rounded-xl cursor-pointer whitespace-nowrap py-2.5 px-4 hover:bg-slate-100 dark:hover:bg-slate-800 hover:transition hover:ease-out hover:duration-[250ms]" id="tab-sec-sessions" onclick="scrollToSection('sec-sessions')">
            💻 Active Sessions
          </button>
          <button class="sec-tab-btn bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold border border-slate-200 dark:border-slate-800 rounded-xl cursor-pointer whitespace-nowrap py-2.5 px-4 hover:bg-slate-100 dark:hover:bg-slate-800 hover:transition hover:ease-out hover:duration-[250ms]" id="tab-sec-privacy" onclick="scrollToSection('sec-privacy')">
            🔒 Data & Privacy
          </button>
          <button class="sec-tab-btn bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 text-xs font-montserrat font-semibold border border-rose-200/60 dark:border-rose-500/20 rounded-xl cursor-pointer py-2.5 px-4 hover:bg-rose-100 dark:hover:bg-rose-800  whitespace-nowrap hover:transition hover:ease-out hover:duration-[250ms]" id="tab-sec-danger" onclick="scrollToSection('sec-danger')">
            ⚠️ Danger Zone
          </button>
        </div>
      </div>
      <!-- ==================== 3. MAIN SECURITY SECTIONS ==================== -->
      <div class="max-w-4xl mx-auto flex flex-col gap-y-8 overflow-hidden">
        <!-- CARD 1: Email Address & Verification -->
        <section class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-3xl shadow-sm space-y-6 p-6 sm:p-8 scroll-mt-28 sm:scroll-mt-36" id="sec-email">
          <div class="flex items-center justify-between flex-wrap gap-3 border-b border-slate-100 dark:border-slate-800 pb-4">
            <div class="flex items-center gap-x-3">
              <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-10 w-10 flex items-center justify-center rounded-2xl shrink-0">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="space-y-1">
                <h2 class="text-slate-900 dark:text-white text-base font-montserrat font-bold leading-none">
                  Email Address & Status
                </h2>
                <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">
                  Primary contact email used for logins, security alerts, and order
                  receipts.
                </p>
              </div>
            </div>
            <% if (_user.verificationStatus==='Verified' ) { %>
            <span class="bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-montserrat font-bold inline-flex items-center gap-x-1.5 border border-emerald-200/60 dark:border-emerald-500/20 rounded-full py-1 px-3">
              <span class="bg-emerald-500 h-1.5 w-1.5 rounded-full"></span> Verified
              Account
            </span>
            <% } else { %>
            <span class="bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 text-xs font-montserrat font-bold inline-flex items-center gap-x-1.5 border border-amber-200/60 dark:border-amber-500/20 rounded-full py-1 px-3">
              <span class="bg-amber-500 h-1.5 w-1.5 rounded-full animate-ping"></span>
              Unverified
            </span>
            <% } %>
          </div>
          <!-- Current Email Info -->
          <div class="bg-slate-50/70 dark:bg-slate-800/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border border-slate-200/60 dark:border-slate-800 rounded-2xl p-5">
            <div class="flex flex-col gap-y-1">
              <span class="text-slate-400 text-xs font-inter font-semibold uppercase tracking-wider leading-none block my-0.5">Currently
                Linked Email</span>
              <span class="text-slate-900 dark:text-white text-sm font-montserrat font-semibold leading-none">
                <%= _user.email || '' %>
              </span>
            </div>
            <button class="bg-orange-600 text-white inline-flex items-center gap-2 rounded-xl shadow-md shadow-orange-500/25 cursor-pointer self-start sm:self-auto py-2.5 px-4 hover:bg-orange-700 active:scale-[0.98] transition ease-out duration-[250ms]" type="button">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
              <span class="text-xs font-montserrat font-bold">Send Verification
                Link</span>
            </button>
          </div>
          <!-- Update Email Form -->
          <form class="space-y-4 pt-2" id="emailUpdateForm">
            <h3 class="text-slate-800 dark:text-slate-200 text-xs font-montserrat font-bold uppercase tracking-wider">
              Change Email Address</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label class="text-slate-700 dark:text-slate-300 text-xs font-inter font-semibold block" for="newEmail">New Email Address</label>
                <input class="bg-slate-50 dark:bg-slate-800/60 text-slate-900 dark:text-white w-full text-xs font-inter border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring focus:border-orange-500 focus:ring-orange-500 rounded-xl py-2.5 px-3.5" id="newEmail" type="email" name="newEmail" placeholder="newemail@example.com" autocomplete="off" required />
                <p class="error text-rose-500 text-xs font-inter" id="error-newEmail">
                </p>
              </div>
              <div class="space-y-1.5">
                <label class="text-slate-700 dark:text-slate-300 text-xs font-inter font-semibold block" for="confirmCurrentPassword">Confirm Current Password</label>
                <div class="relative">
                  <input class="bg-slate-50 dark:bg-slate-800/60 text-slate-900 dark:text-white w-full text-xs font-inter border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring focus:border-orange-500 focus:ring-orange-500 rounded-xl py-2.5 px-3.5" id="confirmCurrentPassword" type="password" name="confirmCurrentPassword" placeholder="••••••••" autocomplete="off" required />
                  <button class="password-toggle text-slate-400 text-xs font-inter font-semibold absolute top-1/2 right-3 -translate-y-1/2 cursor-pointer hover:text-slate-600 dark:hover:text-slate-200" type="button" data-target="confirmCurrentPassword" aria-label="Show password">
                    <svg class="eye-off h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18">
                      </path>
                    </svg>
                    <svg class="eye h-5 w-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z">
                      </path>
                    </svg>
                  </button>
                </div>
                <p class="error text-rose-500 text-xs font-inter" id="error-confirmCurrentPassword"></p>
              </div>
            </div>
            <button class="bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 flex items-center justify-center gap-x-1.5 rounded-xl cursor-pointer py-2.5 px-5 mt-1.5 hover:bg-slate-800 dark:hover:bg-white hover:transition-colors hover:ease-out hover:duration-[250ms]" type="submit">
              <span class="Spinner h-3.5 w-3.5 border-[3px] border-orange-100 border-t-orange-500 shrink-0 rounded-full animate-spin drop-shadow-[0_0_4px_rgba(249,115,22,0.6)] hidden"></span>
              <span class="Text text-xs font-montserrat font-bold">Save New Email</span>
            </button>
          </form>
        </section>
        <!-- CARD 2: Password & 2FA -->
        <section class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-3xl shadow-sm space-y-6 p-6 sm:p-8 scroll-mt-28 sm:scroll-mt-36" id="sec-password">
          <div class="flex items-center gap-x-3 border-b border-slate-100 dark:border-slate-800 pb-4">
            <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-10 w-10 flex items-center justify-center rounded-2xl shrink-0">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <div class="space-y-1">
              <h2 class="text-slate-900 dark:text-white text-base font-montserrat font-bold leading-none">
                Password & Authentication
              </h2>
              <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">
                Update your account password regularly and turn on 2FA for enhanced
                protection.
              </p>
            </div>
          </div>
          <form class="space-y-4" id="passwordUpdateForm">
            <!-- Current Password -->
            <div class="space-y-1.5">
              <label class="text-slate-700 dark:text-slate-300 text-xs font-inter font-semibold block" for="currentPassword">Current Password</label>
              <div class="relative max-w-md">
                <input class="bg-slate-50 dark:bg-slate-800/60 text-slate-900 dark:text-white w-full text-xs font-inter border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring focus:border-orange-500 focus:ring-orange-500 rounded-xl py-2.5 px-3.5 pr-10" id="currentPassword" type="password" name="currentPassword" placeholder="••••••••" required />
                <button class="password-toggle text-slate-400 text-xs font-inter font-semibold absolute top-1/2 right-3 -translate-y-1/2 cursor-pointer hover:text-slate-600 dark:hover:text-slate-200" type="button" data-target="currentPassword" aria-label="Show password">
                  <svg class="eye-off h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18">
                    </path>
                  </svg>
                  <svg class="eye h-5 w-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z">
                    </path>
                  </svg>
                </button>
              </div>
              <p class="error text-rose-500 text-xs font-inter" id="error-currentPassword"></p>
            </div>
            <!-- New Password & Confirm -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label class="text-slate-700 dark:text-slate-300 text-xs font-inter font-semibold block" for="newPassword">New Password</label>
                <div class="relative">
                  <input class="bg-slate-50 dark:bg-slate-800/60 text-slate-900 dark:text-white w-full text-xs font-inter border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring focus:border-orange-500 focus:ring-orange-500 rounded-xl py-2.5 px-3.5 pr-10" id="newPassword" type="password" name="newPassword" placeholder="••••••••" required />
                  <button class="password-toggle text-slate-400 text-xs font-inter font-semibold absolute top-1/2 right-3 -translate-y-1/2 cursor-pointer hover:text-slate-600 dark:hover:text-slate-200" type="button" data-target="newPassword" aria-label="Show password">
                    <svg class="eye-off h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18">
                      </path>
                    </svg>
                    <svg class="eye h-5 w-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z">
                      </path>
                    </svg>
                  </button>
                </div>
                <p class="error text-rose-500 text-xs font-inter" id="error-newPassword"></p>
                <!-- Password Strength Indicator -->
                <div class="space-y-1 py-1">
                  <div class="flex gap-x-1.5">
                    <div id="strength-1" class="bg-slate-200 dark:bg-slate-700 h-1 flex-1 rounded-full">
                    </div>
                    <div id="strength-2" class="bg-slate-200 dark:bg-slate-700 h-1 flex-1 rounded-full">
                    </div>
                    <div id="strength-3" class="bg-slate-200 dark:bg-slate-700 h-1 flex-1 rounded-full">
                    </div>
                  </div>
                  <div class="text-slate-500 dark:text-slate-400 text-xs font-inter flex items-center justify-between">
                    <span>Password strength</span>
                    <span id="strength-level" class="text-slate-700 dark:text-slate-300 font-semibold">
                      Weak
                    </span>
                  </div>
                </div>
              </div>
              <div class="space-y-1.5">
                <label class="text-slate-700 dark:text-slate-300 text-xs font-inter font-semibold block" for="confirmPassword">Confirm New Password</label>
                <input class="bg-slate-50 dark:bg-slate-800/60 text-slate-900 dark:text-white w-full text-xs font-inter border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring focus:border-orange-500 focus:ring-orange-500 rounded-xl py-2.5 px-3.5 pr-10" id="confirmPassword" type="password" name="confirmPassword" placeholder="••••••••" required />
                <p class="error text-rose-500 text-xs font-inter" id="error-confirmPassword"></p>
              </div>
            </div>
            <button class="bg-orange-600 text-white flex items-center justify-center gap-x-1.5 rounded-xl shadow-md shadow-orange-500/25 cursor-pointer py-2.5 px-6 hover:bg-orange-700 active:scale-[0.98] transition ease-out duration-[250ms]" type="submit">
              <span class="Spinner h-3.5 w-3.5 border-[3px] border-orange-100 border-t-orange-500 shrink-0 rounded-full animate-spin drop-shadow-[0_0_4px_rgba(249,115,22,0.6)] hidden"></span>
              <span class="Text text-xs font-montserrat font-bold">Update Password</span>
            </button>
          </form>
          <!-- 2FA Toggle Bar -->
          <div class="border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-4 pt-6">
            <div class="space-y-0.5">
              <h3 class="text-slate-900 dark:text-white text-sm font-montserrat font-bold">
                Two-Factor Authentication (2FA)</h3>
              <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">Require
                an authenticator app code when signing into your TechStore account.</p>
            </div>
            <label class="relative inline-flex items-center shrink-0 cursor-pointer" for="2FToggle">
              <input class="openTrigger sr-only peer" id="2FToggle" type="checkbox" data-model="2FModel" <%=_user.twoFctrVerification===true ? 'checked'
                  : '' %> data-checked="<%= _user.twoFctrVerification %>" />
              <div class="bg-slate-200 dark:bg-slate-700 h-6 w-11 rounded-full peer-focus:outline-none peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 peer-checked:bg-orange-600 after:transition">
              </div>
            </label>
          </div>
        </section>
        <!-- CARD 3: Active Device Sessions -->
        <section class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-3xl shadow-sm space-y-6 p-6 sm:p-8 scroll-mt-28 sm:scroll-mt-36" id="sec-sessions">
          <div class="flex items-center justify-between flex-wrap gap-2 border-b border-slate-100 dark:border-slate-800 pb-4">
            <div class="flex items-center gap-x-3">
              <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-10 w-10 flex items-center justify-center rounded-2xl shrink-0">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="space-y-1">
                <h2 class="text-slate-900 dark:text-white text-base font-montserrat font-bold leading-none">
                  Active Device Sessions
                </h2>
                <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">
                  Devices and web browsers logged into your account. Revoke any
                  unfamiliar device.
                </p>
              </div>
            </div>
            <button class="text-rose-600 dark:text-rose-400 text-xs font-montserrat font-bold hover:underline shrink-0 cursor-pointer" id="signOutAllBtn" type="button">
              Sign Out All Other Sessions
            </button>
          </div>
          <!-- Sessions List -->
          <% sessions.forEach((session) => { %>
          <!-- Current Active Device -->
          <div class="bg-orange-50/50 dark:bg-orange-500/5 border border-orange-200/60 dark:border-orange-500/20 flex items-center justify-between flex-wrap gap-3 rounded-2xl p-4" id="session-<%= session.id %>">
            <div class="flex items-center gap-3">
              <div class="bg-orange-100 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-10 w-10 text-lg font-bold flex items-center justify-center shrink-0 rounded-xl">
                <%= session.userAgent === "Windows — Chrome" ? '💻' : '📱' %>
              </div>
              <div class="flex flex-col gap-y-0.75">
                <div class="flex items-center gap-x-2">
                  <span class="text-slate-900 dark:text-white text-xs sm:text-sm font-montserrat font-bold leading-none"><%= session.userAgent %></span>
                  <% if(session.isCurrent) { %>
                  <span class="bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 text-[0.6250rem] font-montserrat font-bold truncate border border-emerald-200/50 rounded-md py-0.5 px-2">Current Device</span>
                  <% } %>
                </div>
                <span class="text-slate-500 text-[0.6875rem] font-inter">IP:
                  <%= session.ip %> • <%= session.location %>
                </span>
              </div>
            </div>
            <!-- Creating & Last Access Session -->
            <div class="flex flex-col gap-y-0.5">
              <span class="text-slate-500 text-[0.6875rem] font-inter">Created:
                <%= new Date(session.createdAt).toLocaleString().toUpperCase() %>
              </span>
              <span class="text-slate-500 text-[0.6875rem] font-inter">
                Last Active: <%= new Date(session.lastActiveAt).toLocaleString().toUpperCase() %>
              </span>
            </div>
            <% if(!session.isCurrent && session.id) { %>
            <form class="sessionRevokeForms" data-device-id="<%= session.id %>">
              <button class="text-rose-600 text-xs font-montserrat font-semibold border border-rose-200/60 dark:border-rose-900/40 hover:bg-rose-50 dark:hover:bg-rose-500/10 py-1.5 px-3 rounded-xl cursor-pointer hover:transition-colors hover:ease-out hover:duration-[250ms]" type="submit">Revoke Access</button>
            </form>
            <% } %>
          </div>
          <%  }); %>
        </section>
        <!-- CARD 4: Data & Privacy Preferences -->
        <section class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-3xl shadow-sm space-y-6 p-6 sm:p-8 scroll-mt-28 sm:scroll-mt-36" id="sec-privacy">
          <div class="flex items-center gap-3 border-b border-slate-100 dark:border-slate-800 pb-4">
            <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-10 w-10 flex items-center justify-center rounded-2xl shrink-0">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="space-y-1">
              <h2 class="text-slate-900 dark:text-white text-base font-montserrat font-bold leading-none">
                Data & Privacy Controls
              </h2>
              <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">
                Manage communications, newsletter preferences, and export an archive of
                your account data.
              </p>
            </div>
          </div>
          <div class="space-y-4">
            <div class="flex items-center justify-between py-2">
              <div class="space-y-1">
                <h3 class="text-slate-900 dark:text-white text-xs sm:text-sm font-montserrat font-bold leading-none">
                  Promotional Newsletters & Tech Alerts</h3>
                <p class="text-slate-500 text-xs font-inter">Receive discount coupons
                  and new hardware drops via email.</p>
              </div>
              <input class="text-orange-600 h-4 w-4 accent-orange-600 rounded cursor-pointer" type="checkbox" checked />
            </div>
            <div class="flex items-center justify-between border-t border-slate-100 dark:border-slate-800 flex-wrap gap-3 pt-3">
              <div class="space-y-1">
                <h3 class="text-slate-900 dark:text-white text-xs sm:text-sm font-montserrat font-bold leading-none">
                  Export Personal Data</h3>
                <p class="text-slate-500 text-xs font-inter">Download a full JSON
                  archive of your profile info, address book, and order invoices.</p>
              </div>
              <button class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-montserrat font-semibold border border-slate-200 dark:border-slate-700 rounded-xl cursor-pointer py-2.5 px-4 hover:bg-slate-100 dark:hover:bg-slate-700 hover:transition-colors hover:ease-out duration-[250ms]" type="button">
                Export Data (.JSON)
              </button>
            </div>
          </div>
        </section>
        <!-- CARD 5: Danger Zone -->
        <section class="bg-rose-50/30 dark:bg-rose-500/5 border border-rose-200 dark:border-rose-900/40 rounded-3xl shadow-sm space-y-5 p-6 sm:p-8 scroll-mt-28 sm:scroll-mt-36" id="sec-danger">
          <div class="flex items-center gap-x-3">
            <div class="bg-rose-100 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 h-10 w-10 flex items-center justify-center rounded-2xl shrink-0">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </div>
            <div class="space-y-1">
              <h2 class="text-rose-600 dark:text-rose-400 text-base font-montserrat font-bold leading-none">
                Danger Zone
              </h2>
              <p class="text-slate-600 dark:text-slate-400 text-xs font-inter">
                Irreversibly delete your account, saved addresses, and previous
                transaction logs.
              </p>
            </div>
          </div>
          <p class="text-slate-500 dark:text-slate-400 text-xs font-inter leading-relaxed max-w-xl">
            Once you delete your TechStore account, all active orders, wishlists, and
            loyalty benefits will be permanently wiped. This action cannot be undone.
          </p>
          <button class="openTrigger bg-rose-600 text-white text-xs font-montserrat font-bold rounded-xl shadow-md shadow-rose-600/20 cursor-pointer py-2.5 px-6 hover:bg-rose-700 active:scale-[0.98] hover:transition-colors hover:ease-out hover:duration-[250ms]" type="button" data-model="deleteModel">
            Delete Account Permanently
          </button>
        </section>
      </div>
    </div>
    <!-- ==================== TWO-FACTOR AUTH MODAL ==================== -->
    <div class="bg-slate-950/60 backdrop-blur-sm items-center justify-center fixed inset-0 z-50 p-4 overflow-y-auto hidden" id="2FModel">
      <div class="bg-white dark:bg-slate-900 relative w-full max-w-md border border-slate-200 dark:border-slate-800 rounded-3xl shadow-2xl space-y-5 p-6 sm:p-8 overflow-hidden transition-transform ease-in-out duration-300">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
          <h3 class="text-slate-900 dark:text-white text-base font-montserrat font-bold">
            Setup 2-Factor Authentication</h3>
          <button class="closeTrigger text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 cursor-pointer" type="button">✕</button>
        </div>
        <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">
          Scan this QR code using Google Authenticator, Authy, or 1Password:
        </p>
        <!-- Mock QR Code Box -->
        <div class="bg-white dark:bg-slate-900 h-40 w-40 flex items-center justify-center border border-slate-200 dark:border-slate-800 rounded-2xl shadow-inner mx-auto p-4">
          <div class="bg-slate-950 h-full w-full grid grid-cols-6 gap-1 rounded-lg p-2">
            <div class="bg-white col-span-2 row-span-2"></div>
            <div class="bg-slate-950"></div>
            <div class="bg-white col-span-2 row-span-2"></div>
            <div class="bg-white"></div>
            <div class="bg-white col-span-2 row-span-2"></div>
          </div>
        </div>
        <div class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-inter font-medium text-center rounded-xl p-2.5">
          SECRET: <span class="font-mono font-bold">TECH-0000-AUTH-KEY</span>
        </div>
        <form id="2FactorAuthForm">
          <div class="space-y-1.5">
            <label class="text-slate-700 dark:text-slate-300 text-xs font-inter font-semibold block" for="_2fctrCurntPaswrd">Enter Current Password</label>
            <div class="relative max-w-md">
              <input class="bg-slate-50 dark:bg-slate-800/60 text-slate-900 dark:text-white w-full text-xs font-inter border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring focus:border-orange-500 focus:ring-orange-500 rounded-xl py-2.5 px-3.5 pr-10" id="_2fctrCurntPaswrd" type="password" name="_2fctrCurntPaswrd" placeholder="••••••••" required>
              <button class="password-toggle text-slate-400 text-xs font-inter font-semibold absolute top-1/2 right-3 -translate-y-1/2 cursor-pointer hover:text-slate-600 dark:hover:text-slate-200" type="button" data-target="_2fctrCurntPaswrd" aria-label="Show password">
                <svg class="eye-off h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18">
                  </path>
                </svg>
                <svg class="eye h-5 w-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z">
                  </path>
                </svg>
              </button>
            </div>
            <p class="error text-rose-500 text-xs font-inter" id="error-_2fctrCurntPaswrd"></p>
          </div>
          <div class="flex justify-end gap-3 pt-2">
            <button class="cancelTrigger text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold border border-slate-200 dark:border-slate-700 rounded-xl cursor-pointer py-2 px-4 hover:bg-slate-100 dark:hover:bg-slate-800 hover:transition-colors hover:ease-out hover:duration-[250ms]" type="button">
              Cancel
            </button>
            <button class="bg-orange-600 text-white flex items-center justify-center gap-x-1.5 rounded-xl shadow-md shadow-orange-500/25 cursor-pointer py-2 px-5 hover:bg-orange-700 active:scale-[0.98] transition-colors ease-out duration-[250ms]" type="submit">
              <span class="Spinner h-3.5 w-3.5 border-[3px] border-orange-100 border-t-orange-500 shrink-0 rounded-full animate-spin drop-shadow-[0_0_4px_rgba(249,115,22,0.6)] hidden"></span>
              <span class="Text text-xs font-montserrat font-bold">Verify & Activate</span>
            </button>
          </div>
        </form>
      </div>
    </div>
    <!-- ==================== DELETE ACCOUNT MODAL ==================== -->
    <div class="bg-slate-950/60 backdrop-blur-sm items-center justify-center fixed inset-0 z-50 p-4 overflow-y-auto hidden" id="deleteModel">
      <div class="bg-white dark:bg-slate-900 relative w-full max-w-md border border-slate-200 dark:border-slate-800 rounded-3xl shadow-2xl space-y-5 p-6 sm:p-8 overflow-hidden transition-transform ease-in-out duration-300">
        <div class="flex items-center gap-3">
          <div class="bg-rose-50 dark:bg-rose-500/10 h-10 w-10 flex items-center justify-center rounded-2xl shrink-0">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div class="space-y-1.5">
            <h3 class="text-slate-900 dark:text-white text-base font-montserrat font-bold leading-none">
              Delete Account</h3>
            <p class="text-slate-500 text-xs font-inter">This action is permanent and
              irreversible.</p>
          </div>
        </div>
        <p class="text-slate-600 dark:text-slate-300 text-xs font-inter">
          To confirm deletion, please type <strong class="text-rose-600 font-mono">DELETE</strong> in the box below:
        </p>
        <form class="space-y-4" id="accountDeleteForm">
          <div class="space-y-1.5">
            <label class="text-slate-700 dark:text-slate-300 text-xs font-inter font-semibold block" for="Confirmation">Confirmation</label>
            <input class="bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white w-full text-xs font-mono border border-slate-200 dark:border-slate-700 focus:outline-none focus:border-rose-500 rounded-xl py-2.5 px-3.5" id="Confirmation" name="Confirmation" type="text" placeholder="Type DELETE" required />
            <p class="error text-rose-500 text-xs font-inter" id="error-Confirmation">
            </p>
          </div>
          <div class="flex justify-end gap-3 pt-2">
            <button class="cancelTrigger text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold border border-slate-200 dark:border-slate-700 rounded-xl cursor-pointer py-2 px-4 hover:bg-slate-100 dark:hover:bg-slate-800 hover:transition-colors hover:ease-out hover:duration-[250ms]" type="button">
              Cancel
            </button>
            <button class="bg-rose-600 text-white flex items-center justify-center gap-x-1.5 rounded-xl shadow-md shadow-orange-500/25 cursor-pointer opacity-40 py-2 px-5 hover:bg-orange-700 active:scale-[0.98] transition-colors ease-out duration-[250ms] cursor-not-allowed" id="accountDeletebtn" type="submit" disabled>
              <span class="Spinner h-3.5 w-3.5 border-[3px] border-orange-100 border-t-orange-500 shrink-0 rounded-full animate-spin drop-shadow-[0_0_4px_rgba(249,115,22,0.6)] hidden"></span>
              <span class="Text text-xs font-montserrat font-bold">Confirm Delete</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
  <!-- Footer -->
  <%- include("../partials/footer") %>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/user.js"></script>
</body>

</html>