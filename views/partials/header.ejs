<!-- ==================== MAIN HEADER ==================== -->
<header class="bg-white/85 dark:bg-slate-900/85 w-full backdrop-blur-md fixed top-0 left-0 right-0 border-b border-slate-200/80 dark:border-slate-800/80 z-50">
  <!-- Container -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Navbar -->
    <nav class="h-[4.50rem] flex items-center justify-between">
      <!-- Left: Mobile Menu Toggle & Brand Logo -->
      <div class="flex items-center gap-x-4">
        <!-- Mobile Menu Toggle Button (xl:hidden) -->
        <button class="text-slate-600 dark:text-slate-300 cursor-pointer xl:hidden" type="button" id="toggle" aria-controls="navmenu" aria-expanded="false" aria-label="Toggle Menu">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="bars" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            <path class="hidden" id="close" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <!-- Logo -->
        <a class="text-slate-900 dark:text-white text-xl sm:text-2xl font-montserrat font-extrabold tracking-tight" href="/">
          Tech<span class="text-orange-600 dark:text-orange-400">Store</span>
        </a>
      </div>
      <!-- Center: Desktop Navlinks -->
      <ul class="hidden xl:flex items-center gap-x-1.5">
        <!-- Home -->
        <li>
          <a class="<%= currentPage === 'Home' ? 'bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 font-semibold' : 'text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-orange-600 dark:hover:text-orange-400 font-medium' %> text-sm font-inter rounded-xl py-2 px-4" href="/">
            Home
          </a>
        </li>
        <!-- Category Dropdown -->
        <li class="flex justify-center relative">
          <button class="<%= ['Headphones', 'Keyboards', 'Mice'].includes(currentPage) ? 'bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 font-semibold' : 'text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-orange-600 dark:hover:text-orange-400 font-medium' %> flex items-center justify-center gap-x-1.5 rounded-xl cursor-pointer py-2 px-4" type="button" id="dropdownDesktop" aria-expanded="false" aria-controls="dropdownListDesktop">
            <span class="text-sm font-inter leading-[1.0625rem]">
              Category
            </span>
            <svg class="h-4 w-4" id="dropdownIconDesktop" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <!-- Dropdown Menu -->
          <ul class="bg-white dark:bg-slate-900 w-fit flex flex-col gap-y-1.5 absolute top-10 border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl dark:shadow-2xl p-1.5 z-50 opacity-0 invisible scale-95 transition ease-in-out duration-300" id="dropdownListDesktop" aria-labelledby="dropdownDesktop">
            <!-- Headphones -->
            <li>
              <a class="<%= currentPage === 'Headphones' ? 'bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 font-semibold' : 'text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-orange-600 dark:hover:text-orange-400 font-medium' %> flex items-center gap-x-2 rounded-xl py-2 px-4 block" href="/category/headphones">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"></path>
                </svg>
                <span class="text-sm font-inter">Headphones</span>
              </a>
            </li>
            <!-- Keyboards -->
            <li>
              <a class="<%= currentPage === 'Keyboards' ? 'bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 font-semibold' : 'text-slate-600  dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-orange-600 dark:hover:text-orange-400 font-medium' %> flex items-center gap-x-2 rounded-xl py-2 px-4 block" href="/category/keyboards">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 8h.01"></path>
                  <path d="M12 12h.01"></path>
                  <path d="M14 8h.01"></path>
                  <path d="M16 12h.01"></path>
                  <path d="M18 8h.01"></path>
                  <path d="M6 8h.01"></path>
                  <path d="M7 16h10"></path>
                  <path d="M8 12h.01"></path>
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                </svg>
                <span class="text-sm font-inter">Keyboards</span>
              </a>
            </li>
            <!-- Mice -->
            <li>
              <a class="<%= currentPage === 'Mice' ? 'bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 font-semibold' : 'text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-orange-600 dark:hover:text-orange-400 font-medium' %> flex items-center gap-x-2 rounded-xl py-2 px-4 block" href="/category/mice">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="5" y="2" width="14" height="20" rx="7"></rect>
                  <path d="M12 6v4"></path>
                </svg>
                <span class="text-sm font-inter">Mice</span>
              </a>
            </li>
          </ul>
        </li>
        <!-- Shop -->
        <li>
          <a class="<%= currentPage === 'Shop' ? 'bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 font-semibold' : 'text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-orange-600 dark:hover:text-orange-400 font-medium' %> text-sm font-inter rounded-xl py-2 px-4" href="/shop">
            Shop
          </a>
        </li>
        <!-- About Us -->
        <li>
          <a class="<%= currentPage === 'About' ? 'bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 font-semibold' : 'text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-orange-600 dark:hover:text-orange-400 font-medium' %> text-sm font-inter rounded-xl py-2 px-4" href="/about">
            About Us
          </a>
        </li>
        <!-- Contact -->
        <li>
          <a class="<%= currentPage === 'Contact' ? 'bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 font-semibold' : 'text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-orange-600 dark:hover:text-orange-400 font-medium' %> text-sm font-inter rounded-xl py-2 px-4" href="/contact">
            Contact Us
          </a>
        </li>
      </ul>
      <!-- Center-Right: Search Box -->
      <form class="search-form hidden sm:flex" action="/search" method="GET" role="search" data-search="search" data-suggestions="suggestionsList" aria-label="Site Search">
        <div class="relative">
          <label for="search" class="sr-only">Search</label>
          <div class="relative flex items-center w-xs">
            <svg class="text-slate-400 w-4 h-4 absolute top-[0.60rem] left-[0.90rem] pointer-events-none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m21 21-4.34-4.34" />
              <circle cx="11" cy="11" r="8" />
            </svg>
            <input class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white w-full text-sm font-inter border border-transparent focus:border-orange-500 focus:bg-white dark:focus:bg-slate-900 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400 rounded-xl py-1.5 pl-10 pr-5" id="search" type="search" name="search" value="<%= search || '' %>" autocomplete="off" placeholder="Search TechStore..." />
          </div>
          <!-- Search Suggestions Dropdown -->
          <ul class="bg-white dark:bg-slate-900/95 w-full absolute top-full left-0 border border-slate-200/80 dark:border-slate-800/80 rounded-2xl shadow-xl dark:shadow-2xl z-50 py-3.5 hidden" id="suggestionsList" role="listbox"></ul>
        </div>
      </form>
      <!-- Right: Action Icons & User / Theme -->
      <div class="flex items-center gap-x-2.5 sm:gap-x-1.5">
        <!-- Mobile Search Trigger -->
        <button id="search-btn" aria-label="Search">
          <svg class="text-slate-600 dark:text-slate-300 h-[1.15rem] w-[1.15rem] mt-0.5 sm:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21 21-4.34-4.34" />
            <circle cx="11" cy="11" r="8" />
          </svg>
        </button>
        <!-- Favourites -->
        <a class="<%= currentPage === 'Favourites' ? 'bg-rose-50 dark:bg-rose-950/30' : 'text-slate-600 text-rose-500 dark:text-slate-300 hover:bg-slate-100 hover:text-rose-500 dark:hover:bg-slate-800' %> rounded-xl p-2 hidden sm:block" href="/<%= '@' + user?.username %>/favourites" aria-label="View Favourites">
          <svg class="h-[1.15rem] w-[1.15rem]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </a>
        <!-- Cart -->
        <a class="<%= currentPage === 'Cart' ? 'bg-rose-50 dark:bg-rose-950/30' : 'text-slate-600 text-rose-500 dark:text-slate-300 p-2 rounded-xl hover:bg-slate-100 hover:text-rose-500 dark:hover:bg-slate-800' %> rounded-xl p-2 hidden sm:block" href="/<%= '@' + user?.username %>/cart" aria-label="View Cart">
          <svg class="h-[1.15rem] w-[1.15rem]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m2.05 2.05 1.099-.028a1 1 0 0 1 1.008.815l2.69 14.347A1 1 0 0 0 7.83 18H18" />
            <path d="M4.563 5h16.435a1 1 0 0 1 .981 1.204l-1.026 6.226A2 2 0 0 1 18.962 14H6.25" />
            <circle cx="18" cy="20" r="2" />
            <circle cx="8" cy="20" r="2" />
          </svg>
        </a>
        <!-- Dark / Light Theme Toggle -->
        <button class="bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-xl p-1.75 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer" type="button" id="mode" aria-label="Toggle theme">
          <svg class="h-[1.15rem] w-[1.15rem]" id="moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
          </svg>
          <svg class="h-[1.15rem] w-[1.15rem] hidden" id="sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2" />
            <path d="M12 20v2" />
            <path d="m4.93 4.93 1.41 1.41" />
            <path d="m17.66 17.66 1.41 1.41" />
            <path d="M2 12h2" />
            <path d="M20 12h2" />
            <path d="m6.34 17.66-1.41 1.41" />
            <path d="m19.07 4.93-1.41 1.41" />
          </svg>
        </button>
        <!-- Auth State -->
        <% if (!isLoggedIn) { %>
        <a class="bg-orange-600 text-white rounded-xl shadow-md shadow-orange-500/20 flex items-center gap-x-1.5 py-[0.45rem] px-2.5 sm:ml-1.5 hover:bg-orange-700 active:scale-[0.98] transition ease-out duration-[250ms]" href="/auth/login">
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m10 17 5-5-5-5" />
            <path d="M15 12H3" />
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
          </svg>
          <span class="text-sm font-montserrat font-semibold">
            Login
          </span>
        </a>
        <% } else { %>
        <!-- User Profile Dropdown -->
        <div class="relative flex items-center">
          <button class="bg-orange-600 text-white h-9 w-9 text-sm font-montserrat font-bold rounded-xl shadow-md shadow-orange-500/25 sm:ml-1.5 hover:bg-orange-700 active:scale-95 cursor-pointer transition ease-out duration-250" id="dropdownUser" aria-expanded="false" aria-controls="dropdownListUser">
            <%= user ? user.name[0].toUpperCase() : 'U' %>
          </button>
          <!-- User Dropdown Menu -->
          <ul class="bg-white dark:bg-slate-900 w-50 absolute right-0 top-10 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-xl dark:shadow-2xl space-y-1.5 p-2.5 invisible opacity-0 scale-95 z-50 transition ease-in-out duration-250" id="dropdownListUser" aria-labelledby="dropdownUser">
            <!-- User Info Header -->
            <li class="border-b border-slate-100 dark:border-slate-800/80 py-2 px-3">
              <p class="text-slate-900 dark:text-white text-sm font-montserrat font-bold">
                <%= user?.name %>
              </p>
              <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">
                @<%= user?.username %>
              </p>
            </li>
            <!-- Profile Overview -->
            <li>
              <a class="<%= currentPage === 'Profile Overview' ? 'bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 font-semibold' : 'text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-orange-600 dark:hover:text-orange-400 font-medium' %> flex items-center gap-x-2 rounded-xl py-2 px-4" href="/<%= '@' + user?.username %>/profile-overview">
                <svg class="text-slate-600 dark:text-slate-400 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                  <circle cx="12" cy="7" r="4" />
                </svg>
                <span class="text-sm font-inter">
                  Profile Overview
                </span>
              </a>
            </li>
            <!-- Address Book -->
            <li>
              <a class="<%= currentPage === 'Address Book' ? 'bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 font-semibold' : 'text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-orange-600 dark:hover:text-orange-400 font-medium' %> flex items-center gap-x-2 rounded-xl py-2 px-4" href="/<%= '@' + user?.username %>/address-book">
                <svg class="text-slate-600 dark:text-slate-400 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 5v16" />
                  <path d="M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 004 2 5 5 0 004-2z" />
                </svg>
                <span class="text-sm font-inter">
                  Address Book
                </span>
              </a>
            </li>
            <!-- Security / Privacy -->
            <li>
              <a class="<%= currentPage === 'Security & Privacy' ? 'bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 font-semibold' : 'text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-orange-600 dark:hover:text-orange-400 font-medium' %> flex items-center gap-x-2 rounded-xl py-2 px-4" href="/<%= '@' + user?.username %>/privacy-security">
                <svg class="text-slate-400 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="16" r="1" />
                  <rect x="3" y="10" width="18" height="12" rx="2" />
                  <path d="M7 10V7a5 5 0 0 1 10 0v3" />
                </svg>
                <span class="text-sm font-inter">
                  Security Privacy
                </span>
              </a>
            </li>
            <!-- Logout -->
            <li class="border-t border-slate-100 dark:border-slate-800/80 pt-1.5">
              <button class="logout text-rose-500 w-full flex items-center gap-2 px-4 py-2 hover:bg-rose-50 dark:hover:bg-rose-950/30 rounded-xl cursor-pointer">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m16 17 5-5-5-5" />
                  <path d="M21 12H9" />
                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                </svg>
                <span class="text-sm font-inter font-medium">
                  Logout
                </span>
              </button>
            </li>
          </ul>
        </div>
        <% } %>
      </div>
    </nav>
  </div>
</header>
<!-- SEARCH MOBILE -->
<div class="bg-white dark:bg-slate-900 border-b border-slate-200/80 dark:border-slate-800/80 sticky top-18 z-30 shadow-sm py-4 -translate-y-5 hidden" id="search-mobile">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Search Input -->
    <form class="search-form flex-1" action="/search" method="GET" role="search" data-search="search-moblie" data-suggestions="suggestionsList-moblie" aria-label="Site Search">
      <div class="relative">
        <label for="search-moblie" class="sr-only">Search</label>
        <div class="relative flex items-center gap-x-2.5">
          <svg class="text-slate-400 h-4 w-4 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input class="bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white w-full text-xs sm:text-sm font-inter border border-slate-200 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-900 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400 rounded-xl py-2.5 pl-10 pr-4" type="search" name="search" id="search-moblie" autocomplete="off" placeholder="Search by product name, SKU, or brand..." />
          <button class="bg-slate-100 hover:bg-slate-200 text-slate-700 dark:text-slate-200 text-xs font-montserrat font-bold rounded-xl py-2.5 px-4 cursor-pointer dark:bg-slate-800 dark:hover:bg-slate-700" type="submit">
            Search
          </button>
          <!-- X -->
          <button class="bg-red-50 dark:bg-slate-800 rounded-full shadow cursor-pointer p-1.5" id="close-srch" type="button" aria-label="close-search">
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6 6 18" />
              <path d="m6 6 12 12" />
            </svg>
          </button>
        </div>
        <!-- Search Suggestions Dropdown -->
        <ul class="bg-white dark:bg-slate-900/95 w-full absolute top-full left-0 border border-slate-200/80 dark:border-slate-800/80 rounded-2xl shadow-xl dark:shadow-2xl z-50 py-3.5 hidden" id="suggestionsList-moblie" role="listbox"></ul>
      </div>
    </form>
  </div>
</div>
<!-- ==================== SIDEBAR MOBILE DRAWER ==================== -->
<aside class="bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl w-64 fixed top-[4.50rem] left-0 bottom-0 shadow-2xl border-r border-slate-200/80 dark:border-slate-800/80 p-5 flex flex-col justify-between xl:hidden -translate-x-full overflow-y-auto z-40 transition-transform ease-in-out duration-300" id="navmenu" aria-hidden="true">
  <div class="space-y-4">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3.5">
      <!-- Heading -->
      <h2 class="text-slate-400 text-base font-montserrat font-semibold">Navigation
        Menu</h2>
    </div>
    <!-- Mobile Nav Links -->
    <ul class="space-y-1">
      <!-- Home -->
      <li>
        <a class="<%= currentPage === 'Home' ? 'bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 font-semibold' : 'text-slate-700 dark:text-slate-300 font-medium' %> rounded-xl flex items-center gap-x-2 py-2 px-3.5" href="/">
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" />
            <path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
          </svg>
          <span class="text-sm font-inter">Home</span>
        </a>
      </li>
      <!-- Category Mobile -->
      <li>
        <button class="<%= ['Headphones', 'Keyboards', 'Mice'].includes(currentPage) ? ' bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 font-semibold' : 'text-slate-700 dark:text-slate-300 font-medium' %> w-full rounded-xl cursor-pointer flex items-center justify-between py-2 px-3.5 mb-1" id="dropdownMobile" aria-expanded="false" aria-controls="dropdownListMobile">
          <div class="flex items-center gap-x-2">
