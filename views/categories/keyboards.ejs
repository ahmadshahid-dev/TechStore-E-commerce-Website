<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Keyboards Collection | TechStore</title>
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 antialiased selection:bg-orange-500 selection:text-white">
  <!-- Header -->
  <%- include("../partials/header") %>
  <!-- Main -->
  <main>
    <!-- Page Banner -->
    <section class="relative h-full w-full blur-[0.5px] shadow-2xl select-none overflow-hidden">
      <img class="h-full w-full object-cover" src="/categories/keyboards/keyboard-banner.jpg" alt="Keyboards Banner" />
    </section>
    <!-- Products With Filtration -->
    <section class="border-b border-slate-200 dark:border-slate-800 py-8 sm:py-10 lg:py-12">
      <!-- Container -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Mobile Category Title -->
        <div class="flex flex-col items-center justify-center mb-6 sm:hidden">
          <h2 class="text-slate-900 dark:text-slate-100 text-2xl font-montserrat font-bold leading-none text-center mb-2.5">
            Keyboards
          </h2>
          <span class="bg-orange-600 h-1 w-32 rounded-full"></span>
        </div>
        <!-- Toolbar: Item Count, Title & Filter Dropdown -->
        <div class="flex items-center justify-between gap-4 mb-8">
          <!-- Items Count -->
          <p class="text-slate-600 dark:text-slate-400 text-sm font-inter font-semibold truncate">
            Showing <span class="text-orange-600 dark:text-orange-400 font-bold"><%= keyboards ? keyboards.length : 0 %></span> <%= keyboards.length > 1 ? 'Items' : 'Item' %>
          </p>
          <!-- Desktop Category Title -->
          <h2 class="text-slate-900 dark:text-white text-2xl font-montserrat font-bold hidden sm:block">
            Keyboards <span class="text-orange-600 dark:text-orange-400">Collection</span>
          </h2>
          <!-- Filter Dropdown -->
          <div class="flex items-center gap-2.5 self-end sm:self-auto">
            <label class="text-slate-700 dark:text-slate-300 text-xs font-inter font-bold uppercase tracking-wider" for="filter">
              Filter:
            </label>
            <select class="bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 text-xs font-montserrat font-semibold border border-slate-200 dark:border-slate-800 focus:ring focus:ring-orange-500/20 focus:border-orange-500 outline-none rounded-xl cursor-pointer py-2 px-3" id="filter">
              <option value="" selected>All Keyboards</option>
              <option value="bluetooth">Bluetooth</option>
              <option value="wireless">Wireless</option>
              <option value="wired">Wired</option>
            </select>
          </div>
        </div>
        <!-- Product Grid / Empty State -->
        <% if (keyboards && keyboards.length > 0) { %>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
          <% keyboards.forEach((product) => { %>
          <%- include("../partials/product", { product }) %>
          <% }) %>
        </div>
        <% } else { %>
        <!-- Empty State (Matches Manage Products / Cart Style) -->
        <div class="text-center max-w-xl mx-auto py-2.5">
          <div class="relative w-20 h-20 mx-auto mb-5">
            <div class="bg-orange-500/10 blur-xl absolute inset-0 rounded-full"></div>
            <div class="bg-orange-50 dark:bg-orange-500/10 relative h-20 w-20 text-orange-600 text-3xl dark:text-orange-400 border border-orange-200 dark:border-orange-500/20 rounded-full flex items-center justify-center">
              ⌨️
            </div>
          </div>
          <h3 class="text-slate-900 dark:text-slate-100 text-xl sm:text-2xl font-montserrat font-bold mb-3.5">
            No Keyboards Found
          </h3>
          <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm font-inter leading-relaxed max-w-md mx-auto mb-6">
            We currently don't have keyboards matching your filter criteria. Check back soon for new inventory restocks!
          </p>
          <a class="bg-orange-600 text-white inline-flex items-center gap-2 rounded-xl shadow-md shadow-orange-600/20 py-3.5 px-6 hover:bg-orange-700 active:scale-[0.98] transition ease-out duration-[250ms]" href="/shop">
            <span class="text-xs sm:text-sm font-montserrat font-semibold">Explore All Catalog</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
        <% } %>
      </div>
    </section>
    <!-- Why Choose Our Keyboards -->
    <section class="border-b border-slate-200 dark:border-slate-800 py-8 sm:py-10 lg:py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Heading -->
        <h2 class="text-slate-900 dark:text-slate-100 text-2xl sm:text-3xl font-montserrat font-bold leading-none text-center mb-8 sm:mb-10">
          Why Choose Our <span class="text-orange-600 dark:text-orange-500">Keyboards?</span>
        </h2>
        <!-- Feature Cards Grid -->
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
          <!-- High Quality -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex flex-col items-center justify-center text-center rounded-3xl shadow-sm p-4 sm:p-6 hover:shadow-md hover:border-orange-500/40 dark:hover:border-orange-500/40 group hover:transition hover:ease-in-out hover:duration-300">
            <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-14 w-14 flex items-center justify-center rounded-2xl mb-3 sm:mb-4 group-hover:scale-110 transition-transform">
              <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
              </svg>
            </div>
            <h3 class="text-slate-900 dark:text-slate-100 text-base font-montserrat font-bold">
              High Quality
            </h3>
          </div>
          <!-- Comfort Fit -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex flex-col items-center justify-center text-center rounded-3xl shadow-sm p-4 sm:p-6 hover:shadow-md hover:border-orange-500/40 dark:hover:border-orange-500/40 group hover:transition hover:ease-in-out hover:duration-300">
            <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-14 w-14 flex items-center justify-center rounded-2xl mb-3 sm:mb-4 group-hover:scale-110 transition-transform">
              <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-slate-900 dark:text-slate-100 text-base font-montserrat font-bold">
              Comfort Fit
            </h3>
          </div>
          <!-- Durable Build -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex flex-col items-center justify-center text-center rounded-3xl shadow-sm p-4 sm:p-6 hover:shadow-md hover:border-orange-500/40 dark:hover:border-orange-500/40 group hover:transition hover:ease-in-out hover:duration-300">
            <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-14 w-14 flex items-center justify-center rounded-2xl mb-3 sm:mb-4 group-hover:scale-110 transition-transform">
              <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-slate-900 dark:text-slate-100 text-base font-montserrat font-bold">
              Durable Build
            </h3>
          </div>
          <!-- Stylish Design -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex flex-col items-center justify-center text-center rounded-3xl shadow-sm p-4 sm:p-6 hover:shadow-md hover:border-orange-500/40 dark:hover:border-orange-500/40 group hover:transition hover:ease-in-out hover:duration-300">
            <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-14 w-14 flex items-center justify-center rounded-2xl mb-3 sm:mb-4 group-hover:scale-110 transition-transform">
              <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
            </div>
            <h3 class="text-slate-900 dark:text-slate-100 text-base font-montserrat font-bold">
              Stylish Design
            </h3>
          </div>
        </div>
      </div>
    </section>
  </main>
  <!-- Footer -->
  <%- include("../partials/footer") %>
  <!-- Script -->
  <script src="/js/script.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/user.js"></script>
</body>

</html>