<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password | TechStore</title>
  <!-- StyleSheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100
 min-h-screen flex flex-col antialiased selection:bg-orange-500 selection:text-white">
  <!-- ==================== Header ==================== -->
  <header class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b 
  border-slate-200/80 dark:border-slate-800/80 fixed top-0 left-0 right-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="h-18 flex items-center justify-between">
        <!-- Logo -->
        <a class="text-slate-900 dark:text-white text-xl sm:text-2xl font-montserrat font-extrabold tracking-tight flex" href="/">
          Tech
          <span class="text-orange-600 dark:text-orange-400">Store</span>
        </a>
        <!-- Dark / Light Theme Toggle -->
        <button class="bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-xl p-1.75 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer" type="button" id="mode" aria-label="Toggle theme">
          <svg class="h-[1.15rem] w-[1.15rem]" id="moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
          </svg>
          <svg class="h-[1.15rem] w-[1.15rem] hidden" id="sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2" />
            <path d="M12 20v2" />
            <path d="m4.93 4.93 1.41 1.41" />
            <path d="m17.66 17.66 1.41 1.41" />
            <path d="M2 12h2" />
            <path d="M20 12h2" />
            <path d="m6.34 17.66-1.41 1.41" />
            <path d="m19.07 4.93-1.41 1.41" />
          </svg>
        </button>
      </nav>
    </div>
  </header>
  <!-- ==================== Main ==================== -->
  <main class="flex-1 flex items-center justify-center p-6 lg:p-8">
    <div class="w-full max-w-md">
      <!-- Reset Password Card -->
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800/80 rounded-2xl shadow-xl dark:shadow-2xl overflow-hidden">
        <!-- Card Header -->
        <div class="bg-gradient-to-b from-orange-500/10 via-transparent to-transparent text-center border-b border-slate-100 dark:border-slate-800/60 p-6 lg:p-8">
          <!-- Icon -->
          <div class="bg-orange-600 text-white w-14 h-14 inline-flex items-center justify-center rounded-2xl shadow-lg shadow-orange-500/30 mb-4">
            <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <!-- Title -->
          <h1 class="text-slate-900 dark:text-white text-2xl font-montserrat font-bold leading-none">
            Reset Password
          </h1>
          <p class="text-slate-500 dark:text-slate-400 text-sm font-inter mt-1.5">
            Create a new password to secure your account.
          </p>
        </div>
        <!-- Form Section -->
        <form class="space-y-3.5 p-6 lg:p-8" id="reset-form" data-token="<%= token %>">
          <!-- New Password -->
          <div class="space-y-1.5">
            <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="password">
              New Password
              <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <svg class="text-slate-400 w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:outline-none focus:ring focus:ring-orange-500/20 focus:border-orange-500 rounded-xl pl-11 pr-11 py-2.5" type="password" name="password" id="password" autocomplete="new-password" placeholder="••••••••" required />
              <!-- Show / Hide Password -->
              <button class="password-toggle text-slate-400 absolute right-3.5 top-1/2 -translate-y-1/2 cursor-pointer hover:text-slate-600 dark:hover:text-slate-300" type="button" data-target="password" aria-label="Show password">
                <svg class="eye-off h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                </svg>
                <svg class="eye h-5 w-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </button>
            </div>
            <p class="error text-rose-500 text-xs font-inter" id="error-password"></p>
            <!-- Strength Bars -->
            <div class="space-y-1 pt-1">
              <div class="flex gap-x-1.5">
                <div id="strength-1" class="bg-slate-200 dark:bg-slate-700 h-1 flex-1 rounded-full"></div>
                <div id="strength-2" class="bg-slate-200 dark:bg-slate-700 h-1 flex-1 rounded-full"></div>
                <div id="strength-3" class="bg-slate-200 dark:bg-slate-700 h-1 flex-1 rounded-full"></div>
              </div>
              <div class="text-slate-500 dark:text-slate-400 text-xs font-inter flex items-center justify-between">
                <span>Password strength</span>
                <span id="strength-level" class="text-slate-700 dark:text-slate-300 font-semibold">
                  Weak
                </span>
              </div>
            </div>
          </div>
          <!-- Confirm Password -->
          <div class="space-y-1.5">
            <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="confirmPassword">
              Confirm Password
              <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <svg class="text-slate-400 w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:outline-none focus:ring focus:ring-orange-500/20 focus:border-orange-500 rounded-xl pl-11 pr-4 py-2.5" type="password" name="confirmPassword" id="confirmPassword" autocomplete="new-password" placeholder="••••••••" required />
              <!-- Show / Hide Password -->
              <button class="password-toggle text-slate-400 absolute right-3.5 top-1/2 -translate-y-1/2 cursor-pointer hover:text-slate-600 dark:hover:text-slate-300" type="button" data-target="confirmPassword" aria-label="Show password">
                <svg class="eye-off h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                </svg>
                <svg class="eye h-5 w-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </button>
            </div>
            <p class="error text-rose-500 text-xs font-inter" id="error-confirmPassword"></p>
          </div>
          <!-- Submit Button -->
          <button class="bg-orange-600 text-white w-full flex items-center justify-center gap-x-2 rounded-xl shadow-lg shadow-orange-500/25 active:scale-[0.98] py-3 px-6 hover:bg-orange-700 hover:shadow-orange-500/35 cursor-pointer disabled:cursor-not-allowed disabled:opacity-50 transition ease-out duration-250" type="submit">
            <svg class="Icon h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="Spinner h-4.25 w-4.25 border-[3px] border-orange-100 border-t-orange-500 shrink-0 rounded-full animate-spin drop-shadow-[0_0_4px_rgba(249,115,22,0.6)] hidden"></span>
            <span class="Text text-sm font-montserrat font-semibold">Reset Password</span>
          </button>
        </form>
        <!-- Inside SignIn -->
        <div class="bg-slate-50/80 dark:bg-slate-800/40 border-t border-slate-100 dark:border-slate-800/60 text-center py-4 px-6">
          <p class="text-slate-600 dark:text-slate-400 text-xs font-inter">
            Remember your password?
            <a class="text-orange-600 dark:text-orange-400 font-semibold hover:underline" href="/auth/login">
              Sign in here
            </a>
          </p>
        </div>
      </div>
      <!-- Help / Support Link -->
      <div class="text-slate-500 dark:text-slate-400 text-xs font-inter flex items-center justify-center gap-x-2.5 mt-3 sm:mt-5">
        <span>Having issues?</span>
        <a class="text-orange-600 dark:text-orange-400 font-semibold hover:underline" href="/contact">
          Contact Support
        </a>
      </div>
    </div>
  </main>
  <!-- ==================== Footer ==================== -->
  <footer class="border-t border-slate-200 dark:border-slate-800/80 py-6">
    <p class="text-slate-500 text-xs font-inter text-center">
      © 2026 TechStore. All rights reserved.
    </p>
  </footer>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/auth.js"></script>
</body>

</html>