<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In | TechStore</title>
  <!-- StyleSheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100
min-h-screen flex flex-col antialiased selection:bg-orange-500 selection:text-white">
  <!-- ==================== Header ==================== -->
  <header class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b 
  border-slate-200/80 dark:border-slate-800/80 fixed top-0 left-0 right-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="h-18 flex items-center justify-between">
        <!-- Logo -->
        <a class="text-slate-900 dark:text-white text-xl sm:text-2xl font-montserrat font-extrabold tracking-tight flex" href="/">
          Tech
          <span class="text-orange-600 dark:text-orange-400" href="/">Store</span>
        </a>
        <!-- Dark / Light Theme Toggle -->
        <button class="bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-xl p-1.75 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer" type="button" id="mode" aria-label="Toggle theme">
          <svg class="h-[1.15rem] w-[1.15rem]" id="moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
          </svg>
          <svg class="h-[1.15rem] w-[1.15rem] hidden" id="sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2" />
            <path d="M12 20v2" />
            <path d="m4.93 4.93 1.41 1.41" />
            <path d="m17.66 17.66 1.41 1.41" />
            <path d="M2 12h2" />
            <path d="M20 12h2" />
            <path d="m6.34 17.66-1.41 1.41" />
            <path d="m19.07 4.93-1.41 1.41" />
          </svg>
        </button>
      </nav>
    </div>
  </header>
  <!-- ==================== Main ==================== -->
  <main class="flex-1 flex items-center justify-center p-6 lg:p-8">
    <div class="w-full max-w-md">
      <!-- Login Card -->
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800/80 rounded-2xl shadow-xl dark:shadow-2xl overflow-hidden">
        <!-- Card Header -->
        <div class="bg-gradient-to-b from-orange-500/10 via-transparent to-transparent text-center border-b border-slate-100 dark:border-slate-800/60 p-6 lg:p-8">
          <div class="bg-orange-600 text-white w-14 h-14 inline-flex items-center justify-center rounded-2xl shadow-lg shadow-orange-500/30 mb-4">
            <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h1 class="text-slate-900 dark:text-white text-2xl font-montserrat font-bold leading-none">
            Welcome Back!
          </h1>
          <!-- Description -->
          <p class="text-slate-500 dark:text-slate-400 text-sm font-inter mt-1.5">
            Sign in to your account to continue shopping.
          </p>
        </div>
        <!-- Form -->
        <form class="space-y-3.5 p-6 lg:p-8" id="login-form">
          <!-- E-mail / Username -->
          <div class="space-y-1.5">
            <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="identifier">
              Email or Username
              <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <svg class="text-slate-400 w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:outline-none focus:ring focus:ring-orange-500/20 focus:border-orange-500 rounded-xl pl-11 pr-4 py-2.5" id="identifier" name="identifier" type="text" autocomplete="username" placeholder="john@example.com or johndoe" required />
            </div>
            <p class="error text-rose-500 text-xs font-inter" id="error-identifier"></p>
          </div>
          <!-- Password -->
          <div class="space-y-1.5">
            <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="password">
              Password
              <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <svg class="text-slate-400 w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:outline-none focus:ring focus:ring-orange-500/20 focus:border-orange-500 rounded-xl pl-11 pr-11 py-2.5" id="password" name="password" type="password" autocomplete="current-password" placeholder="••••••••" required />
              <!-- Show / Hide Password -->
              <button class="password-toggle text-slate-400 absolute right-3.5 top-1/2 -translate-y-1/2 cursor-pointer hover:text-slate-600 dark:hover:text-slate-300" type="button" data-target="password" aria-label="Show password">
                <svg class="eye-off h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                </svg>
                <svg class="eye h-5 w-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </button>
            </div>
            <p class="error text-rose-500 text-xs font-inter" id="error-password"></p>
          </div>
          <!-- Remember Me & Forgot Password -->
          <div class="flex items-center justify-between">
            <label class="flex items-center gap-x-2.5 cursor-pointer select-none">
              <input class="text-orange-600 h-4 w-4 border-slate-300 dark:border-slate-700 focus:ring focus:ring-orange-500/20 rounded" id="remember" name="remember" type="checkbox" required />
              <span class="text-slate-600 dark:text-slate-400 text-xs font-inter">
                Remember me
              </span>
            </label>
            <a class="text-orange-600 dark:text-orange-400 text-xs font-inter font-semibold hover:underline" href="/auth/forgot-password">
              Forgot password?
            </a>
          </div>
          <!-- Submit Button -->
          <button class="bg-orange-600 text-white w-full flex items-center justify-center gap-x-2 rounded-xl shadow-lg shadow-orange-500/25 active:scale-[0.98] py-3 px-6 hover:bg-orange-700 hover:shadow-orange-500/35 cursor-pointer disabled:cursor-not-allowed disabled:opacity-50 transition ease-out duration-250" type="submit">
            <svg class="Icon h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
            </svg>
            <span class="Spinner h-4.25 w-4.25 border-[3px] border-orange-100 border-t-orange-500 shrink-0 rounded-full animate-spin drop-shadow-[0_0_4px_rgba(249,115,22,0.6)] hidden"></span>
            <span class="Text text-sm font-montserrat font-semibold">Sign In</span>
          </button>
        </form>
        <!-- Inside Signup -->
        <div class="bg-slate-50/80 dark:bg-slate-800/40 border-t border-slate-100 dark:border-slate-800/60 text-center py-4 px-6">
          <p class="text-slate-600 dark:text-slate-400 text-xs font-inter">
            Don't have an account?
            <a class="text-orange-600 dark:text-orange-400 font-semibold hover:underline" href="/auth/signup">
              Sign up here
            </a>
          </p>
        </div>
      </div>
    </div>
  </main>
  <!-- ==================== 4. TWO-FACTOR OTP MODAL ==================== -->
  <div class="bg-slate-950/60 backdrop-blur-sm items-center justify-center fixed inset-0 z-50 p-4 overflow-y-auto hidden" id="2fOTPModel">
    <div class="bg-white dark:bg-slate-900 relative w-full max-w-md border border-slate-200 dark:border-slate-800 rounded-3xl shadow-2xl space-y-4 p-6 sm:p-8 overflow-hidden transition-transform ease-in-out duration-300">
      <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-4">
        <h3 class="text-slate-900 dark:text-white text-base font-montserrat font-bold">Setup 2-Factor Authentication</h3>
        <button class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 cursor-pointer" type="button" id="2fCloseModel">✕</button>
      </div>
      <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">
        Enter the verification code sent to your email to complete sign-in:
      </p>
      <form class="space-y-2.5" id="2fOTPRecivedFrom">
        <div class="space-y-1.5">
          <label class="text-slate-700 dark:text-slate-300 text-xs font-inter font-semibold block" for="OTPCode">OTP Code<span class="text-red-500">*</span></label>
          <input class="bg-slate-50 dark:bg-slate-800/60 text-slate-900 dark:text-white w-full text-xs font-inter border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring focus:border-orange-500 focus:ring-orange-500 rounded-xl py-2.5 px-3.5 pr-10" id="OTPCode" type="text" maxlength="6" name="OTPCode" placeholder=" Enter Your OTP Code" required>
          <p class="error text-rose-500 text-xs font-inter" id="error-OTPCode"></p>
        </div>
        <button class="bg-orange-600 text-white w-full flex items-center justify-center gap-x-2 rounded-xl shadow-md shadow-orange-500/25 cursor-pointer py-2 px-5 hover:bg-orange-700 active:scale-[0.98] transition-colors ease-out duration-[250ms]" type="submit">
          <span class="Spinner h-3.5 w-3.5 border-[3px] border-orange-100 border-t-orange-500 shrink-0 rounded-full animate-spin drop-shadow-[0_0_4px_rgba(249,115,22,0.6)] hidden"></span>
          <span class="Text text-xs font-montserrat font-semibold">Verify OTP</span>
        </button>
      </form>
    </div>
  </div>
  <!-- ==================== Footer ==================== -->
  <footer class="border-t border-slate-200 dark:border-slate-800/80 py-6">
    <p class="text-slate-500 text-xs font-inter text-center">
      © 2026 TechStore. All rights reserved.
    </p>
  </footer>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/auth.js"></script>
  <script src="/js/user.js"></script>
</body>

</html>