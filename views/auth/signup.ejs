<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign Up | TechStore</title>
  <!-- StyleSheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100
min-h-screen flex flex-col antialiased selection:bg-orange-500 selection:text-white">
  <!-- ==================== Header ==================== -->
  <header class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b 
  border-slate-200/80 dark:border-slate-800/80 fixed top-0 left-0 right-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="h-18 flex items-center justify-between">
        <!-- Logo -->
        <a class="text-slate-900 dark:text-white text-xl sm:text-2xl font-montserrat font-extrabold tracking-tight flex" href="/">
          Tech
          <span class="text-orange-600 dark:text-orange-400">Store</span>
        </a>
        <!-- Dark / Light Theme Toggle -->
        <button class="bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-xl p-1.75 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer" type="button" id="mode" aria-label="Toggle theme">
          <svg class="h-[1.15rem] w-[1.15rem]" id="moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
          </svg>
          <svg class="h-[1.15rem] w-[1.15rem] hidden" id="sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2" />
            <path d="M12 20v2" />
            <path d="m4.93 4.93 1.41 1.41" />
            <path d="m17.66 17.66 1.41 1.41" />
            <path d="M2 12h2" />
            <path d="M20 12h2" />
            <path d="m6.34 17.66-1.41 1.41" />
            <path d="m19.07 4.93-1.41 1.41" />
          </svg>
        </button>
      </nav>
    </div>
  </header>
  <!-- ==================== Main ==================== -->
  <main class="flex-1 flex items-center justify-center p-6 lg:p-8">
    <div class="w-full max-w-md">
      <!-- Signup Card -->
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800/80 rounded-2xl shadow-xl dark:shadow-2xl overflow-hidden">
        <!-- Card Header -->
        <div class="bg-gradient-to-b from-orange-500/10 via-transparent to-transparent text-center border-b border-slate-100 dark:border-slate-800/60 p-6 lg:p-8">
          <!-- Icon -->
          <div class="bg-orange-600 text-white w-14 h-14 inline-flex items-center justify-center rounded-2xl shadow-lg shadow-orange-500/30 mb-4">
            <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
            </svg>
          </div>
          <!-- Title -->
          <h1 class="text-slate-900 dark:text-white text-2xl font-montserrat font-bold leading-none">
            Create an Account
          </h1>
          <!-- Description -->
          <p class="text-slate-500 dark:text-slate-400 text-sm font-inter mt-1.5">
            Join TechStore & enjoy a better shopping experience.
          </p>
        </div>
        <!-- Form -->
        <form class="space-y-3.5 p-6 lg:p-8" id="signup-form">
          <!-- Full Name -->
          <div class="space-y-1.5">
            <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="name">
              Full Name
              <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <svg class="w-5 h-5 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:outline-none focus:ring focus:ring-orange-500/20 focus:border-orange-500 rounded-xl pl-11 pr-4 py-2.5" id="name" name="name" type="text" placeholder="John Doe" autocomplete="name" required />
            </div>
            <p class="error text-rose-500 text-xs font-inter" id="error-name"></p>
          </div>
          <!-- Username -->
          <div class="space-y-1.5">
            <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="username">
              Username
              <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 text-sm font-inter font-semibold pointer-events-none">
                @
              </span>
              <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:outline-none focus:ring focus:ring-orange-500/20 focus:border-orange-500 rounded-xl pl-11 pr-4 py-2.5" id="username" name="username" type="text" placeholder="johndoe" autocomplete="username" required />
            </div>
            <p class="error text-rose-500 text-xs font-inter" id="error-username"></p>
          </div>
          <!-- Email -->
          <div class="space-y-1.5">
            <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="email">
              Email Address
              <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <svg class="w-5 h-5 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:outline-none focus:ring focus:ring-orange-500/20 focus:border-orange-500 rounded-xl pl-11 pr-4 py-2.5" id="email" name="email" type="email" placeholder="john@example.com" autocomplete="email" required />
            </div>
            <p class="error text-rose-500 text-xs font-inter" id="error-email"></p>
          </div>
          <!-- Password -->
          <div class="space-y-1.5">
            <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="password">
              Password
              <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <svg class="w-5 h-5 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:outline-none focus:ring focus:ring-orange-500/20 focus:border-orange-500 rounded-xl pl-11 pr-4 py-2.5" id="password" name="password" type="password" placeholder="••••••••" autocomplete="new-password" required />
              <!-- Show / Hide Password -->
              <button class="password-toggle text-slate-400 absolute right-3.5 top-1/2 -translate-y-1/2 cursor-pointer hover:text-slate-600 dark:hover:text-slate-300" type="button" data-target="password" aria-label="Show password">
                <svg class="eye-off h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                </svg>
                <svg class="eye h-5 w-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </button>
            </div>
            <p class="error text-rose-500 text-xs font-inter" id="error-password"></p>
            <!-- Strength Bars -->
            <div class="space-y-1 pt-1">
              <div class="flex gap-x-1.5">
                <div id="strength-1" class="bg-slate-200 dark:bg-slate-700 h-1 flex-1 rounded-full"></div>
                <div id="strength-2" class="bg-slate-200 dark:bg-slate-700 h-1 flex-1 rounded-full"></div>
                <div id="strength-3" class="bg-slate-200 dark:bg-slate-700 h-1 flex-1 rounded-full"></div>
              </div>
              <div class="text-slate-500 dark:text-slate-400 text-xs font-inter flex items-center justify-between">
                <span>Password strength</span>
                <span id="strength-level" class="text-slate-700 dark:text-slate-300 font-semibold">
                  Weak
                </span>
              </div>
            </div>
          </div>
          <!-- Terms -->
          <div class="space-y-1.5">
            <label class="flex items-start gap-x-2.5 cursor-pointer select-none">
              <input class="text-orange-600 h-4 w-4 border-slate-300 dark:border-slate-700 focus:ring focus:ring-orange-500/20 rounded" id="terms" name="terms" type="checkbox" required />
              <span class="text-slate-600 dark:text-slate-400 text-xs font-inter">
                I agree to the
                <a href="#" class="text-orange-600 dark:text-orange-400 font-semibold hover:underline">
                  Terms of Service
                </a>
                &
                <a href="#" class="text-orange-600 dark:text-orange-400 font-semibold hover:underline">
                  Privacy Policy
                </a>
              </span>
            </label>
            <p class="error text-rose-500 text-xs font-inter" id="error-terms"></p>
          </div>
          <!-- Submit Button -->
          <button class="bg-orange-600 text-white w-full flex items-center justify-center gap-x-2 rounded-xl shadow-lg shadow-orange-500/25 active:scale-[0.98] py-3 px-6 hover:bg-orange-700 hover:shadow-orange-500/35 cursor-pointer disabled:cursor-not-allowed disabled:opacity-50 transition ease-out duration-250" type="submit">
            <span class="Spinner h-4.25 w-4.25 border-[3px] border-orange-100 border-t-orange-500 shrink-0 rounded-full animate-spin drop-shadow-[0_0_4px_rgba(249,115,22,0.6)] hidden"></span>
            <span class="Text text-sm font-montserrat font-semibold">Create Account</span>
          </button>
        </form>
        <!-- Inside Login -->
        <div class="bg-slate-50/80 dark:bg-slate-800/40 border-t border-slate-100 dark:border-slate-800/60 text-center py-4 px-6">
          <p class="text-slate-600 dark:text-slate-400 text-xs font-inter">
            Already have an account?
            <a class="text-orange-600 dark:text-orange-400 font-semibold hover:underline" href="/auth/login">
              Sign in
            </a>
          </p>
        </div>
      </div>
      <!-- Security Notice -->
      <div class="text-slate-500 dark:text-slate-400 flex items-center justify-center gap-x-2.5 mt-3 sm:mt-5">
        <svg class="text-emerald-500 w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        <span class="text-xs font-inter">256-bit SSL encrypted & secure connection</span>
      </div>
    </div>
  </main>
  <!-- ==================== Footer ==================== -->
  <footer class="border-t border-slate-200 dark:border-slate-800/80 py-6">
    <p class="text-slate-500 text-xs font-inter text-center">
      © 2026 TechStore. All rights reserved.
    </p>
  </footer>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/auth.js"></script>
</body>

</html>