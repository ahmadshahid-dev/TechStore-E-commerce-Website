<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password | TechStore</title>
  <!-- StyleSheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 
min-h-screen flex flex-col antialiased selection:bg-orange-500 selection:text-white">
  <!-- ==================== Header ==================== -->
  <header class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b 
border-slate-200/80 dark:border-slate-800/80 fixed top-0 left-0 right-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="h-18 flex items-center justify-between">
        <!-- Logo -->
        <a class="text-slate-900 dark:text-white text-xl sm:text-2xl font-montserrat font-extrabold tracking-tight flex" href="/">
          Tech
          <span class="text-orange-600 dark:text-orange-400" href="/">Store</span>
        </a>
        <!-- Dark / Light Theme Toggle -->
        <button class="bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-xl p-1.75 hover:bg-slate-200 dark:hover:bg-slate-700 cursor-pointer" id="mode" type="button" aria-label="Toggle theme">
          <svg class="h-[1.15rem] w-[1.15rem]" id="moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
          </svg>
          <svg class="h-[1.15rem] w-[1.15rem] hidden" id="sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2" />
            <path d="M12 20v2" />
            <path d="m4.93 4.93 1.41 1.41" />
            <path d="m17.66 17.66 1.41 1.41" />
            <path d="M2 12h2" />
            <path d="M20 12h2" />
            <path d="m6.34 17.66-1.41 1.41" />
            <path d="m19.07 4.93-1.41 1.41" />
          </svg>
        </button>
      </nav>
    </div>
  </header>
  <!-- ==================== Main ==================== -->
  <main class="flex-1 flex items-center justify-center p-6 lg:p-8">
    <div class="w-full max-w-md">
      <!-- Forgot Password Card -->
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800/80 rounded-2xl shadow-xl dark:shadow-2xl overflow-hidden">
        <!-- Card Header -->
        <div class="bg-gradient-to-b from-orange-500/10 via-transparent to-transparent text-center border-b border-slate-100 dark:border-slate-800/60 p-6 lg:8">
          <!-- Icon -->
          <div class="bg-orange-600 text-white w-14 h-14 inline-flex items-center justify-center rounded-2xl shadow-lg shadow-orange-500/30 mb-4">
            <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
          </div>
          <!-- Title -->
          <h1 class="text-slate-900 dark:text-white text-2xl font-montserrat font-bold leading-none">
            Forgot Password?
          </h1>
          <p class="text-slate-500 dark:text-slate-400 text-sm font-inter mt-1.5">
            Enter your email and we'll send you a password reset link.
          </p>
        </div>
        <!-- Form -->
        <form class="space-y-3.5 p-6 lg:8" id="forgot-form">
          <!-- Email -->
          <div class="space-y-1.5">
            <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="email">
              Email Address
              <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <svg class="text-slate-400 w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:outline-none focus:ring focus:ring-orange-500/20 focus:border-orange-500 rounded-xl pl-11 pr-4 py-2.5" type="email" name="email" id="email" autocomplete="email" placeholder="john@example.com" required />
            </div>
            <p class="text-rose-500 text-xs font-inter" id="error-email"></p>
          </div>
          <!-- Submit Button -->
          <button class="bg-orange-600 text-white w-full flex items-center justify-center gap-x-2 rounded-xl shadow-lg shadow-orange-500/25 active:scale-[0.98] py-3 px-6 hover:bg-orange-700 hover:shadow-orange-500/35 cursor-pointer disabled:cursor-not-allowed disabled:opacity-50 transition ease-out duration-250" type="submit">
            <svg class="Icon h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class="Spinner h-4.25 w-4.25 border-[3px] border-orange-100 border-t-orange-500 shrink-0 rounded-full animate-spin drop-shadow-[0_0_4px_rgba(249,115,22,0.6)] hidden"></span>
            <span class="Text text-sm font-montserrat font-semibold">Send Recovery Email</span>
          </button>
          <!-- Info Note -->
          <div class="bg-slate-50 dark:bg-slate-800/50 border border-slate-200/80 dark:border-slate-700/60 flex items-start gap-x-2.5 rounded-xl p-3.5">
            <svg class="text-orange-600 dark:text-orange-400 w-4 h-4 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p class="text-slate-600 dark:text-slate-400 text-xs font-inter leading-relaxed">
              Check your inbox & spam folder for the link. It will expire in 24 hours.
            </p>
          </div>
        </form>
        <!-- Inside SignUp/SignIn -->
        <div class="bg-slate-50/80 dark:bg-slate-800/40 border-t border-slate-100 dark:border-slate-800/60 text-center space-y-1.5 py-4 px-6">
          <a class="text-orange-600 dark:text-orange-400 inline-flex items-center gap-x-1.5 hover:underline group" href="/auth/login">
            <svg class="h-3.5 w-3.5 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span class="text-xs font-inter font-semibold">Back to Sign In</span>
          </a>
          <p class="text-slate-600 dark:text-slate-400 text-xs font-inter">
            Don't have an account?
            <a class="text-orange-600 dark:text-orange-400 font-semibold hover:underline" href="/auth/signup">
              Sign up
            </a>
          </p>
        </div>
      </div>
      <!-- Security / Help Notice -->
      <div class="text-slate-500 dark:text-slate-400 text-xs font-inter flex items-center justify-center gap-x-2.5 mt-3 sm:mt-5">
        <span>Having trouble?</span>
        <a class="text-orange-600 dark:text-orange-400 font-semibold hover:underline" href="/contact">
          Contact Support
        </a>
      </div>
    </div>
  </main>
  <!-- ==================== Footer ==================== -->
  <footer class="border-t border-slate-200 dark:border-slate-800/80 py-6">
    <p class="text-slate-500 text-xs font-inter text-center">
      © 2026 TechStore. All rights reserved.
    </p>
  </footer>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/auth.js"></script>
</body>

</html>