<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard | TechStore</title>
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased selection:bg-orange-500 selection:text-white">
  <!-- Header -->
  <%- include("../partials/header") %>
  <!-- Main -->
  <main>
    <!-- ==================== 1. ADMIN HERO / GREETING BANNER ==================== -->
    <section class="bg-white/60 dark:bg-slate-900/60 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 py-8 sm:py-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <!-- Title & Greeting -->
          <div class="space-y-1.5">
            <div class="flex items-center gap-x-2.5">
              <span class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 text-xs font-montserrat font-bold uppercase tracking-wider border border-orange-200 dark:border-orange-900/50 rounded-md py-0.5 px-2.5">
                Admin Panel
              </span>
              <span class="text-slate-400 text-xs font-inter flex items-center gap-1.5">
                <span class="bg-emerald-500 h-2 w-2 rounded-full animate-pulse"></span>
                <span>System Online</span>
              </span>
            </div>
            <h1 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-extrabold leading-none tracking-tight mb-2.5">
              Store
              <span class="text-orange-600 dark:text-orange-400">Dashboard</span>
            </h1>
            <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm font-inter">
              Welcome back, Admin! Here is your real-time store performance
              overview.
            </p>
          </div>
          <!-- Quick Live Store Link -->
          <div class="flex items-center gap-x-2.5">
            <a class="bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 flex items-center gap-x-2.5 rounded-xl shadow-sm
            py-2.5 px-4 hover:bg-slate-50 dark:hover:bg-slate-700 hover:transition-colors" href="/" target="_blank">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              <span class="text-xs font-montserrat font-semibold">View Live Store</span>
            </a>
          </div>
        </div>
      </div>
    </section>
    <!-- ==================== 2. KPI / STATS SECTION ==================== -->
    <section class="border-b border-slate-200/80 dark:border-slate-800/80 py-8 sm:py-10 lg:py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
          <!-- Stat 1: Total Revenue -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm space-y-4 p-6 hover:shadow-md transition-shadow ease-in-out duration-300">
            <div class="flex items-start justify-between">
              <div>
                <p class="text-slate-500 dark:text-slate-400 text-xs font-inter font-semibold uppercase tracking-wider">
                  Total Revenue
                </p>
                <h3 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-extrabold mt-1">
                  Rs <%= totalRevenue.toLocaleString() %>
                </h3>
              </div>
              <div class="bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 h-11 w-11 flex items-center justify-center rounded-xl">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
            </div>
            <div class="flex items-center gap-x-2.5 pt-1">
              <span class="bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 text-[0.6875rem] font-inter font-bold py-0.5 px-2 rounded-md">
                +5%
              </span>
              <span class="text-slate-400 text-xs font-inter">vs last month</span>
            </div>
          </div>
          <!-- Stat 2: Total Orders -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm space-y-4 p-6 hover:shadow-md transition-shadow ease-in-out duration-300">
            <div class="flex items-start justify-between">
              <div>
                <p class="text-slate-500 dark:text-slate-400 text-xs font-inter font-semibold uppercase tracking-wider">
                  Total Orders
                </p>
                <h3 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-extrabold mt-1">
                  <%= totalOrders %>
                </h3>
              </div>
              <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 h-11 w-11 flex items-center justify-center rounded-xl">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
              </div>
            </div>
            <div class="flex items-center gap-x-2.5 pt-1">
              <span class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 text-[0.6875rem] font-inter font-bold py-0.5 px-2 rounded-md">
                <%= totalOrders / 1000 * 100 %>
              </span>
              <span class="text-slate-400 text-xs font-inter">fulfilled orders</span>
            </div>
          </div>
          <!-- Stat 3: Active Products -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm space-y-4 p-6 hover:shadow-md transition-shadow ease-in-out duration-300">
            <div class="flex items-start justify-between">
              <div>
                <p class="text-slate-500 dark:text-slate-400 text-xs font-inter font-semibold uppercase tracking-wider">
                  Active Products
                </p>
                <h3 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-extrabold mt-1">
                  <%= totalProducts %>
                </h3>
              </div>
              <div class="bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 h-11 w-11 flex items-center justify-center rounded-xl">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
              </div>
            </div>
            <div class="flex items-center gap-x-2.5 pt-1">
              <span class="bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 text-[0.6875rem] font-inter font-bold py-0.5 px-2 rounded-md">
                Live
              </span>
              <span class="text-slate-400 text-xs font-inter">in catalog</span>
            </div>
          </div>
          <!-- Stat 4: Total Users -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm space-y-4 p-6 hover:shadow-md transition-shadow ease-in-out duration-300">
            <div class="flex items-start justify-between">
              <div>
                <p class="text-slate-500 dark:text-slate-400 text-xs font-inter font-semibold uppercase tracking-wider">
                  Registered Users
                </p>
                <h3 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-extrabold mt-1">
                  <%= totalUsers %>
                </h3>
              </div>
              <div class="bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 h-11 w-11 flex items-center justify-center rounded-xl">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
              </div>
            </div>
            <div class="flex items-center gap-x-2.5 pt-1">
              <span class="bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 text-[0.6875rem] font-inter font-bold py-0.5 px-2 rounded-md">
                <%= totalUsers / 1000 * 100 %>
              </span>
              <span class="text-slate-400 text-xs font-inter">active customers</span>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- ==================== 3. PRIMARY MANAGEMENT MODULES ==================== -->
    <section class="border-b border-slate-200/80 dark:border-slate-800/80 py-8 sm:py-10 lg:py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8 sm:mb-10">
          <span class="text-orange-600 dark:text-orange-400 text-xs font-montserrat font-bold uppercase tracking-wider">
            Core Operations
          </span>
          <h2 class="text-slate-900 dark:text-white text-xl sm:text-2xl font-montserrat font-bold leading-none mt-1.5">
            Management Hub
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
          <!-- Module 1: Product Management -->
          <a class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm hover:shadow-xl hover:border-orange-500/50 dark:hover:border-orange-500/75 flex flex-col justify-between space-y-6 group p-6 sm:p-7 hover:transition hover:ease-in-out hover:duration-300" href="/admin/manage-products">
            <div class="space-y-4">
              <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 h-12 w-12 flex items-center justify-center rounded-xl group-hover:scale-110 transition-transform">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
              </div>
              <div>
                <h3 class="text-slate-900 dark:text-white text-lg font-montserrat font-bold group-hover:text-orange-600 dark:group-hover:text-orange-400">
                  Product Management
                </h3>
                <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm font-inter leading-relaxed mt-1">
                  Add new inventory, adjust pricing, manage categories, and
                  edit stock levels.
                </p>
              </div>
            </div>
            <div class="text-orange-600 dark:text-orange-400 flex items-center gap-2 border-t border-slate-100 dark:border-slate-800/80 pt-2">
              <span class="text-xs font-montserrat font-bold">Manage Products</span>
              <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </a>
          <!-- Module 2: Order Management -->
          <a class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm hover:shadow-xl hover:border-orange-500/50 flex flex-col justify-between space-y-6 group p-6 sm:p-7 hover:transition hover:ease-in-out hover:duration-300" href="/admin/manage-orders">
            <div class="space-y-4">
              <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 h-12 w-12 flex items-center justify-center rounded-xl group-hover:scale-110 transition-transform">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                </svg>
              </div>
              <div>
                <h3 class="text-slate-900 dark:text-white text-lg font-montserrat font-bold group-hover:text-orange-600 dark:group-hover:text-orange-400">
                  Order Management
                </h3>
                <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm font-inter leading-relaxed mt-1">
                  Review incoming purchases, update tracking statuses, and
                  process refunds.
                </p>
              </div>
            </div>
            <div class="text-orange-600 dark:text-orange-400 border-t border-slate-100 dark:border-slate-800/80 flex items-center gap-2 pt-2">
              <span class="text-xs font-montserrat font-bold">Manage Orders</span>
              <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </a>
          <!-- Module 3: User Management -->
          <a class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm hover:shadow-xl hover:border-orange-500/50 dark:hover:border-orange-500/75 flex flex-col justify-between space-y-6 group p-6 sm:p-7 hover:transition hover:ease-in-out hover:duration-300" href="/admin/manage-users">
            <div class="space-y-4">
              <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 h-12 w-12 flex items-center justify-center rounded-xl group-hover:scale-110 transition-transform">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-slate-900 dark:text-white text-lg font-montserrat font-bold group-hover:text-orange-600 dark:group-hover:text-orange-400">
                  User Management
                </h3>
                <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm font-inter leading-relaxed mt-1">
                  Oversee customer accounts, monitor activity, and manage
                  administrative privileges.
                </p>
              </div>
            </div>
            <div class="text-orange-600 dark:text-orange-400 border-t border-slate-100 dark:border-slate-800/80 flex items-center gap-2 pt-2">
              <span class="text-xs font-montserrat font-bold">Manage Users</span>
              <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </a>
        </div>
      </div>
    </section>
    <!-- NEW USERS AND ORDERS -->
    <section class="backdrop-blur-md py-8 sm:py-10 lg:py-12 border-none overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
          <% function timeAgo(date) {
           const seconds = Math.floor((Date.now() - new Date(date)) / 1000);
           if (seconds < 60) return "Just now";
           const minutes = Math.floor(seconds / 60);
           if (minutes < 60) return `${minutes} min${minutes > 1 ? "s" : ""} ago`;
           const hours = Math.floor(minutes / 60);
           if (hours < 24) return `${hours} hour${hours > 1 ? "s" : ""} ago`;
           const days = Math.floor(hours / 24);
           return `${days} day${days > 1 ? "s" : ""} ago`;
           } %>
          <!-- Latest Orders  -->
          <div class="bg-white dark:bg-slate-900 border text-slate-800 dark:text-slate-200  border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm p-6 hover:shadow-md dark:shadow-xl transition-shadow ease-in-out duration-300">
            <div class="flex items-center justify-between mb-5">
              <div class="flex items-center gap-x-2.5">
                <span class="bg-orange-50 dark:bg-orange-950/35 text-orange-600 dark:text-orange-400 h-10 w-10 flex items-center justify-center rounded-full">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 7h12l1 13H5L6 7zM9 7V5a3 3 0 016 0v2" />
                  </svg>
                </span>
                <h3 class="text-slate-900 dark:text-slate-100 text-lg font-montserrat font-bold leading-none">Latest <span class="text-orange-600 dark:text-orange-400">Orders</span></h3>
              </div>
              <a href="/admin/orders" class="text-slate-600 dark:text-slate-300 text-sm font-inter  hover:text-orange-600 dark:hover:text-orange-400 hover:underline">View all</a>
            </div>
            <% if (orders && orders.length) { %>
            <div class="divide-slate-200 dark:divide-slate-800 divide-y">
              <% orders.forEach(order => { %>
              <div class="flex items-center gap-x-3 py-2.5 first:pt-0 last:pb-0">
                <span class="bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-slate-200 h-9 w-9 flex items-center justify-center shrink-0 text-sm font-inter font-semibold rounded-full">
                  <%= order.address.fullName.charAt(0).toUpperCase() %>
                </span>
                <div class="min-w-0 flex-1 space-y-1">
                  <p class="text-slate-900 dark:text-slate-100 text-[0.9375rem] font-inter font-medium leading-none truncate"><%= order.address.fullName %></p>
                  <p class="text-slate-500 text-xs font-inter font-inter shrink-0"><%= order.orderId %> · <%= timeAgo(order.createdAt) %>
                  </p>
                </div>
                <div class="flex items-center gap-x-3.5 shrink-0">
                  <span class="text-green-600 dark:text-green-400 text-base font-inter font-semibold leading-none">Rs. <%= order.grandTotal.toLocaleString() %></span>
                  <span class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 text-[0.6250rem] font-montserrat font-semibold border border-orange-200/50 rounded-md py-0.5 px-2">
                    <%= order.orderStatus %>
                  </span>
                </div>
                </a>
                <% }) %>
              </div>
              <% } else { %>
              <p class="text-slate-900 dark:text-slate-100 text-base font-montserrat font-semibold text-center my-5">No orders yet.</p>
              <% } %>
            </div>
            <!-- Latest Users -->
            <div class="bg-white dark:bg-slate-900 border text-slate-800 dark:text-slate-200  border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm p-6 hover:shadow-md dark:shadow-xl transition-shadow ease-in-out duration-300">
              <div class="flex items-center justify-between mb-5">
                <div class="flex items-center gap-2.5">
                  <span class="bg-orange-50 dark:bg-orange-950/35 text-orange-600 dark:text-orange-400 h-10 w-10 flex items-center justify-center rounded-full">
                    <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 12a4 4 0 100-8 4 4 0 000 8zM4 20c0-3.3 3.6-6 8-6s8 2.7 8 6" />
                    </svg>
                  </span>
                  <h3 class="text-slate-900 dark:text-slate-100 text-lg font-montserrat font-bold leading-none">Latest <span class="text-orange-600 dark:text-orange-400">Users</span></h3>
                </div>
                <a href="/admin/users" class="text-slate-600 dark:text-slate-300 text-sm font-inter  hover:text-orange-600 dark:hover:text-orange-400 hover:underline">View all</a>
              </div>
              <% if (users && users.length > 0) { %>
              <div class="divide-slate-200 dark:divide-slate-800 divide-y">
                <% users.forEach(user => { %>
                <div class="flex items-center gap-x-3 py-2.5 first:pt-0 last:pb-0">
                  <span class="bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-slate-200 h-9 w-9 flex items-center justify-center shrink-0 text-sm font-inter font-semibold rounded-full">
                    <%= user.name.charAt(0).toUpperCase() %>
                  </span>
                  <div class="min-w-0 flex-1 space-y-0.5">
                    <p class="text-slate-900 dark:text-slate-100 text-[0.9375rem] font-inter font-medium leading-none truncate"><%= user.name %></p>
                    <p class="text-gray-600 dark:text-slate-400 text-sm font-inter truncate"><%= user.email %></p>
                  </div>
                  <span class="text-slate-400 text-xs font-inter shrink-0"><%= timeAgo(user.createdAt) %></span>
                </div>
                <% }) %>
              </div>
              <% } else { %>
              <p class="text-slate-900 dark:text-slate-100 text-base font-montserrat font-semibold text-center my-5">No users yet.</p>
              <% } %>
            </div>
          </div>
        </div>
    </section>
  </main>
  <!-- Footer -->
  <%- include("../partials/footer") %>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/admin.js"></script>
</body>

</html>