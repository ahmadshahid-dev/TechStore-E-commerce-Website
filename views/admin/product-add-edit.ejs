<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= editing ? 'Edit Product' : 'Add New Product' %> | TechStore Admin</title>
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased selection:bg-orange-500 selection:text-white">
  <!-- Header -->
  <%- include("../partials/header") %>
  <!-- Main  -->
  <main>
    <!-- ==================== 1. PAGE HEADER ==================== -->
    <section class="bg-white/60 dark:bg-slate-900/60 border-b border-slate-200/80 
    dark:border-slate-800/80 backdrop-blur-md py-8 sm:py-10">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <!-- Title & Breadcrumbs -->
          <div class="space-y-1.5">
            <div class="text-slate-500 dark:text-slate-400 text-xs font-inter flex items-center gap-2">
              <a class="hover:text-orange-600 dark:hover:text-orange-400" href="/admin/dashboard">Dashboard</a>
              <span>/</span>
              <a class="hover:text-orange-600 dark:hover:text-orange-400" href="/admin/manage-products">Inventory</a>
              <span>/</span>
              <span class="text-slate-800 dark:text-slate-200 font-semibold"><%= editing ? 'Edit' : 'Add' %></span>
            </div>
            <h1 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-extrabold leading-none tracking-tight mb-2.5">
              <%= editing ? 'Edit' : 'Add New' %> <span class="text-orange-600 dark:text-orange-400">Product</span>
            </h1>
            <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm font-inter">
              <%= editing ? 'Update product specifications, images, and pricing details.' : 'Fill in the information below to add a new item to the store catalog.' %>
            </p>
          </div>
          <!-- Back Button -->
          <a href="/admin/manage-products" class="bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 w-fit inline-flex items-center gap-2 border border-slate-200 dark:border-slate-700 rounded-xl shadow-sm py-2.5 px-4 hover:bg-slate-50 dark:hover:bg-slate-700">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            <span class="text-xs font-montserrat font-semibold">Back to Products</span>
          </a>
        </div>
      </div>
    </section>
    <!-- ==================== 2. PRODUCT FORM ==================== -->
    <section class="backdrop-blur-md py-8 sm:py-10 lg:py-12 overflow-hidden">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <form class="space-y-8" id="<%= editing ? 'prdctEditForm' : 'prdctAddForm' %>" enctype="multipart/form-data">
          <!-- Hidden ID Field -->
          <input type="hidden" name="_id" id="id" value="<%= editing ? product._id : '' %>">
          <!-- 1. Media Upload Section -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 rounded-2xl shadow-sm space-y-6 p-6 lg:p-8">
            <div class="space-y-1.5">
              <h2 class="text-slate-900 dark:text-white text-lg font-montserrat font-bold leading-none">Product Media</h2>
              <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">Upload high-resolution images on a clean or transparent background.</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <!-- Catalog Thumbnail Image -->
              <div class="space-y-1.5">
                <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="image">
                  Catalog Thumbnail Image <span class="text-rose-500">*</span>
                </label>
                <div class="relative group">
                  <input class="h-full w-full absolute inset-0 opacity-0 cursor-pointer z-10" type="file" name="image" id="image" accept=".png,.jpg,.jpeg,.webp" <%= editing ? '' : 'required' %> />
                  <div class="bg-slate-50/50 dark:bg-slate-800/30 flex flex-col items-center justify-center text-center border-2 border-dashed border-slate-300 dark:border-slate-700 rounded-2xl p-6 group-hover:bg-orange-50/20 dark:group-hover:bg-orange-950/20 group-hover:border-orange-500 dark:group-hover:border-orange-500">
                    <svg class=" text-slate-400 w-8 h-8 group-hover:text-orange-500 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span class="text-slate-700 dark:text-slate-300 text-xs font-montserrat font-bold">Choose Thumbnail</span>
                    <span class="text-slate-400 text-[0.6875rem] font-inter mt-0.5">PNG, JPG, WEBP (Max 5MB)</span>
                  </div>
                </div>
                <!-- Preview Box -->
                <div class="bg-slate-50 dark:bg-slate-800/40 h-35 w-full flex items-center justify-center border border-slate-200 dark:border-slate-800 rounded-xl p-3 overflow-hidden">
                  <% if(editing && product.image) { %>
                  <img class="max-h-full max-w-full object-contain" id="imagePreview" src="<%= product.image %>" alt="Thumbnail Preview" />
                  <% } else { %>
                  <div class="text-slate-400 flex items-center gap-1.5" id="imgPreviewEmpty">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    <span class="text-xs font-inter">Thumbnail preview will appear here</span>
                  </div>
                  <img class="max-h-full max-w-full object-contain hidden" id="imagePreview" src="" alt="Thumbnail Preview" />
                  <% } %>
                </div>
                <p class="error text-rose-500 text-xs font-inter" id="error-image"></p>
              </div>
              <!-- Product Detail Page (PDP) Image -->
              <div class="space-y-1.5">
                <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="pdpImage">
                  Product Details Page Image <span class="text-rose-500">*</span>
                </label>
                <div class="relative group">
                  <input class="h-full w-full absolute inset-0 opacity-0 cursor-pointer z-10" type="file" name="pdpImage" id="pdpImage" accept=".png,.jpg,.jpeg,.webp" <%= editing ? '' : 'required' %> />
                  <div class="bg-slate-50/50 dark:bg-slate-800/30 flex flex-col items-center justify-center text-center border-2 border-dashed border-slate-300 dark:border-slate-700 rounded-2xl p-6 group-hover:bg-orange-50/20 dark:group-hover:bg-orange-950/20 group-hover:border-orange-500 dark:group-hover:border-orange-500">
                    <svg class="text-slate-400 h-8 w-8 group-hover:text-orange-500 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span class="text-slate-700 dark:text-slate-300 text-xs font-montserrat font-bold">Choose PDP Image</span>
                    <span class="text-slate-400 text-[0.6875rem] font-inter mt-0.5">High Res (Max 5MB)</span>
                  </div>
                </div>
                <!-- Preview Box -->
                <div class="bg-slate-50 dark:bg-slate-800/40 h-35 w-full flex items-center justify-center border border-slate-200 dark:border-slate-800 rounded-xl p-3 overflow-hidden">
                  <% if(editing && product.pdpImage) { %>
                  <img class="max-h-full max-w-full object-contain" id="pdpImagePreview" src="<%= product.pdpImage %>" alt="PDP Preview" />
                  <% } else { %>
                  <div class="text-slate-400 flex items-center gap-1.5" id="pdpPreviewEmpty">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    <span class="text-xs font-inter">Detail image preview will appear here</span>
                  </div>
                  <img class="max-h-full max-w-full object-contain hidden" id="pdpImagePreview" src="" alt="Pdp Thumbnail Preview" />
                  <% } %>
                </div>
                <p class="error text-rose-500 text-xs font-inter" id="error-pdpImage"></p>
              </div>
            </div>
          </div>
          <!-- 2. General Information Section -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 rounded-2xl shadow-sm space-y-6 p-6 lg:p-8">
            <div class="space-y-1.5">
              <h2 class="text-slate-900 dark:text-white text-lg font-montserrat font-bold leading-none">General Information</h2>
              <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">Specify basic product identity, category, and inventory parameters.</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <!-- Name -->
              <div class="space-y-1.5 sm:col-span-2">
                <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="name">
                  Product Name <span class="text-rose-500">*</span>
                </label>
                <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400 rounded-xl py-2.5 px-4" type="text" name="name" id="name" value="<%= editing ? product.name : '' %>" autocomplete="name" placeholder="e.g. Pro Wireless Mechanical Gaming Keyboard" required />
                <p class="error text-rose-500 text-xs font-inter" id="error-name"></p>
              </div>
              <!-- SKU -->
              <div class="space-y-1.5">
                <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="sku">
                  SKU (Stock Keeping Unit) <span class="text-rose-500">*</span>
                </label>
                <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter uppercase border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400 rounded-xl py-2.5 px-4" type="text" name="sku" id="sku" value="<%= editing ? product.sku : '' %>" placeholder="KB-PRO-001" required />
                <p class="error text-rose-500 text-xs font-inter" id="error-sku"></p>
              </div>
              <!-- Category Dropdown / Input -->
              <div class="space-y-1.5">
                <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="category">
                  Category <span class="text-rose-500">*</span>
                </label>
                <select class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400 rounded-xl cursor-pointer py-2.5 px-4" name="category" id="category" required>
                  <option value="" disabled <%= !editing ? 'selected' : '' %>>Select a category</option>
                  <option value="headphones" <%= editing && product.category === 'headphones' ? 'selected' : '' %>>🎧 Headphones</option>
                  <option value="keyboards" <%= editing && product.category === 'keyboards' ? 'selected' : '' %>>⌨ Keyboards</option>
                  <option value="mice" <%= editing && product.category === 'mice' ? 'selected' : '' %>>🖱️ Gaming Mice</option>
                </select>
                <p class="error text-rose-500 text-xs font-inter" id="error-category"></p>
              </div>
              <!-- Color -->
              <div class="space-y-1.5">
                <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="color">
                  Color / Variant <span class="text-rose-500">*</span>
                </label>
                <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400 rounded-xl py-2.5 px-4" type="text" name="color" id="color" value="<%= editing ? product.color : '' %>" placeholder="e.g. Matte Black, White RGB" required />
                <p class="error text-rose-500 text-xs font-inter" id="error-color"></p>
              </div>
              <!-- Promotional Tag -->
              <div class="space-y-1.5">
                <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="tag">
                  Promotional Tag <span class="text-rose-500">*</span>
                </label>
                <select class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400 rounded-xl cursor-pointer py-2.5 px-4" name="tag" id="tag" required>
                  <option value="" disabled <%= !editing ? 'selected' : '' %>>Choose promotional badge</option>
                  <option value="Deal" <%= editing && product.tag === 'Deal' ? 'selected' : '' %>>🔥 Deal (Discount Highlight)</option>
                  <option value="New" <%= editing && product.tag === 'New' ? 'selected' : '' %>>✨ New (Latest Arrival)</option>
                  <option value="Best-Sell" <%= editing && product.tag === 'Best-Sell' ? 'selected' : '' %>>⭐ Best Seller (Top Trending)</option>
                  <option value="Non" <%= editing && product.Non === 'Non' ? 'selected' : '' %>>❌️ Non (No Promotion Item)</option>
                </select>
                <p class="error text-rose-500 text-xs font-inter" id="error-tag"></p>
              </div>
              <!-- Stock Quantity -->
              <div class="space-y-1.5 sm:col-span-2">
                <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="stockQuantity">
                  Initial Stock Quantity <span class="text-rose-500">*</span>
                </label>
                <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400 rounded-xl py-2.5 px-4" type="number" name="stockQuantity" id="stockQuantity" value="<%= editing ? product.stockQuantity : '' %>" placeholder="e.g. 50" min="0" max="100" required />
                <p class="error text-rose-500 text-xs font-inter" id="error-stockQuantity"></p>
              </div>
            </div>
          </div>
          <!-- 3. Pricing & Discount Calculation Section -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 rounded-2xl shadow-sm space-y-6 p-6 lg:p-8">
            <div class="space-y-1.5">
              <h2 class="text-slate-900 dark:text-white text-lg font-montserrat font-bold leading-none">Pricing & Discount</h2>
              <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">Set retail prices and applicable customer savings.</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <!-- Original Price -->
              <div class="space-y-1.5">
                <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="originalPrice">
                  Original Price (Rs) <span class="text-rose-500">*</span>
                </label>
                <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400 rounded-xl py-2.5 px-4" type="number" name="originalPrice" id="originalPrice" value="<%= editing ? product.originalPrice : '' %>" placeholder="e.g. 8000" min="0" step="0.01" required />
                <p class="error text-rose-500 text-xs font-inter" id="error-originalPrice"></p>
              </div>
              <!-- Current Price (Sale Price) -->
              <div class="space-y-1.5">
                <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="currentPrice">
                  Sale Price (Rs) <span class="text-rose-500">*</span>
                </label>
                <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400 rounded-xl py-2.5 px-4" type="number" name="currentPrice" id="currentPrice" value="<%= editing ? product.currentPrice : '' %>" placeholder="e.g. 6400" min="0" step="0.01" required />
                <p class="error text-rose-500 text-xs font-inter" id="error-currentPrice"></p>
              </div>
            </div>
            <!-- Savings Preview Note -->
            <div class="bg-emerald-50/80 dark:bg-emerald-950/30 flex items-center gap-2 border border-emerald-200 dark:border-emerald-900/50 rounded-xl p-3.5">
              <span class="text-emerald-600 dark:text-emerald-400 text-sm">💡</span>
              <p class="text-emerald-800 dark:text-emerald-300 text-xs font-inter">
                <strong>Customer Incentive:</strong> Buyers will see a discount badge with strikethrough original pricing.
              </p>
            </div>
          </div>
          <!-- 4. Detailed Description Section -->
          <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-sm p-6 sm:p-8 space-y-4">
            <div class="space-y-1.5">
              <h2 class="text-slate-900 dark:text-white text-lg font-montserrat font-bold leading-none">Product Description</h2>
              <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">Provide detailed specifications, features, and package contents.</p>
            </div>
            <div class="space-y-1.5">
              <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="description">
                Full Description <span class="text-rose-500">*</span>
              </label>
              <textarea class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400 rounded-xl p-4 resize-none" name="description" id="description" rows="6" placeholder="Write key features, battery life, connectivity, box contents..." required><%= editing ? product.description : '' %></textarea>
              <p class="error text-rose-500 text-xs font-inter" id="error-description"></p>
            </div>
          </div>
          <!-- 5. Publication Status (Editing Only) -->
          <% if(editing) { %>
          <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 shadow-sm p-6 sm:p-8 space-y-4">
            <div class="space-y-1.5">
              <h2 class="text-slate-900 dark:text-white text-lg font-montserrat font-bold leading-none">Catalog Visibility</h2>
              <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">Control whether this product is visible to public shoppers.</p>
            </div>
            <div class="space-y-1.5 max-w-sm">
              <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="status">
                Publication Status <span class="text-rose-500">*</span>
              </label>
              <select class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400 rounded-xl cursor-pointer py-2.5 px-4" name="status" id="status" required>
                <option value="Active" <%= product.status == 'Active' ? 'selected' : '' %>>🟢 Active (Publicly Visible)</option>
                <option value="Inactive" <%= product.status == 'Inactive' ? 'selected' : '' %>>🔴 Inactive (Archived Hidden)</option>
              </select>
              <p class="error text-rose-500 text-xs font-inter" id="error-status"></p>
            </div>
          </div>
          <% } %>
          <!-- 6. Actions -->
          <div class="flex flex-col sm:flex-row items-center gap-3.5 pt-2.5">
            <button class="bg-orange-600 text-white w-full sm:w-auto flex-1 flex items-center justify-center gap-2 text-sm font-montserrat font-semibold text-center rounded-xl shadow-lg shadow-orange-500/25 cursor-pointer py-3.5 px-8 hover:bg-orange-700 hover:shadow-orange-500/35 active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed transition ease-out duration-[250ms]" type="submit">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <%= editing ? 'Update Product' : 'Publish Product' %>
            </button>
            <a href="/admin/manage-products" class="bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 w-full sm:w-auto text-sm font-montserrat font-semibold text-center border border-slate-200 dark:border-slate-700 rounded-xl py-[0.8125rem] px-8 hover:bg-slate-100 dark:hover:bg-slate-700">
              Cancel
            </a>
          </div>
        </form>
      </div>
    </section>
  </main>
  <!-- Footer -->
  <%- include("../partials/footer") %>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/admin.js"></script>
</body>

</html>