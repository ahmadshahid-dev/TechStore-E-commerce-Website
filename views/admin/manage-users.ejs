<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="description" content="Admin User Management Dashboard - TechStore" />
  <title>Manage Users | TechStore Admin</title>
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased selection:bg-orange-500 selection:text-white">
  <!-- Header -->
  <%- include("../partials/header") %>
  <!-- Main -->
  <main>
    <!-- ==================== BREADCRUMBS & TOP BAR ==================== -->
    <section class="bg-white/60 dark:bg-slate-900/60 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 py-8 sm:py-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div class="space-y-1.5">
            <nav class="text-slate-500 dark:text-slate-400 text-xs font-inter font-medium flex items-center space-x-2" aria-label="Breadcrumb">
              <ol class="flex items-center space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
                <li><a href="/admin/dashboard" class="hover:text-orange-600 hover:transition-colors">Admin</a></li>
                <li><span>/</span></li>
                <li class="text-slate-900 dark:text-white font-semibold">Users</li>
              </ol>
            </nav>
            <h1 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-extrabold tracking-tight leading-none">
              Manage <span class="text-orange-600 dark:text-orange-500">Users</span>
            </h1>
            <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm font-inter">
              Monitor customer registrations, manage user permissions, and control account statuses.
            </p>
          </div>
          <!-- Quick Top Actions -->
          <button class="bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 w-fit inline-flex items-center gap-x-2 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm cursor-pointer py-2.5 px-4 hover:bg-slate-100 dark:hover:bg-slate-800 hover:transition-colors hover:ease-out hover:duration-200" onclick="window.print()">
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            <span class="text-xs font-montserrat font-semibold">Export List</span>
          </button>
        </div>
      </div>
    </section>
    <!-- ==================== KPI / STATS CARDS ==================== -->
    <section class="backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 py-8 sm:py-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          <!-- Total Users -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm p-5">
            <div class="flex items-center justify-between mb-2.5">
              <span class="text-slate-500 dark:text-slate-400 text-xs font-inter font-bold uppercase tracking-wider">Total
                Users</span>
              <div class="bg-orange-100 dark:bg-orange-950/60 text-orange-600 dark:text-orange-400 h-9 w-9 flex items-center justify-center rounded-xl shrink-0">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
              </div>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-black">
                <%= users.length %>
              </span>
              <span class="text-emerald-600 text-xs font-inter font-semibold">+8% this month</span>
            </div>
          </div>
          <!-- Active Users -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm p-5">
            <div class="flex items-center justify-between mb-2.5">
              <span class="text-slate-500 dark:text-slate-400 text-xs font-inter font-bold uppercase tracking-wider">Active
                Accounts</span>
              <div class="bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 h-9 w-9 flex items-center justify-center rounded-xl shrink-0">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-black">
                <%= users.filter(user => user.status !== 'Block' && user.status === 'Active').length %>
              </span>
              <span class="text-emerald-600 text-xs font-inter font-semibold">Active & Verified</span>
            </div>
          </div>
          <!-- Admins / Staff -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm p-5">
            <div class="flex items-center justify-between mb-2.5">
              <span class="text-slate-500 dark:text-slate-400 text-xs font-inter font-bold uppercase tracking-wider">Admin
                Staff</span>
              <div class="bg-blue-100 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 h-9 w-9 flex items-center justify-center rounded-xl shrink-0">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-black">
                <%= users.filter(user => user.role === 'admin' || user.role === 'staff').length %>
              </span>
              <span class="text-blue-600 text-xs font-inter font-semibold">Privileged Roles</span>
            </div>
          </div>
          <!-- Blocked / Suspended -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm p-5">
            <div class="flex items-center justify-between mb-2.5">
              <span class="text-slate-500 dark:text-slate-400 text-xs font-inter font-bold uppercase tracking-wider">Blocked /
                Inactive</span>
              <div class="bg-rose-100 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 h-9 w-9 flex items-center justify-center rounded-xl shrink-0">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                </svg>
              </div>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-black">
                <%= users.filter(user => user.status === 'Block').length %>
              </span>
              <span class="text-rose-600 text-xs font-inter font-semibold">Access Revoked</span>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- ==================== SEARCH & ROLE FILTER TOOLBAR ==================== -->
    <section class="backdrop-blur-md max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <div class="bg-white dark:bg-slate-900 space-y-4 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm p-4 sm:p-5 mb-6 sm:mb-8">
        <!-- Search Input & Status Select Row -->
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
          <!-- Search Bar -->
          <div class="relative flex-grow max-w-md">
            <span class="text-slate-400 absolute inset-y-0 flex items-center left-0 pl-3.5 pointer-events-none">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </span>
            <input class="bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 w-full text-xs sm:text-sm font-inter border border-slate-300 dark:border-slate-800 focus:ring focus:border-orange-500 focus:ring-orange-500/20 focus:outline-none rounded-xl placeholder:text-slate-400 py-2.5 pl-10 pr-4" id="userSearchInput" type="text" placeholder="Search by name, email,...." />
          </div>
          <!-- Status Select & Clear Button -->
          <div class="flex items-center gap-2.5">
            <select class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold cursor-pointer border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring focus:ring-orange-500 rounded-xl py-2.5 px-3" id="userStatusFilter">
              <option value="All">All Statuses</option>
              <option value="Active">Active Accounts</option>
              <option value="Block">Blocked / Suspended</option>
            </select>
            <button class="clearUserFilters text-slate-600 dark:text-slate-400 text-xs font-montserrat font-semibold border border-slate-200 dark:border-slate-700 rounded-xl py-2.5 px-3.5 cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-800 hover:transition-colors hover:ease-out hover:duration-200">
              Clear
            </button>
          </div>
        </div>
        <!-- Filter Chips: Roles Tabs -->
        <div class="border-t border-slate-100 dark:border-slate-800/80 flex items-center gap-x-2 [scrollbar-width:none] pt-3 pb-1 overflow-x-auto">
          <button class="role-chip active-chip bg-orange-600 text-white text-xs font-montserrat font-bold whitespace-nowrap rounded-xl cursor-pointer shadow-md shadow-orange-600/20 py-2 px-4 hover:transition hover:ease-out hover:duration-[250ms]" data-role="All">
            All Roles
          </button>
          <button class="role-chip bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold whitespace-nowrap cursor-pointer rounded-xl py-2 px-4 hover:bg-slate-200 dark:hover:bg-slate-700 hover:transition hover:ease-out hover:duration-[250ms]" data-role="User">
            Customers
          </button>
          <button class="role-chip bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold whitespace-nowrap cursor-pointer rounded-xl py-2 px-4 hover:bg-slate-200 dark:hover:bg-slate-700 hover:transition hover:ease-out hover:duration-[250ms]" data-role="Admin">
            Admins
          </button>
          <button class="role-chip bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold whitespace-nowrap cursor-pointer rounded-xl py-2 px-4 hover:bg-slate-200 dark:hover:bg-slate-700 hover:transition hover:ease-out hover:duration-[250ms]" data-role="Staff">
            Staff Support
          </button>
        </div>
      </div>
      <!-- ==================== USERS TABLE CARD ==================== -->
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="[scrollbar-width:none] overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <!-- Table Header -->
            <thead>
              <tr class="bg-slate-50 dark:bg-slate-800/60 text-slate-500 dark:text-slate-400 text-[0.6875rem] font-montserrat font-bold uppercase tracking-wider border-b border-slate-200 dark:border-slate-800">
                <th class="py-3.5 px-4 sm:px-6 text-left">User</th>
                <th class="py-3.5 px-4">Contact</th>
                <th class="py-3.5 px-4">Role</th>
                <th class="py-3.5 px-4">Orders</th>
                <th class="py-3.5 px-4">Status</th>
                <th class="py-3.5 px-4 sm:px-6 text-right">Action</th>
              </tr>
            </thead>
            <!-- Table Body -->
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-xs sm:text-sm font-medium">
              <% if (users && users.length > 0) { %>
              <% users.forEach((user) => { %>
              <tr class="user-card hover:bg-slate-50/80 dark:hover:bg-slate-800/40 hover:transition-colors hover:ease-out hover:duration-150" data-name="<%= user.name %>" data-email="<%= user.email %>" data-role="<%= user.role %>" data-status="<%= user.status %>">
                <!-- User Profile & Joined Date -->
                <td class="py-4 px-4 sm:px-6">
                  <div class="flex items-center gap-3.5">
                    <div class="bg-orange-100 dark:bg-orange-950/60 text-orange-600 dark:text-orange-400 h-10 w-10 flex items-center justify-center text-sm font-montserrat font-bold uppercase flex-shrink-0 rounded-full">
                      <%= (user.name || user.fullName || 'U' ).charAt(0) %>
                    </div>
                    <div class="min-w-0 max-w-xs sm:max-w-sm">
                      <span class="text-slate-900 dark:text-white font-inter font-semibold block truncate mb-0.5">
                        <%= user.name %>
                      </span>
                      <span class="text-slate-400 text-[0.6875rem] font-inter truncate block">
                        Joined <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString() : 'Recently' %>
                      </span>
                    </div>
                  </div>
                </td>
                <!-- Contact Details -->
                <td class="py-4 px-4">
                  <span class="text-slate-700 dark:text-slate-300 font-manrope text-xs block">
                    <%= user.email %>
                  </span>
                  <span class="text-slate-400 text-[0.6875rem] font-manrope block">
                    <%= user.phone %>
                  </span>
                </td>
                <!-- Role Badge -->
                <td class="py-4 px-4">
                  <% if (user.role ==='admin') { %>
                  <span class="bg-purple-100 dark:bg-purple-950 text-purple-700 dark:text-purple-300 text-[0.6875rem] font-inter font-bold border border-purple-200 dark:border-purple-800 rounded-full py-1 px-2.5">
                    Admin
                  </span>
                  <% } else if (user.role ==='staff') { %>
                  <span class="bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300 text-[0.6875rem] font-inter font-bold border border-blue-200 dark:border-blue-800 rounded-full py-1 px-2.5">
                    Staff
                  </span>
                  <% } else { %>
                  <span class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-[0.6875rem] font-inter font-bold rounded-full py-1 px-2.5">
                    Customer
                  </span>
                  <% } %>
                </td>
                <!-- Orders Placed Count -->
                <td class="py-4 px-4">
                  <span class="text-slate-900 dark:text-white text-xs font-montserrat font-bold truncate block">
                    <%= user.totalOrders %> Orders
                  </span>
                  <span class="text-slate-400 text-[0.6875rem] font-montserrat truncate">
                    Rs. <%= user.totalPrice.toLocaleString() %>
                  </span>
                </td>
                <!-- Status Pill -->
                <td class="py-4 px-4">
                  <% if (user.status==='Block' ) { %>
                  <span class="bg-rose-100 dark:bg-rose-950/70 text-rose-800 dark:text-rose-300 inline-flex items-center gap-1.5 border border-rose-300 dark:border-rose-800 rounded-full py-1 px-2.5">
                    <span class="bg-current h-1.5 w-1.5 rounded-full"></span>
                    <span class="text-xs font-inter font-semibold">Block</span>
                  </span>
                  <% } else { %>
                  <span class="bg-emerald-100 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300 inline-flex items-center gap-1.5 border border-emerald-300 dark:border-emerald-800 rounded-full py-1 px-2.5">
                    <span class="bg-current h-1.5 w-1.5 rounded-full"></span>
                    <span class="text-xs font-inter font-semibold">Active</span>
                  </span>
                  <% } %>
                </td>
                <!-- Actions -->
                <td class="py-4 px-4 sm:px-6 text-right">
                  <!-- View / Edit User Modal Trigger -->
                  <button class="openTrigger text-slate-600 dark:text-slate-400 rounded-xl cursor-pointer p-2 hover:bg-orange-50 dark:hover:bg-orange-950/40 hover:text-orange-600 hover:ease-out hover:transition-colors hover:duration-150" type="button" data-model="userModel" data-user-id="<%= user._id %>" data-role="<%= user.role %>" data-status="<%= user.status %>">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                  </button>
                </td>
              </tr>
              <% }); %>
              <% } else { %>
              <!-- ==================== 5. EMPTY Catalog ==================== -->
              <div class="py-10 sm:py-12 text-center space-y-3" id="empty">
                <div class="bg-orange-100 dark:bg-orange-950/60 text-orange-600 dark:text-orange-400 h-16 w-16 flex items-center justify-center mx-auto rounded-2xl mb-4.5">
                  <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                </div>
                <h3 class="text-slate-900 dark:text-white text-base sm:text-lg font-montserrat font-bold leading-none">Users Not Found</h3>
                <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm font-inter max-w-sm mx-auto mb-4.5">
                  Your user catalog is empty. Add your first user/customer to start selling.
                </p>
                <a class="bg-orange-600 text-white inline-flex items-center gap-x-1.5 rounded-xl cursor-pointer py-2.5 px-4 hover:bg-orange-700 transition-colors ease-out duration200" href="/admin/manage-users">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                  <span class="text-xs font-montserrat font-semibold">Add First User</span>
                </a>
              </div>
              <% } %>
            </tbody>
          </table>
        </div>
        <!-- ==================== EMPTY SEARCH STATE ==================== -->
        <div class="py-10 sm:py-12 text-center space-y-3 hidden" id="no-matches">
          <div class="bg-orange-50 dark:bg-orange-500/10 h-16 w-16 text-orange-600 text-2xl mx-auto flex items-center justify-center rounded-2xl mb-4">
            🔍
          </div>
          <h3 class="text-slate-900 dark:text-white text-base sm:text-lg font-montserrat font-bold leading-none">No Matching User</h3>
          <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm font-inter max-w-sm mx-auto mb-4.5">
            Try clearing your search query or selecting a different category filter.
          </p>
          <button class="clearUserFilters bg-orange-600 text-white text-sm font-montserrat font-semibold inline-flex items-center gap-x-1.5 rounded-xl cursor-pointer py-2.5 px-4 hover:bg-orange-700 transition-colors ease-out duration-200">
            Reset All Filters
          </button>
        </div>
        <!-- Table Footer / Pagination -->
        <div class="bg-slate-50/50 dark:bg-slate-800/30 flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-slate-200 dark:border-slate-800 p-4 sm:p-5">
          <span class="text-slate-500 text-xs font-inter">Showing <strong class="text-slate-900 dark:text-white" id="items-count"><%= users.length %></strong>
            <span id="remaningUsers"><%= users.length > 1 ? 'Users' : 'User' %></span>
          </span>
          <div class="flex items-center gap-x-2">
            <button class="text-slate-500 text-xs font-montserrat border border-slate-200 dark:border-slate-700 rounded-lg cursor-pointer py-1.5 px-3 hover:bg-white dark:hover:bg-slate-800 hover:transition-colors disabled:opacity-50" disabled>Previous</button>
            <span class="bg-orange-600 text-white text-xs font-montserrat font-bold rounded-lg py-1.5 px-3">1</span>
            <button class="text-slate-500 text-xs font-montserrat border border-slate-200 dark:border-slate-700 rounded-lg cursor-pointer py-1.5 px-3 hover:bg-white dark:hover:bg-slate-800 hover:transition-colors disabled:opacity-50" disabled>Next</button>
          </div>
        </div>
      </div>
    </section>
    <!-- ==================== USER EDIT & ROLE MODEL ==================== -->
    <div class="bg-slate-950/60 backdrop-blur-sm fixed inset-0 flex items-center justify-center p-4 z-50 hidden" id="userModel">
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl w-full max-w-lg shadow-2xl overflow-hidden relative animate-in fade-in zoom-in-95 duration-200">
        <!-- Model Header -->
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 p-6">
          <div class="space-y-0.75">
            <span class="text-orange-600 dark:text-orange-400 text-xs font-manrope font-bold block">User Account Settings</span>
            <h2 class="text-slate-900 dark:text-white text-lg font-montserrat font-bold leading-none">Edit User Account</h2>
          </div>
          <button class="closeTrigger text-slate-400 hover:text-slate-600 rounded-xl cursor-pointer p-2 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition ease-out duration-150" id="closeUserModal" type="button">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <!-- Model Body Form -->
        <form class="space-y-4 p-6" id="userEditForm">
          <input type="hidden" name="userId" id="userId" value="" />
          <!-- Role Select -->
          <div class="space-y-1.5">
            <label class="text-slate-600 dark:text-slate-300 text-[0.6875rem] font-inter font-bold uppercase tracking-wider block" for="role">User Role & Permissions</label>
            <select class="bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 w-full text-xs font-montserrat font-medium border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring focus:ring-orange-500 rounded-xl cursor-pointer py-2.5 px-3.5" id="role" name="role" required>
              <option value="user">Customer (Standard User)</option>
              <option value="staff">Staff Support (Orders & Catalog)</option>
              <option value="admin">Admin (Full System Access)</option>
            </select>
            <p class="error text-red-500 text-[0.6875rem] font-inter font-medium" id="error-role"></p>
          </div>
          <!-- Account Status Select -->
          <div class="space-y-1.5">
            <label class="text-slate-600 dark:text-slate-300 text-[0.6875rem] font-inter font-bold uppercase tracking-wider block" for="status">Account Status</label>
            <select class="bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 w-full text-xs font-montserrat font-medium border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring focus:ring-orange-500 rounded-xl cursor-pointer py-2.5 px-3.5" id="status" name="status" required>
              <option value="Active">Active (Permitted)</option>
              <option value="Block">Blocked (Restricted Login)</option>
            </select>
            <p class="error text-red-500 text-[0.6875rem] font-inter font-medium" id="error-status"></p>
          </div>
          <!-- Model Submit & Cancel Buttons -->
          <div class="flex items-center justify-end gap-2.5 border-t border-slate-100 dark:border-slate-800 pt-4">
            <button class="cancelTrigger bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold whitespace-nowrap cursor-pointer rounded-xl py-2.5 px-4 hover:bg-slate-200 dark:hover:bg-slate-700 hover:transition-colors hover:ease-out hover:duration-200" type="button">
              Cancel
            </button>
            <button class="bg-orange-600 text-white flex items-center justify-center gap-x-1.5 rounded-xl cursor-pointer shadow-md shadow-orange-600/20 py-2.5 px-4 hover:bg-orange-700 hover:transition hover:ease-out hover:duration-[250ms] disabled:cursor-not-allowed disabled:opacity-60" type="submit">
              <span class="Spinner h-3.5 w-3.5 border-[3px] border-orange-100 border-t-orange-500 shrink-0 rounded-full animate-spin drop-shadow-[0_0_4px_rgba(249,115,22,0.6)] hidden"></span>
              <span class="Text text-xs font-montserrat font-bold">Save Changes</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
  <!-- Footer -->
  <%- include("../partials/footer") %>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/admin.js"></script>
</body>

</html>