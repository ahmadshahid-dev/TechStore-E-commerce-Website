<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Admin User Management Dashboard - TechStore" />
  <title>Manage Users | TechStore Admin</title>
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased min-h-screen flex flex-col font-inter selection:bg-orange-500 selection:text-white">

  <div class="flex-grow flex">
    <%- include("../partials/header") %>
    <!-- Main Workspace Container -->
    <main class="flex-grow p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto w-full">

      <!-- ==================== 1. BREADCRUMBS & TOP BAR ==================== -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div>
          <nav aria-label="Breadcrumb" class="mb-2">
            <ol class="flex items-center space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400">
              <li><a href="/admin/dashboard" class="hover:text-orange-600 transition-colors">Admin</a></li>
              <li><span>/</span></li>
              <li class="text-slate-900 dark:text-white font-semibold">Users</li>
            </ol>
          </nav>
          <h1 class="text-2xl sm:text-3xl font-black font-montserrat text-slate-900 dark:text-white tracking-tight">
            Manage <span class="text-orange-600 dark:text-orange-500">Users</span>
          </h1>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
            Monitor customer registrations, manage user permissions, and control account statuses.
          </p>
        </div>

        <!-- Quick Top Actions -->
        <div class="flex items-center gap-3">
          <button onclick="window.print()" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-semibold transition-colors shadow-sm cursor-pointer">
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            Export List
          </button>
        </div>
      </div>

      <!-- ==================== 2. KPI / STATS CARDS ==================== -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-8">

        <!-- Total Users -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Users</span>
            <div class="w-9 h-9 rounded-xl bg-orange-100 dark:bg-orange-950/60 text-orange-600 dark:text-orange-400 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-2xl sm:text-3xl font-black font-montserrat text-slate-900 dark:text-white" id="stat-total-users">
              <%= typeof users !== 'undefined' ? users.length : 24 %>
            </span>
            <span class="text-xs text-emerald-600 font-semibold">+8% this month</span>
          </div>
        </div>

        <!-- Active Users -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Active Accounts</span>
            <div class="w-9 h-9 rounded-xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-2xl sm:text-3xl font-black font-montserrat text-slate-900 dark:text-white" id="stat-active-users">
              <%= typeof users !== 'undefined' ? users.filter(u => u.status !== 'Blocked' && u.status !== 'Suspended').length : 22 %>
            </span>
            <span class="text-xs text-emerald-600 font-semibold">Active & Verified</span>
          </div>
        </div>

        <!-- Admins / Staff -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Admin Staff</span>
            <div class="w-9 h-9 rounded-xl bg-blue-100 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-2xl sm:text-3xl font-black font-montserrat text-slate-900 dark:text-white" id="stat-admin-users">
              <%= typeof users !== 'undefined' ? users.filter(u => u.role === 'admin' || u.role === 'staff').length : 2 %>
            </span>
            <span class="text-xs text-blue-600 font-semibold">Privileged Roles</span>
          </div>
        </div>

        <!-- Blocked / Suspended -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Blocked / Inactive</span>
            <div class="w-9 h-9 rounded-xl bg-rose-100 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
              </svg>
            </div>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-2xl sm:text-3xl font-black font-montserrat text-slate-900 dark:text-white" id="stat-blocked-users">
              <%= typeof users !== 'undefined' ? users.filter(u => u.status === 'Blocked' || u.status === 'Suspended').length : 2 %>
            </span>
            <span class="text-xs text-rose-600 font-semibold">Access Revoked</span>
          </div>
        </div>

      </div>

      <!-- ==================== 3. SEARCH & ROLE FILTER TOOLBAR ==================== -->
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 sm:p-5 shadow-sm mb-6 space-y-4">

        <!-- Search Input & Status Select Row -->
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">

          <!-- Search Bar -->
          <div class="relative flex-grow max-w-md">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </span>
            <input type="text" id="userSearchInput" placeholder="Search by name, email, phone number..." class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition" />
          </div>

          <!-- Status Select & Clear Button -->
          <div class="flex items-center gap-2.5">
            <select id="userStatusFilter" class="bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 rounded-xl px-3 py-2.5 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-orange-500 cursor-pointer">
              <option value="All">All Statuses</option>
              <option value="Active">Active Accounts</option>
              <option value="Blocked">Blocked / Suspended</option>
            </select>

            <button id="clearUserFilterBtn" class="px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-semibold transition cursor-pointer">
              Clear
            </button>
          </div>

        </div>

        <!-- Filter Chips: Roles Tabs -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar border-t border-slate-100 dark:border-slate-800/80 pt-3">
          <button class="user-role-chip active-chip bg-orange-600 text-white text-xs font-montserrat font-bold whitespace-nowrap cursor-pointer rounded-xl shadow-sm shadow-orange-600/20 py-2 px-4 transition" data-role="All">
            All Roles
          </button>
          <button class="user-role-chip bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold whitespace-nowrap cursor-pointer rounded-xl py-2 px-4 hover:bg-slate-200 dark:hover:bg-slate-700 transition" data-role="customer">
            Customers
          </button>
          <button class="user-role-chip bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold whitespace-nowrap cursor-pointer rounded-xl py-2 px-4 hover:bg-slate-200 dark:hover:bg-slate-700 transition" data-role="admin">
            Admins
          </button>
          <button class="user-role-chip bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold whitespace-nowrap cursor-pointer rounded-xl py-2 px-4 hover:bg-slate-200 dark:hover:bg-slate-700 transition" data-role="staff">
            Staff Support
          </button>
        </div>

      </div>

      <!-- ==================== 4. USERS TABLE CARD ==================== -->
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse" id="users-table">

            <!-- Table Header -->
            <thead>
              <tr class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider font-montserrat">
                <th class="py-3.5 px-4 sm:px-6">User</th>
                <th class="py-3.5 px-4">Contact</th>
                <th class="py-3.5 px-4">Role</th>
                <th class="py-3.5 px-4">Orders</th>
                <th class="py-3.5 px-4">Status</th>
                <th class="py-3.5 px-4 sm:px-6 text-right">Actions</th>
              </tr>
            </thead>

            <!-- Table Body -->
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-xs sm:text-sm font-medium" id="users-tbody">

              <% if (typeof users !== 'undefined' && users.length > 0) { %>
              <% users.forEach(function(user) { %>
              <tr class="user-row hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors" data-user-name="<%= user.name || user.fullName || 'User' %>" data-user-email="<%= user.email || '' %>" data-user-phone="<%= user.phone || '' %>" data-user-role="<%= (user.role || 'customer').toLowerCase() %>" data-user-status="<%= user.status || 'Active' %>">
                <!-- User Profile & Joined Date -->
                <td class="py-4 px-4 sm:px-6">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-orange-100 dark:bg-orange-950/60 text-orange-600 dark:text-orange-400 flex items-center justify-center font-bold text-sm uppercase flex-shrink-0">
                      <%= (user.name || user.fullName || 'U').charAt(0) %>
                    </div>
                    <div>
                      <span class="font-bold text-slate-900 dark:text-white block">
                        <%= user.name || user.fullName || 'Customer' %>
                      </span>
                      <span class="text-[11px] text-slate-400">
                        Joined <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString() : 'Recently' %>
                      </span>
                    </div>
                  </div>
                </td>

                <!-- Contact Details -->
                <td class="py-4 px-4">
                  <span class="text-slate-700 dark:text-slate-300 block font-mono text-xs">
                    <%= user.email || 'user@example.com' %>
                  </span>
                  <span class="text-[11px] text-slate-400 block font-mono">
                    <%= user.phone || '+92 300 1234567' %>
                  </span>
                </td>

                <!-- Role Badge -->
                <td class="py-4 px-4">
                  <% if ((user.role || '').toLowerCase() === 'admin') { %>
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-purple-100 dark:bg-purple-950 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800">
                    Admin
                  </span>
                  <% } else if ((user.role || '').toLowerCase() === 'staff') { %>
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
                    Staff
                  </span>
                  <% } else { %>
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                    Customer
                  </span>
                  <% } %>
                </td>

                <!-- Orders Placed Count -->
                <td class="py-4 px-4">
                  <span class="font-bold font-montserrat text-slate-900 dark:text-white block">
                    <%= user.totalOrders || 0 %> Orders
                  </span>
                  <span class="text-[11px] text-slate-400">
                    Rs. <%= user.totalSpent ? user.totalSpent.toLocaleString() : '0' %>
                  </span>
                </td>

                <!-- Status Pill -->
                <td class="py-4 px-4">
                  <% if (user.status === 'Blocked' || user.status === 'Suspended') { %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-xs font-semibold bg-rose-100 dark:bg-rose-950/70 text-rose-800 dark:text-rose-300 border-rose-300 dark:border-rose-800">
                    <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                    Blocked
                  </span>
                  <% } else { %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-xs font-semibold bg-emerald-100 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800">
                    <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                    Active
                  </span>
                  <% } %>
                </td>

                <!-- Actions -->
                <td class="py-4 px-4 sm:px-6 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <!-- View / Edit User Modal Trigger -->
                    <button type="button" class="view-user-btn p-2 rounded-xl text-slate-600 dark:text-slate-400 hover:text-orange-600 hover:bg-orange-50 dark:hover:bg-orange-950/40 transition cursor-pointer" data-user='<%- JSON.stringify(user) %>' title="Manage User Details">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
              <% }); %>
              <% } else { %>

              <!-- Mock Sample User 1 -->
              <tr class="user-row hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors" data-user-name="Ahmad Shahid" data-user-email="ahmad@example.com" data-user-phone="+92 300 1234567" data-user-role="customer" data-user-status="Active">
                <td class="py-4 px-4 sm:px-6">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-orange-100 dark:bg-orange-950/60 text-orange-600 dark:text-orange-400 flex items-center justify-center font-bold text-sm uppercase flex-shrink-0">
                      A
                    </div>
                    <div>
                      <span class="font-bold text-slate-900 dark:text-white block">Ahmad Shahid</span>
                      <span class="text-[11px] text-slate-400">Joined Oct 5, 2026</span>
                    </div>
                  </div>
                </td>
                <td class="py-4 px-4">
                  <span class="text-slate-700 dark:text-slate-300 block font-mono text-xs">ahmad@example.com</span>
                  <span class="text-[11px] text-slate-400 block font-mono">+92 300 1234567</span>
                </td>
                <td class="py-4 px-4">
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                    Customer
                  </span>
                </td>
                <td class="py-4 px-4">
                  <span class="font-bold font-montserrat text-slate-900 dark:text-white block">3 Orders</span>
                  <span class="text-[11px] text-slate-400">Rs. 37,498 spent</span>
                </td>
                <td class="py-4 px-4">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-xs font-semibold bg-emerald-100 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800">
                    <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                    Active
                  </span>
                </td>
                <td class="py-4 px-4 sm:px-6 text-right">
                  <button type="button" class="view-user-btn p-2 rounded-xl text-slate-600 dark:text-slate-400 hover:text-orange-600 hover:bg-orange-50 dark:hover:bg-orange-950/40 transition cursor-pointer" title="Manage User Details">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                  </button>
                </td>
              </tr>

              <!-- Mock Sample User 2 -->
              <tr class="user-row hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors" data-user-name="Sara Khan" data-user-email="sara.admin@techstore.pk" data-user-phone="+92 321 9876543" data-user-role="admin" data-user-status="Active">
                <td class="py-4 px-4 sm:px-6">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-purple-100 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-sm uppercase flex-shrink-0">
                      S
                    </div>
                    <div>
                      <span class="font-bold text-slate-900 dark:text-white block">Sara Khan</span>
                      <span class="text-[11px] text-slate-400">Joined Aug 12, 2026</span>
                    </div>
                  </div>
                </td>
                <td class="py-4 px-4">
                  <span class="text-slate-700 dark:text-slate-300 block font-mono text-xs">sara.admin@techstore.pk</span>
                  <span class="text-[11px] text-slate-400 block font-mono">+92 321 9876543</span>
                </td>
                <td class="py-4 px-4">
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-purple-100 dark:bg-purple-950 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800">
                    Admin
                  </span>
                </td>
                <td class="py-4 px-4">
                  <span class="font-bold font-montserrat text-slate-900 dark:text-white block">—</span>
                  <span class="text-[11px] text-slate-400">Admin Account</span>
                </td>
                <td class="py-4 px-4">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-xs font-semibold bg-emerald-100 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800">
                    <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                    Active
                  </span>
                </td>
                <td class="py-4 px-4 sm:px-6 text-right">
                  <button type="button" class="view-user-btn p-2 rounded-xl text-slate-600 dark:text-slate-400 hover:text-orange-600 hover:bg-orange-50 dark:hover:bg-orange-950/40 transition cursor-pointer" title="Manage User Details">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                  </button>
                </td>
              </tr>

              <% } %>

            </tbody>
          </table>
        </div>

        <!-- ==================== 5. EMPTY SEARCH STATE ==================== -->
        <div id="no-users-found" class="hidden py-12 text-center">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-orange-100 dark:bg-orange-950/60 text-orange-600 dark:text-orange-400 flex items-center justify-center mb-3">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1">No Users Match Your Filter</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto mb-4">
            Try searching with a different name or clear the selected role filters.
          </p>
          <button id="resetUsersFromEmptyBtn" class="px-4 py-2 rounded-xl bg-orange-600 text-white text-xs font-bold hover:bg-orange-700 transition cursor-pointer">
            Reset All Filters
          </button>
        </div>

        <!-- Table Footer / Pagination -->
        <div class="p-4 sm:p-5 border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
          <span>Showing <strong class="text-slate-900 dark:text-white" id="visible-users-count">2</strong> users</span>
          <div class="flex items-center gap-2">
            <button class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-white dark:hover:bg-slate-800 disabled:opacity-50" disabled>Previous</button>
            <span class="px-3 py-1.5 rounded-lg bg-orange-600 text-white font-bold">1</span>
            <button class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-white dark:hover:bg-slate-800 disabled:opacity-50" disabled>Next</button>
          </div>
        </div>

      </div>

    </main>
  </div>

  <!-- ==================== 6. USER EDIT & ROLE MODAL ==================== -->
  <div id="userModal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-sm hidden flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl w-full max-w-lg shadow-2xl overflow-hidden relative animate-in fade-in zoom-in-95 duration-200">

      <!-- Modal Header -->
      <div class="p-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
        <div>
          <span class="text-xs font-mono font-bold text-orange-600 dark:text-orange-400">User Account Settings</span>
          <h2 class="text-lg font-black font-montserrat text-slate-900 dark:text-white" id="modal-user-heading">Edit User Account</h2>
        </div>
        <button type="button" id="closeUserModal" class="p-2 rounded-xl text-slate-400 hover:text-slate-600 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Modal Body Form -->
      <form id="updateUserForm" action="/admin/users/update" method="POST" class="p-6 space-y-4">
        <input type="hidden" name="userId" id="modal-form-user-id" value="" />

        <!-- User Name (Read-Only / Editable) -->
        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Full Name</label>
          <input type="text" name="name" id="modal-input-user-name" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-orange-500" required />
        </div>

        <!-- Email -->
        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Email Address</label>
          <input type="email" name="email" id="modal-input-user-email" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-orange-500" required />
        </div>

        <!-- Role Select -->
        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">User Role & Permissions</label>
          <select name="role" id="modal-select-user-role" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-orange-500 cursor-pointer">
            <option value="customer">Customer (Standard User)</option>
            <option value="staff">Staff Support (Orders & Catalog)</option>
            <option value="admin">Admin (Full System Access)</option>
          </select>
        </div>

        <!-- Account Status Select -->
        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Account Status</label>
          <select name="status" id="modal-select-user-status" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-orange-500 cursor-pointer">
            <option value="Active">Active (Permitted)</option>
            <option value="Blocked">Blocked (Restricted Login)</option>
          </select>
        </div>

        <!-- Modal Submit & Cancel Buttons -->
        <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-end gap-2.5">
          <button type="button" id="closeUserModalBottom" class="px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-300 transition cursor-pointer">
            Cancel
          </button>
          <button type="submit" class="px-5 py-2.5 rounded-xl bg-orange-600 hover:bg-orange-700 text-white font-bold text-xs shadow-md shadow-orange-600/20 transition cursor-pointer">
            Save Changes
          </button>
        </div>
      </form>

    </div>
  </div>

  <!-- Admin Footer Partial -->
  <%- include("../partials/footer") %>

  <!-- ==================== 7. CLIENT-SIDE JS SCRIPT ==================== -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const userSearchInput = document.getElementById("userSearchInput");
      const userStatusFilter = document.getElementById("userStatusFilter");
      const clearUserFilterBtn = document.getElementById("clearUserFilterBtn");
      const resetUsersFromEmptyBtn = document.getElementById("resetUsersFromEmptyBtn");
      const roleChips = document.querySelectorAll(".user-role-chip");
      const userRows = document.querySelectorAll(".user-row");
      const noUsersFound = document.getElementById("no-users-found");
      const visibleCountEl = document.getElementById("visible-users-count");

      let currentRole = "All";

      // Function: Filter Users Table Rows
      function filterUsers() {
        const query = (userSearchInput?.value || "").toLowerCase().trim();
        const status = userStatusFilter?.value || "All";
        let count = 0;

        userRows.forEach(row => {
          const name = (row.dataset.userName || "").toLowerCase();
          const email = (row.dataset.userEmail || "").toLowerCase();
          const phone = (row.dataset.userPhone || "").toLowerCase();
          const role = (row.dataset.userRole || "customer").toLowerCase();
          const userStatus = (row.dataset.userStatus || "Active").toLowerCase();

          // Conditions
          const matchesQuery = !query || name.includes(query) || email.includes(query) || phone.includes(query);
          const matchesRole = currentRole === "All" || role === currentRole.toLowerCase();
          const matchesStatus = status === "All" || userStatus === status.toLowerCase();

          if (matchesQuery && matchesRole && matchesStatus) {
            row.style.display = "";
            count++;
          } else {
            row.style.display = "none";
          }
        });

        // Update count & empty state
        if (visibleCountEl) visibleCountEl.textContent = count;
        if (noUsersFound) {
          if (count === 0) {
            noUsersFound.classList.remove("hidden");
          } else {
            noUsersFound.classList.add("hidden");
          }
        }
      }

      // Role filter chips click listener
      roleChips.forEach(chip => {
        chip.addEventListener("click", (e) => {
          e.preventDefault();
          roleChips.forEach(c => {
            c.className = "user-role-chip bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold whitespace-nowrap cursor-pointer rounded-xl py-2 px-4 hover:bg-slate-200 dark:hover:bg-slate-700 transition";
          });
          chip.className = "user-role-chip active-chip bg-orange-600 text-white text-xs font-montserrat font-bold whitespace-nowrap cursor-pointer rounded-xl shadow-sm shadow-orange-600/20 py-2 px-4 transition";
          currentRole = chip.getAttribute("data-role") || "All";
          filterUsers();
        });
      });

      // Search & select listeners
      userSearchInput?.addEventListener("input", filterUsers);
      userStatusFilter?.addEventListener("change", filterUsers);

      // Reset filters function
      function resetFilters() {
        if (userSearchInput) userSearchInput.value = "";
        if (userStatusFilter) userStatusFilter.value = "All";
        roleChips.forEach(c => {
          const isAll = c.getAttribute("data-role") === "All";
          c.className = isAll ?
            "user-role-chip active-chip bg-orange-600 text-white text-xs font-montserrat font-bold whitespace-nowrap cursor-pointer rounded-xl shadow-sm shadow-orange-600/20 py-2 px-4 transition" :
            "user-role-chip bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold whitespace-nowrap cursor-pointer rounded-xl py-2 px-4 hover:bg-slate-200 dark:hover:bg-slate-700 transition";
        });
        currentRole = "All";
        filterUsers();
      }

      clearUserFilterBtn?.addEventListener("click", resetFilters);
      resetUsersFromEmptyBtn?.addEventListener("click", resetFilters);

      // ==================== MODAL LOGIC ====================
      const userModal = document.getElementById("userModal");
      const closeButtons = [document.getElementById("closeUserModal"), document.getElementById("closeUserModalBottom")];

      document.querySelectorAll(".view-user-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          try {
            const rawData = btn.getAttribute("data-user");
            if (rawData) {
              const user = JSON.parse(rawData);
              document.getElementById("modal-form-user-id").value = user._id || "";
              document.getElementById("modal-input-user-name").value = user.name || user.fullName || "";
              document.getElementById("modal-input-user-email").value = user.email || "";
              document.getElementById("modal-select-user-role").value = (user.role || "customer").toLowerCase();
              document.getElementById("modal-select-user-status").value = user.status || "Active";
              document.getElementById("modal-user-heading").textContent = "Edit " + (user.name || user.fullName || "User");
            }
          } catch (e) {
            console.log("Modal preview render");
          }
          userModal?.classList.remove("hidden");
        });
      });

      closeButtons.forEach(btn => {
        btn?.addEventListener("click", () => {
          userModal?.classList.add("hidden");
        });
      });

      userModal?.addEventListener("click", (e) => {
        if (e.target === userModal) {
          userModal.classList.add("hidden");
        }
      });

    });
  </script>

</body>

</html>