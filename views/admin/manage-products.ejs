<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Admin Product Management Dashboard - TechStore" />
  <title>Manage Products | TechStore Admin</title>
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased selection:bg-orange-500 selection:text-white">
  <!-- Header -->
  <%- include("../partials/header") %>
  <!-- Main Workspace Container -->
  <main>
    <!-- ==================== 1. BREADCRUMBS & TOP BAR ==================== -->
    <section class="bg-white/60 dark:bg-slate-900/60 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 py-8 sm:py-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div class="space-y-1.5">
            <nav class="text-slate-500 dark:text-slate-400 text-xs font-inter font-medium flex items-center space-x-2" aria-label="Breadcrumb">
              <a class="hover:text-orange-600 dark:hover:text-orange-400 hover:transition-colors" href="/admin/dashboard">Admin</a>
              <span>/</span>
              <span class="text-slate-900 dark:text-white font-semibold">Products</span>
            </nav>
            <h1 class=" text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-extrabold tracking-tight leading-none">
              Manage <span class="text-orange-600 dark:text-orange-500">Products</span>
            </h1>
            <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm font-inter">
              Add, update inventory, edit pricing, and control stock status across your store.
            </p>
          </div>
          <!-- Primary Top Actions -->
          <a class="bg-orange-600 text-white w-fit inline-flex items-center gap-2 rounded-xl 
            shadow-lg shadow-orange-500/25 py-3 px-6 hover:bg-orange-700 active:scale-[0.98] hover:shadow-orange-500/35 transition ease-out duration-[250ms]" href="/admin/product-add">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span class="text-sm font-montserrat font-semibold">Add New Product</span>
          </a>
        </div>
      </div>
    </section>
    <!-- ==================== 2. KPI / STATS CARDS ==================== -->
    <section class="backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 py-8 sm:py-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          <!-- Total Products -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm p-5">
            <div class="flex items-center justify-between mb-2.5">
              <span class="text-slate-500 dark:text-slate-400 text-xs font-inter font-bold uppercase tracking-wider">Total Catalog</span>
              <div class="bg-orange-100 dark:bg-orange-950/60 text-orange-600 dark:text-orange-400 h-9 w-9 flex items-center justify-center rounded-xl">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
              </div>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-black" id="stat-total-products">
                <%= typeof products !== 'undefined' ? products.length : 18 %>
              </span>
              <span class="text-slate-400 text-xs font-inter font-semibold">Active Items</span>
            </div>
          </div>
          <!-- In Stock -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm p-5">
            <div class="flex items-center justify-between mb-2.5">
              <span class="text-slate-500 dark:text-slate-400 text-xs font-inter font-bold uppercase tracking-wider">In Stock</span>
              <div class="bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 h-9 w-9 flex items-center justify-center rounded-xl">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-black" id="stat-instock-products">
                <%= products.filter((product) => (product.stockQuantity || 0) > 5).length %>
              </span>
              <span class="text-emerald-600 text-xs font-inter font-semibold">Healthy Inventory</span>
            </div>
          </div>
          <!-- Low / Out of Stock -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm p-5">
            <div class="flex items-center justify-between mb-2.5">
              <span class="text-slate-500 dark:text-slate-400 text-xs font-inter font-bold uppercase tracking-wider">Low / Out of Stock</span>
              <div class="bg-amber-100 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 h-9 w-9 flex items-center justify-center rounded-xl">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
              </div>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-black" id="stat-lowstock-products">
                <%= products.filter((product) => (product.stockQuantity || 0) <= 5).length %>
              </span>
              <span class="text-amber-600 text-xs font-inter font-semibold">Restock Needed</span>
            </div>
          </div>
          <!-- Featured & Deals -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm p-5">
            <div class="flex items-center justify-between mb-2.5">
              <span class="text-slate-500 dark:text-slate-400 text-xs font-inter font-bold uppercase tracking-wider">Featured Deals</span>
              <div class="bg-purple-100 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 h-9 w-9 flex items-center justify-center rounded-xl ">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                </svg>
              </div>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-black" id="stat-deals-products">
                <%= products.filter((product) => product.tag === 'Deal' || product.tag === 'Best-Sell').length %>
              </span>
              <span class="text-purple-600 text-xs font-inter font-semibold">Promotional</span>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- ==================== 3. SEARCH & CATEGORY FILTER TOOLBAR ==================== -->
    <section class="backdrop-blur-md max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <div class="bg-white dark:bg-slate-900 space-y-4 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm p-4 sm:p-5 mb-6 sm:mb-8">
        <!-- Search Input & Stock Dropdown Row -->
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
          <!-- Search Bar -->
          <div class="relative flex-grow max-w-md">
            <span class="text-slate-400 absolute inset-y-0 flex items-center left-0 pl-3.5 pointer-events-none">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </span>
            <input class="bg-white dark:bg-slate-900 text-slate-900 dark:text-white w-full text-xs sm:text-sm font-inter border border-slate-300 dark:border-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400 rounded-xl py-2.5 pl-10 pr-4" id="prdctSearchInput" type="text" placeholder="Search by title, SKU, or tags..." />
          </div>
          <!-- Stock Status & Clear Button -->
          <div class="flex items-center gap-2.5">
            <select class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold cursor-pointer border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring focus:ring-orange-500 rounded-xl py-2.5 px-3" id="prdctStockFilter">
              <option value="All">All Stock Levels</option>
              <option value="InStock">In Stock (> 5)</option>
              <option value="LowStock">Low Stock (1 - 5)</option>
              <option value="OutOfStock">Out of Stock (0)</option>
            </select>
            <button class="clearFilterBtn text-slate-600 dark:text-slate-400 text-xs font-montserrat font-semibold border border-slate-200 dark:border-slate-700 rounded-xl py-2.5 px-3.5 cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-800 hover:transition hover:ease-out hover:duration-[250ms]">
              Clear
            </button>
          </div>
        </div>
        <!-- Filter Chips: Categories Tabs -->
        <div class="border-t border-slate-100 dark:border-slate-800/80 flex items-center gap-x-2 no-scrollbar pt-3 pb-1 overflow-x-auto">
          <button class="category-chip active-chip bg-orange-600 text-white text-xs font-montserrat font-bold whitespace-nowrap rounded-xl cursor-pointer shadow-md shadow-orange-600/20 py-2 px-4 hover:transition hover:ease-out hover:duration-[250ms]" data-category="All">
            All Products
          </button>
          <button class="category-chip bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold whitespace-nowrap cursor-pointer rounded-xl py-2 px-4 hover:bg-slate-200 dark:hover:bg-slate-700 hover:transition hover:ease-out hover:duration-[250ms]" data-category="headphones">
            🎧 Headphones
          </button>
          <button class="category-chip bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold whitespace-nowrap cursor-pointer rounded-xl py-2 px-4 hover:bg-slate-200 dark:hover:bg-slate-700 hover:transition hover:ease-out hover:duration-[250ms]" data-category="keyboards">
            ⌨️ Keyboards
          </button>
          <button class="category-chip bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold whitespace-nowrap cursor-pointer rounded-xl py-2 px-4 hover:bg-slate-200 dark:hover:bg-slate-700 hover:transition hover:ease-out hover:duration-[250ms]" data-category="mice">
            🖱️ Gaming Mice
          </button>
        </div>
      </div>
      <!-- ==================== 4. PRODUCTS TABLE CARD ==================== -->
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm overflow-y-hidden overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <!-- Table Header -->
          <thead>
            <tr class="bg-slate-50 dark:bg-slate-800/60 text-slate-500 dark:text-slate-400 text-[0.6875rem] font-montserrat font-bold uppercase tracking-wider border-b border-slate-200 dark:border-slate-800">
              <th class="py-3.5 px-4 sm:px-6 text-left">Product Details</th>
              <th class="py-3.5 px-4">Category</th>
              <th class="py-3.5 px-4">Price</th>
              <th class="py-3.5 px-4">Inventory</th>
              <th class="py-3.5 px-4">Tag</th>
              <th class="py-3.5 px-4 sm:px-6 text-right">Actions</th>
            </tr>
          </thead>
          <% if (products && products.length > 0) { %>
          <!-- Table Body -->
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-xs sm:text-sm font-medium">
            <% products.forEach(function(product) { %>
            <tr class="product-item hover:bg-slate-50/80 dark:hover:bg-slate-800/40 hover:transition-colors hover:ease-out hover:duration-150" id="product-<%= product._id %>" data-category="<%= product.category %>" data-title="<%= product.name %>" data-sku="<%= product.sku %>" data-stock="<%= product.stockQuantity %>">
              <!-- Product Details: Image + Title + SKU -->
              <td class="py-4 px-4 sm:px-6 text-left">
                <div class="flex items-center gap-3.5">
                  <div class="bg-slate-100 dark:bg-slate-800 h-12 w-12 border border-slate-200 dark:border-slate-700/60 rounded-xl flex-shrink-0 overflow-hidden">
                    <img class="w-full h-full object-contain hover:scale-105 transition-transform ease-out duration-300" src="<%= product.image %>" alt="<%= product.name %>" />
                  </div>
                  <div class="min-w-0 max-w-xs sm:max-w-sm">
                    <span class="text-slate-900 dark:text-white font-inter font-semibold block truncate mb-0.5" title="<%= product.name %>">
                      <%= product.name %>
                    </span>
                    <span class="text-slate-400 text-[0.6875rem] font-mono">
                      SKU: <%= product.sku %>
                    </span>
                  </div>
                </div>
              </td>
              <!-- Category Badge -->
              <td class="py-4 px-4">
                <span class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-inter font-semibold capitalize rounded-lg py-1 px-2.5">
                  <%= product.category %>
                </span>
              </td>
              <!-- Price Column -->
              <td class="py-4 px-4">
                <span class="text-slate-900 dark:text-white font-montserrat font-bold truncate block">
                  Rs. <%= product.currentPrice.toLocaleString() %>
                </span>
                <% if (product.originalPrice && product.originalPrice > product.currentPrice) { %>
                <span class="text-slate-400 text-[0.6875rem] font-montserrat line-through truncate">
                  Rs. <%= product.originalPrice.toLocaleString() %>
                </span>
                <% } %>
              </td>
              <!-- Inventory Stock -->
              <td class="py-4 px-4">
                <% 
                    const qty = product.stockQuantity || 0;
                    let stockPill = 'bg-emerald-100 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800';
                    let stockText = qty + ' in stock';
                    if (qty === 0) {
                      stockPill = 'bg-rose-100 dark:bg-rose-950/70 text-rose-800 dark:text-rose-300 border-rose-300 dark:border-rose-800';
                      stockText = 'Out of Stock';
                    } else if (qty <= 5) {
                      stockPill = 'bg-amber-100 dark:bg-amber-950/70 text-amber-800 dark:text-amber-300 border-amber-300 dark:border-amber-800';
                      stockText = qty + ' low stock';
                    }
                  %>
                <span class="text-xs font-inter font-semibold truncate inline-flex items-center gap-1.5 border rounded-full py-1 px-2.5 <%= stockPill %>">
                  <span class="bg-current h-1.5 w-1.5 rounded-full"></span>
                  <%= stockText %>
                </span>
              </td>
              <!-- Promo Tag -->
              <td class="py-4 px-4">
                <% if (product.tag) { %>
                <span class="bg-orange-100 dark:bg-orange-950 text-orange-700 dark:text-orange-400 text-[0.6875rem] font-inter font-bold truncate rounded-md py-0.5 px-2">
                  <%= product.tag %>
                </span>
                <% } else { %>
                <span class="text-slate-400 text-xs font-inter">---</span>
                <% } %>
              </td>
              <!-- Actions -->
              <td class="py-4 px-4 sm:px-6 text-right">
                <div class="flex items-center gap-x-1.5 justify-end">
                  <!-- Quick Edit -->
                  <a class="text-slate-600 dark:text-slate-400 rounded-xl p-2 hover:bg-orange-50 dark:hover:bg-orange-950/40 hover:text-orange-600 transition ease-out duration-200" href="/admin/product-edit/<%= product._id %>?editing=true">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                  </a>
                  <!-- View Live Product / PDP -->
                  <a class="text-slate-600 dark:text-slate-400 rounded-xl p-2 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition ease-out duration-200" href="/category/<%= product.category %>/<%= product.sku %>" target="_blank">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                  <!-- Delete Button -->
                  <button class="openTrigger text-slate-400 rounded-xl cursor-pointer p-2 hover:bg-rose-50 dark:hover:bg-rose-950/40 hover:text-rose-600 transition ease-out duration-200" type="button" data-model="deleteModel" data-product-id="<%= product._id %>" data-product-name="<%= product.name %>">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
          <% }else { %>
          <!-- ==================== 5. EMPTY Catalog ==================== -->
          <div class="py-10 sm:py-12 text-center space-y-3" id="empty">
            <div class="bg-orange-100 dark:bg-orange-950/60 text-orange-600 dark:text-orange-400 h-16 w-16 flex items-center justify-center mx-auto rounded-2xl mb-4.5">
              <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
            </div>
            <h3 class="text-slate-900 dark:text-white text-base sm:text-lg font-montserrat font-bold leading-none">Products Not Found</h3>
            <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm font-inter max-w-sm mx-auto mb-4.5">
              Your product catalog is empty. Add your first product to start selling.
            </p>
            <a class="bg-orange-600 text-white inline-flex items-center gap-x-1.5 rounded-xl cursor-pointer py-2.5 px-4 hover:bg-orange-700 transition ease-out duration-[250ms]" href="/admin/product-add">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              <span class="text-xs font-montserrat font-semibold">Add First Product</span>
            </a>
          </div>
          <% } %>
        </table>
        <!-- ==================== 6. EMPTY SEARCH STATE ==================== -->
        <div class="py-10 sm:py-12 text-center space-y-3 hidden" id="no-matches">
          <div class="bg-orange-50 dark:bg-orange-500/10 h-16 w-16 text-orange-600 text-2xl mx-auto flex items-center justify-center rounded-2xl mb-4">
            🔍
          </div>
          <h3 class="text-slate-900 dark:text-white text-base sm:text-lg font-montserrat font-bold leading-none">No Matching Products</h3>
          <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm font-inter max-w-sm mx-auto mb-4.5">
            Try clearing your search query or selecting a different category filter.
          </p>
          <button class="clearFilterBtn bg-orange-600 text-white text-sm font-montserrat font-semibold inline-flex items-center gap-x-1.5 rounded-xl cursor-pointer py-2.5 px-4 hover:bg-orange-700 transition ease-out duration-[250ms]">
            Reset All Filters
          </button>
        </div>
        <!-- Table Footer / Pagination -->
        <div class="bg-slate-50/50 dark:bg-slate-800/30 flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-slate-200 dark:border-slate-800 p-4 sm:p-5">
          <span class="text-slate-500 text-xs font-inter">Showing <strong class="text-slate-900 dark:text-white" id="items-count"><%= products.length %></strong>
            <span id="countText"><%= products.length > 1 ? 'Items' : 'Item' %></span>
          </span>
          <div class="flex items-center gap-x-2">
            <button class="text-slate-500 text-xs font-montserrat border border-slate-200 dark:border-slate-700 rounded-lg cursor-pointer py-1.5 px-3 hover:bg-white dark:hover:bg-slate-800 hover:transition-colors disabled:opacity-50" disabled>Previous</button>
            <span class="bg-orange-600 text-white text-xs font-montserrat font-bold rounded-lg py-1.5 px-3">1</span>
            <button class="text-slate-500 text-xs font-montserrat border border-slate-200 dark:border-slate-700 rounded-lg cursor-pointer py-1.5 px-3 hover:bg-white dark:hover:bg-slate-800 hover:transition-colors disabled:opacity-50" disabled>Next</button>
          </div>
        </div>
      </div>
    </section>
    <!-- ==================== 7. DELETE CONFIRMATION MODEL ==================== -->
    <div class="bg-slate-950/60 backdrop-blur-sm fixed inset-0 flex items-center justify-center p-4 z-50 hidden" id="deleteModel">
      <div class="bg-white dark:bg-slate-900 w-full max-w-md border border-slate-200 dark:border-slate-800 rounded-3xl shadow-2xl text-center space-y-4 p-6">
        <div class="bg-rose-100 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 h-14 w-14 mx-auto flex items-center justify-center rounded-2xl">
          <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div class="space-y-1.5">
          <h3 class="text-slate-900 dark:text-white text-lg font-extrabold font-montserrat leading-none">Delete Product?</h3>
          <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">
            <strong id="prdctNameTxt"></strong> Are you sure you want to remove this product from the store catalog?
          </p>
        </div>
        <div class="flex items-center justify-center gap-3">
          <button class="cancelTrigger text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold w-1/2 border border-slate-200 dark:border-slate-700 cursor-pointer rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 py-2.5 hover:transition-colors hover:ease-out hover:duration-[250ms]" type="button">
            Cancel
          </button>
          <button class="bg-rose-600 text-white flex items-center gap-x-1.5 justify-center shadow-md shadow-rose-600/20 rounded-xl cursor-pointer w-1/2 py-2.5 hover:bg-rose-700 transition ease-out duration-[250ms]" id="prdctDeleteBtn" type="button">
            <span class="Spinner h-3.5 w-3.5 border-[3px] border-white border-t-rose-500 shrink-0 rounded-full animate-spin drop-shadow-[0_0_4px_rgba(249,115,22,0.6)] hidden"></span>
            <span class="Text text-xs font-montserrat font-semibold">Yes, Delete</span>
          </button>
        </div>
      </div>
    </div>
  </main>
