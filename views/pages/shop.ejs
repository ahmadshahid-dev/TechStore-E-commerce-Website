<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shop Tech Catalog | TechStore</title>
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 antialiased selection:bg-orange-500 selection:text-white">
  <!-- Header -->
  <%- include("../partials/header") %>
  <!-- Main -->
  <main>
    <!-- Big Hero Shop Banner -->
    <section class="bg-gradient-to-b from-orange-50/50 via-white to-slate-50 dark:from-slate-900 dark:via-slate-900/90 dark:to-slate-950 relative py-12 sm:py-14 lg:py-18">
      <!-- Ambient Glowing Aura -->
      <div class="bg-orange-500/10 dark:bg-orange-500/15 h-96 w-96 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 blur-3xl rounded-full pointer-events-none"></div>
      <div class="relative max-w-7xl mx-auto text-center px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-x-2 mb-4">
          <a class="text-slate-500 dark:text-slate-400 text-xs font-inter font-medium hover:text-orange-600 dark:hover:text-orange-500" href="/">Home</a>
          <svg class="text-slate-400 h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-slate-800 dark:text-slate-200 text-xs font-inter font-semibold">Store Catalog</span>
        </nav>
        <!-- Banner Badge -->
        <div class="bg-orange-100 dark:bg-orange-500/10 text-orange-700 dark:text-orange-400 inline-flex items-center gap-x-2 border border-orange-200/60 dark:border-orange-500/20 rounded-full py-1.5 px-4 mb-4">
          <span class="bg-orange-600 dark:bg-orange-400 h-2 w-2 rounded-full animate-pulse"></span>
          <span class="text-xs font-montserrat font-bold uppercase tracking-widest">Official TechStore Collection</span>
        </div>
        <!-- Main Hero Title -->
        <h1 class="text-slate-900 dark:text-slate-100 text-3xl sm:text-5xl font-montserrat font-extrabold tracking-tight max-w-3xl mx-auto mb-3.5">
          Discover Premium Tech <span class="text-orange-600 dark:text-orange-400">Gear & Accessories</span>
        </h1>
        <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base font-inter leading-relaxed max-w-xl sm:max-w-2xl mx-auto mb-8">
          Upgrade your setup with official gaming keyboards, wireless headphones, precision mice, and premium audio equipment backed by official warranty.
        </p>
        <!-- Quick In-Banner Search Bar -->
        <form class="search-form relative max-w-xl mx-auto" id="shopSrchForm" role="search" data-search="search-shop" data-suggestions="suggestionsList-shop" aria-label="Site Search">
          <input class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 w-full 
          text-sm font-inter font-medium border border-slate-200 dark:border-slate-800 focus:ring focus:ring-orange-500/20 focus:border-orange-500 outline-none rounded-2xl shadow-sm py-3.5 pl-11 pr-28" id="search-shop" type="text" name="search" value="<%= search || '' %>" autocomplete="off" placeholder="Search products by name or category..." />
          <svg class="text-slate-400 h-5 w-5 absolute left-4 top-1/2 -translate-y-1/2 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <button class="bg-orange-600 text-white text-xs font-montserrat font-bold absolute top-1/2 right-2 -translate-y-1/2 rounded-xl shadow-md shadow-orange-600/20 cursor-pointer py-2 px-4 hover:bg-orange-700 transition-colors" type="submit">
            Search
          </button>
          <!-- Search Suggestions Dropdown -->
          <ul class="bg-white dark:bg-slate-900/95 w-full absolute top-full left-0 border border-slate-200/80 dark:border-slate-800/80 rounded-2xl shadow-xl dark:shadow-2xl z-50 py-3.5 hidden" id="suggestionsList-shop" role="listbox"></ul>
        </form>
      </div>
    </section>
    <!-- Shop Products & Filtration Catalog -->
    <section class="border-t border-slate-200/80 dark:border-slate-800 py-8 sm:py-10 lg:py-12 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Category Quick Filter Chips -->
        <div class="flex items-center gap-2 no-scrollbar overflow-x-auto border-b border-slate-200 dark:border-slate-800 pb-6 mb-6">
          <button class="category-chip active-chip bg-orange-600 text-white text-xs font-montserrat font-bold whitespace-nowrap rounded-xl cursor-pointer shadow-md shadow-orange-600/20 py-2 px-4 hover:transition hover:ease-out hover:duration-[250ms]" data-category="All">
            All Products
          </button>
          <button class="category-chip bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold whitespace-nowrap cursor-pointer border border-slate-200 dark:border-slate-800 rounded-xl py-2 px-4 hover:bg-slate-100 dark:hover:bg-slate-800 hover:transition hover:ease-out hover:duration-[250ms]" data-category="headphones">
            🎧 Headphones
          </button>
          <button class="category-chip bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold whitespace-nowrap cursor-pointer border border-slate-200 dark:border-slate-800 rounded-xl py-2 px-4 hover:bg-slate-100 dark:hover:bg-slate-800 hover:transition hover:ease-out hover:duration-[250ms]" data-category="keyboards">
            ⌨️ Keyboards
          </button>
          <button class="category-chip bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold whitespace-nowrap cursor-pointer border border-slate-200 dark:border-slate-800 rounded-xl py-2 px-4 hover:bg-slate-100 dark:hover:bg-slate-800 hover:transition hover:ease-out hover:duration-[250ms]" data-category="mice">
            🖱️ Mice & Controls
          </button>
        </div>
        <!-- Controls Toolbar (Left: Count | Right: Category Select & Sort) -->
        <div class="flex items-center justify-between gap-4 mb-8">
          <!-- Left Side: Product Count -->
          <div class="flex items-center gap-x-2.5">
            <span class="bg-orange-600 h-3 w-3 rounded-full animate-pulse hidden sm:block"></span>
            <span class="text-slate-700 dark:text-slate-300 text-sm font-inter font-semibold">
              Showing <span id="items-count" class="font-bold text-slate-900 dark:text-slate-100"><%= products ? products.length : 0 %></span> <span id="countText"><%= products.length > 1 ? 'Items' : 'Item' %></span>
            </span>
          </div>
          <!-- Sorting Selector -->
          <select class="bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-xs font-montserrat font-semibold border border-slate-200 dark:border-slate-800 focus:ring focus:ring-orange-500/20 outline-none rounded-xl cursor-pointer py-2.5 px-3.5" id="sort-select">
            <option value="default">Sort by: Default</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
            <option value="name">Name: A to Z</option>
          </select>
        </div>
        <!-- Catalog Products Grid -->
        <% if (products && products.length > 0) { %>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6" id="content-container">
          <% products.forEach((product) => { %>
          <div class="product-item" data-category="<%= product.category %>" data-name="<%= product.name %>" data-price="<%= product.currentPrice %>">
            <%- include("../partials/product", { product }) %>
          </div>
          <% }) %>
        </div>
        <!-- Empty Filter State (Shown when search/filter returns 0 matches) -->
        <div class="hidden text-center max-w-md mx-auto py-5" id="no-matches">
          <div class="bg-orange-50 dark:bg-orange-500/10 h-16 w-16 text-orange-600 text-2xl mx-auto flex items-center justify-center rounded-2xl mb-4">
            🔍
          </div>
          <h3 class="text-slate-900 dark:text-slate-100 text-xl font-montserrat font-bold leading-none my-2.5">No Matching Products</h3>
          <p class="text-slate-500 dark:text-slate-400 text-sm font-inter leading-relaxed mb-5">Try clearing your search query or selecting a different category filter.</p>
          <button class="bg-orange-600 text-white text-sm font-montserrat font-semibold rounded-xl shadow-sm cursor-pointer py-3 px-6 hover:bg-orange-700 transition ease-out duration-[250ms]" id="clearFilterBtn">
            Reset All Filters
          </button>
        </div>
        <% } else { %>
        <!-- Catalog Empty State -->
        <div class="max-w-md mx-auto text-center space-y-4 py-5">
          <div class="bg-orange-50 dark:bg-orange-950/35 w-20 h-20 border border-gray-200 dark:border-gray-800 rounded-2xl mx-auto flex items-center justify-center">
            <svg class="text-orange-600 dark:text-orange-400 w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
          </div>
          <h3 class="text-slate-900 dark:text-slate-100 text-xl font-montserrat font-bold pt-0.5 mb-2.5">
            No Products Available
          </h3>
          <p class="text-slate-500 dark:text-slate-400 text-sm font-inter leading-relaxed mb-5">
            Our catalog is currently being updated with new hardware inventory. Check back shortly or browse our homepage.
          </p>
          <a class="bg-orange-600 text-white inline-flex text-sm font-montserrat font-semibold py-3.5 px-6 rounded-xl shadow-md hover:bg-orange-700 transition ease-out duration-[250ms]" href="/">
            Return To Homepage
          </a>
        </div>
        <% } %>
      </div>
    </section>
  </main>
  <!-- Footer -->
  <%- include("../partials/footer") %>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/user.js"></script>
</body>

</html>