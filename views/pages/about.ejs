<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Learn more about TechStore – your trusted destination for premium tech accessories including headphones, keyboards, and gaming gear." />
  <meta name="keywords" content="About TechStore, tech store mission, gaming accessories, mechanical keyboards" />
  <title>About Us | TechStore</title>
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100
antialiased selection:bg-orange-500 selection:text-white">
  <!-- Header -->
  <%- include("../partials/header") %>
  <main>
    <!-- ==================== 1. HERO / INTRO SECTION ==================== -->
    <section class="relative border-b border-slate-200/80 dark:border-slate-800/80
    py-16 overflow-hidden">
      <!-- Ambient Background Glow -->
      <div class="bg-orange-500/10 w-96 h-96 absolute -top-24 left-1/2 -translate-x-1/2 rounded-full blur-3xl pointer-events-none"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-3xl mx-auto text-center space-y-4">
          <!-- Badge -->
          <div class="bg-orange-50 dark:bg-orange-950/40 border border-orange-200 dark:border-orange-900/60 shadow-sm inline-flex items-center gap-2 py-2 px-3.5 rounded-full">
            <span class="bg-orange-500 h-2 w-2 rounded-full animate-pulse"></span>
            <span class="text-orange-600 dark:text-orange-400 text-xs font-montserrat font-bold uppercase tracking-wider">
              Built For Tech Lovers
            </span>
          </div>
          <!-- Main Heading -->
          <h1 class="text-slate-900 dark:text-white text-3xl sm:text-4xl lg:text-5xl font-montserrat font-extrabold tracking-tight">
            We Empower Your Digital
            <span class="text-orange-600 dark:text-orange-400">Lifestyle</span>
          </h1>
          <!-- Intro Paragraph -->
          <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base font-inter leading-relaxed max-w-2xl mx-auto pb-2.5">
            Premium tech accessories designed for exceptional performance and modern style.
            Upgrade your setup with quality you can trust and reliability you deserve.
          </p>
          <!-- Stat Badges -->
          <div class="max-w-lg mx-auto grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-5">
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm rounded-xl p-3">
              <span class="text-orange-600 dark:text-orange-400 text-xl font-montserrat font-extrabold block">
                2026
              </span>
              <span class="text-slate-500 dark:text-slate-400 text-xs font-inter font-medium">
                Founded Year
              </span>
            </div>
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm rounded-xl p-3">
              <span class="text-slate-900 dark:text-white text-xl font-montserrat font-extrabold block">
                100%
              </span>
              <span class="text-slate-500 dark:text-slate-400 text-xs font-inter font-medium">
                Genuine Tech
              </span>
            </div>
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm rounded-xl p-3 col-span-2 sm:col-span-1">
              <span class="text-emerald-600 dark:text-emerald-400 text-xl font-montserrat font-extrabold block">
                24/7
              </span>
              <span class="text-slate-500 dark:text-slate-400 text-xs font-inter font-medium">
                Customer Care
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- ==================== 2. OUR STORY SECTION ==================== -->
    <section class="border-b border-slate-200/80 dark:border-slate-800/80 py-8
    sm:py-10 lg:py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto space-y-10">
          <!-- Story Header & Text -->
          <div class="space-y-4">
            <div class="space-y-1.5">
              <span class="text-orange-600 dark:text-orange-400 text-xs font-montserrat font-bold uppercase tracking-wider block">
                Behind The Brand
              </span>
              <h2 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-bold leading-none">
                Our
                <span class="text-orange-600 dark:text-orange-400">Story</span>
              </h2>
            </div>
            <div class="space-y-4">
              <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base font-inter leading-relaxed">
                At
                <strong class="text-slate-900 dark:text-white font-semibold">TechStore</strong>
                , we specialize in high-performance computer peripherals and everyday tech
                essentials. Whether you are an esports competitor, creative professional, student,
                or casual gamer, our catalog is curated to elevate speed, precision, and comfort.
              </p>
              <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base font-inter leading-relaxed">
                TechStore was founded with a single passion: to bridge the gap between premium
                international quality and accessible pricing. We set out to create a modern,
                frictionless shopping destination where buyers never have to worry about
                counterfeit products or delayed support.
              </p>
            </div>
          </div>
          <!-- Mission & Vision Cards Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
            <!-- Card 1: Mission -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm hover:shadow-lg hover:dark:shadow-2xl relative p-6 sm:p-8 transition-shadow ease-in-out duration-300 overflow-hidden group">
              <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 h-12 w-12 flex items-center justify-center rounded-xl mb-4 group-hover:scale-110 transition-transform ease-out duration-300">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="text-slate-900 dark:text-white text-lg font-montserrat font-bold mb-1.5">
                Our Mission
              </h3>
              <p class="text-slate-600 dark:text-slate-400 text-sm font-inter leading-relaxed">
                To provide authentic, performance-tested tech gear with transparent pricing,
                instant customer support, and a secure checkout experience.
              </p>
            </div>
            <!-- Card 2: Vision -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm hover:shadow-lg hover:dark:shadow-2xl relative p-6 sm:p-8 transition-shadow ease-in-out duration-300 overflow-hidden group">
              <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 h-12 w-12 flex items-center justify-center rounded-xl mb-4 group-hover:scale-110 transition-transform ease-out duration-300">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </div>
              <h3 class="text-slate-900 dark:text-white text-lg font-montserrat font-bold mb-1.5">
                Our Vision
              </h3>
              <p class="text-slate-600 dark:text-slate-400 text-sm font-inter leading-relaxed">
                To become the most reliable and customer-first gaming & tech accessory provider by
                continuously setting benchmarks in quality, trust, and speed.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- ==================== 3. CORE VALUES SECTION ==================== -->
    <section class="bg-white/50 dark:bg-slate-900/40 border-b border-slate-200/80
    dark:border-slate-800/80 py-8 sm:py-10 lg:py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
          <span class="text-orange-600 dark:text-orange-400 text-xs font-montserrat font-bold uppercase tracking-wider block mb-1.5">
            What Drives Us
          </span>
          <h2 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-bold leading-none">
            Our Core
            <span class="text-orange-600 dark:text-orange-400">Values</span>
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
          <!-- Value 1 -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-6 rounded-2xl">
            <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 w-8 h-8 text-sm font-montserrat font-bold flex items-center justify-center rounded-lg mb-4">
              01
            </div>
            <h4 class="text-slate-900 dark:text-white text-base font-montserrat font-bold leading-none mb-2">
              Zero Counterfeits
            </h4>
            <p class="text-slate-500 dark:text-slate-400 text-xs font-inter leading-relaxed">
              Every unit in our inventory is original, backed by official brand warranties.
            </p>
          </div>
          <!-- Value 2 -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-6 rounded-2xl">
            <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 w-8 h-8 text-sm font-montserrat font-bold flex items-center justify-center rounded-lg mb-4">
              02
            </div>
            <h4 class="text-slate-900 dark:text-white text-base font-montserrat font-bold leading-none mb-2">
              Fair Pricing
            </h4>
            <p class="text-slate-500 dark:text-slate-400 text-xs font-inter leading-relaxed">
              We offer competitive market rates with no hidden fees or surprise shipping costs.
            </p>
          </div>
          <!-- Value 3 -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-6 rounded-2xl">
            <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 w-8 h-8 text-sm font-montserrat font-bold flex items-center justify-center rounded-lg mb-4">
              03
            </div>
            <h4 class="text-slate-900 dark:text-white text-base font-montserrat font-bold leading-none mb-2">
              Fast Handling
            </h4>
            <p class="text-slate-500 dark:text-slate-400 text-xs font-inter leading-relaxed">
              Quick order dispatch and real-time courier tracking right to your doorstep.
            </p>
          </div>
          <!-- Value 4 -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-6 rounded-2xl">
            <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 w-8 h-8 text-sm font-montserrat font-bold flex items-center justify-center rounded-lg mb-4">
              04
            </div>
            <h4 class="text-slate-900 dark:text-white text-base font-montserrat font-bold leading-none mb-2">
              Community First
            </h4>
            <p class="text-slate-500 dark:text-slate-400 text-xs font-inter leading-relaxed">
              We listen to gamer and developer feedback to stock the gear you care.
            </p>
          </div>
        </div>
      </div>
    </section>
    <!-- ==================== 4. CALL TO ACTION CARD ==================== -->
    <section class="backdrop-blur-md py-8 sm:py-10 lg:py-12 overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-gradient-to-br from-slate-900 via-slate-900 to-slate-950 text-white text-center border border-slate-800 rounded-3xl shadow-2xl relative p-8 sm:p-12 overflow-hidden">
          <!-- Background decoration -->
          <div class="bg-orange-500/10 w-64 h-64 absolute -bottom-16 -right-16 rounded-full blur-2xl pointer-events-none"></div>
          <div class="space-y-4 relative z-10">
            <h2 class="text-2xl sm:text-3xl font-montserrat font-extrabold leading-tight md:leading-none tracking-tight">
              Ready to Upgrade Your
              <span class="text-orange-400">Battlestation?</span>
            </h2>
            <p class="text-slate-300 text-xs sm:text-sm font-inter leading-relaxed max-w-md mx-auto">
              Discover top-rated mechanical keyboards, high-precision mice, and immersive
              headphones today.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-1.5">
              <a class="bg-orange-600 text-white w-full sm:w-auto text-xs sm:text-sm font-montserrat font-semibold py-3.5 px-8 rounded-xl hover:bg-orange-700 active:scale-95 shadow-lg shadow-orange-500/25 transition ease-out duration-[250ms]" href="/shop">
                Explore Products
              </a>
              <a class="bg-white/10 text-white w-full sm:w-auto text-xs sm:text-sm font-montserrat font-semibold py-3.5 px-8 rounded-xl border border-white/20 backdrop-blur-md hover:bg-white/20" href="/contact">
                Contact Us
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <!-- Footer -->
  <%- include("../partials/footer") %>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>