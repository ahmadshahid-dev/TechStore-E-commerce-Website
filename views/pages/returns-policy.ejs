<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Returns & Refund Policy | TechStore</title>
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 antialiased selection:bg-orange-500 selection:text-white">
  <!-- Header -->
  <%- include("../partials/header") %>
  <!-- Main -->
  <main>
    <div class="max-w-7xl mx-auto py-8 sm:py-10 lg:py-12 px-4 sm:px-6 lg:px-8">
      <!-- Page Header Banner -->
      <div class="max-w-3xl mx-auto text-center space-y-4 mb-8 sm:mb-10">
        <!-- Bg Glow -->
        <div class="bg-orange-500/10 h-72 w-72 sm:h-96 sm:w-96 absolute -top-24 left-1/2 -translate-x-1/2 rounded-full blur-3xl pointer-events-none"></div>
        <div class="bg-orange-100 text-orange-700 dark:bg-orange-500/10 dark:text-orange-400 text-xs font-montserrat font-bold uppercase tracking-widest inline-flex items-center gap-2 border border-orange-200/60 dark:border-orange-500/20 rounded-full py-1.5 px-4">
          <span class="bg-orange-600 dark:bg-orange-400 h-2 w-2 rounded-full"></span>
          30-Day Money-Back Guarantee
        </div>
        <h1 class="text-slate-900 dark:text-white text-3xl sm:text-5xl font-montserrat font-extrabold tracking-tight">
          Returns & Refund <span class="text-orange-600 dark:text-orange-400">Policy</span>
        </h1>
        <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm font-inter max-w-xl mx-auto">
          Hassle-free 30-day returns, fast refunds, and full coverage for defective hardware.
        </p>
      </div>
      <!-- 2-Column Content Layout (Left: Sticky TOC Sidebar | Right: Policy Content) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Sticky Table of Contents Sidebar -->
        <div class="lg:col-span-4 lg:sticky lg:top-24">
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-sm p-6">
            <h2 class="text-slate-400 text-xs font-inter font-bold uppercase tracking-wider border-b border-slate-100 dark:border-slate-800 pb-2.5 mb-4">
              Policy Sections
            </h2>
            <nav class="flex flex-col gap-y-1">
              <a class="text-slate-600 dark:text-slate-400 text-xs font-inter font-semibold rounded-xl py-2.5 px-3 hover:bg-orange-50 dark:hover:bg-slate-800 hover:text-orange-600 dark:hover:text-orange-400 hover:transition-colors" href="#return-eligibility">
                1. 30-Day Return Window
              </a>
              <a class="text-slate-600 dark:text-slate-400 text-xs font-inter font-semibold rounded-xl py-2.5 px-3 hover:bg-orange-50 dark:hover:bg-slate-800 hover:text-orange-600 dark:hover:text-orange-400 hover:transition-colors" href="#return-exclusions">
                2. Non-Returnable Items
              </a>
              <a class="text-slate-600 dark:text-slate-400 text-xs font-inter font-semibold rounded-xl py-2.5 px-3 hover:bg-orange-50 dark:hover:bg-slate-800 hover:text-orange-600 dark:hover:text-orange-400 hover:transition-colors" href="#how-to-return">
                3. How to Initiate a Return
              </a>
              <a class="text-slate-600 dark:text-slate-400 text-xs font-inter font-semibold rounded-xl py-2.5 px-3 hover:bg-orange-50 dark:hover:bg-slate-800 hover:text-orange-600 dark:hover:text-orange-400 hover:transition-colors" href="#refund-timelines">
                4. Refund Timelines & Methods
              </a>
              <a class="text-slate-600 dark:text-slate-400 text-xs font-inter font-semibold rounded-xl py-2.5 px-3 hover:bg-orange-50 dark:hover:bg-slate-800 hover:text-orange-600 dark:hover:text-orange-400 hover:transition-colors" href="#damaged-defective">
                5. Damaged or Wrong Items
              </a>
              <a class="text-slate-600 dark:text-slate-400 text-xs font-inter font-semibold rounded-xl py-2.5 px-3 hover:bg-orange-50 dark:hover:bg-slate-800 hover:text-orange-600 dark:hover:text-orange-400 hover:transition-colors" href="#warranty-claims">
                6. Official Warranty Claims
              </a>
              <a class="text-slate-600 dark:text-slate-400 text-xs font-inter font-semibold rounded-xl py-2.5 px-3 hover:bg-orange-50 dark:hover:bg-slate-800 hover:text-orange-600 dark:hover:text-orange-400 hover:transition-colors" href="#contact-returns">
                7. Contact Return Support
              </a>
            </nav>
            <!-- Initiate Return CTA Box -->
            <div class="border-t border-slate-100 dark:border-slate-800 text-center pt-6 mt-6">
              <p class="text-slate-500 text-xs font-inter mb-3">Need to return an item right now?</p>
              <a class="bg-orange-600 text-white w-full text-xs font-montserrat font-semibold inline-flex items-center justify-center rounded-xl shadow-md shadow-orange-600/20 py-2.5 px-4 hover:bg-orange-700 transition-colors ease-out duration-[250ms]" href="/contact">
                Start a Return Request
              </a>
            </div>
          </div>
        </div>
        <!-- Main Policy Document Body -->
        <div class="lg:col-span-8 space-y-8">
          <!-- Intro Card -->
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-sm p-6 sm:p-8">
            <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm font-inter leading-relaxed">
              At <strong class="text-slate-900 dark:text-white">TechStore</strong>, customer satisfaction is our top priority. If you are not completely satisfied with your hardware purchase, we offer a straightforward 30-day return policy to ensure a smooth, worry-free shopping experience.
            </p>
          </div>
          <!-- Section 1 -->
          <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-4 rounded-3xl shadow-sm p-6 sm:p-8 scroll-mt-28" id="return-eligibility">
            <div class="flex items-center gap-x-3 border-b border-slate-100 dark:border-slate-800 pb-3">
              <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-8 w-8 text-sm font-inter font-bold flex items-center justify-center rounded-xl">
                1
              </div>
              <h2 class="text-slate-900 dark:text-white text-base sm:text-lg font-montserrat font-bold sm:leading-none flex-1">
                30-Day Return Window & Eligibility
              </h2>
            </div>
            <div class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm font-inter leading-relaxed space-y-3">
              <p>To qualify for a full refund or exchange under our 30-day policy:</p>
              <ul class="text-slate-700 dark:text-slate-300 list-disc space-y-1.5 pl-5">
                <li>Items must be returned within <strong>30 days of delivery receipt</strong>.</li>
                <li>Products must be in unused, like-new condition with original factory packaging and seals.</li>
                <li>All original included accessories (cables, manuals, dongles, and warranty cards) must be included.</li>
                <li>Proof of purchase (order number or digital receipt) is required.</li>
              </ul>
            </div>
          </section>
          <!-- Section 2 -->
          <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-4 rounded-3xl shadow-sm p-6 sm:p-8 scroll-mt-28" id="return-exclusions">
            <div class="flex items-center gap-x-3 border-b border-slate-100 dark:border-slate-800 pb-3">
              <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-8 w-8 text-sm font-inter font-bold flex items-center justify-center rounded-xl">
                2
              </div>
              <h2 class="text-slate-900 dark:text-white text-base sm:text-lg font-montserrat font-bold sm:leading-none flex-1">
                Non-Returnable Items & Exceptions
              </h2>
            </div>
            <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm font-inter leading-relaxed">
              The following items cannot be returned unless delivered in a damaged or defective condition:
            </p>
            <ul class="list-disc text-slate-700 dark:text-slate-300 text-xs sm:text-sm font-inter space-y-1.5 pl-5">
              <li>Downloadable software licenses, digital gift cards, or redeemable product keys.</li>
              <li>Products showing signs of accidental physical damage, liquid exposure, or unauthorized modification.</li>
              <li>Items purchased during clearance or flash sale events explicitly marked as "Final Sale".</li>
            </ul>
          </section>
          <!-- Section 3 -->
          <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-4 rounded-3xl shadow-sm p-6 sm:p-8 scroll-mt-28" id="how-to-return">
            <div class="flex items-center gap-x-3 border-b border-slate-100 dark:border-slate-800 pb-3">
              <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-8 w-8 text-sm font-inter font-bold flex items-center justify-center rounded-xl">
                3
              </div>
              <h2 class="text-slate-900 dark:text-white text-base sm:text-lg font-montserrat font-bold sm:leading-none flex-1">
                How to Initiate a Return (Step-by-Step)
              </h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <div class="bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-800 rounded-2xl p-4">
                <span class="text-orange-600 dark:text-orange-400 text-xs font-inter font-bold mb-1 block">Step 1: Submit Request</span>
                <p class="text-slate-600 dark:text-slate-400 text-xs font-inter leading-relaxed">Log into your account, select your order, and click "Request Return" to generate a return shipping label.</p>
              </div>
              <div class="bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-800 rounded-2xl p-4">
                <span class="text-orange-600 dark:text-orange-400 text-xs font-inter font-bold mb-1 block">Step 2: Pack Securely</span>
                <p class="text-slate-600 dark:text-slate-400 text-xs font-inter leading-relaxed">Pack the hardware safely in its original box with all included accessories and drop it off at a courier station.</p>
              </div>
            </div>
          </section>
          <!-- Section 4 -->
          <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-4 rounded-3xl shadow-sm p-6 sm:p-8 scroll-mt-28" id="refund-timelines">
            <div class="flex items-center gap-x-3 border-b border-slate-100 dark:border-slate-800 pb-3">
              <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-8 w-8 text-sm font-inter font-bold flex items-center justify-center rounded-xl">
                4
              </div>
              <h2 class="text-slate-900 dark:text-white text-base sm:text-lg font-montserrat font-bold sm:leading-none flex-1">
                Refund Timelines & Payment Processing
              </h2>
            </div>
            <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm font-inter leading-relaxed">
              Once your returned package arrives at our quality inspection warehouse:
            </p>
            <ul class="text-slate-700 dark:text-slate-300 text-xs sm:text-sm font-inter list-disc space-y-1.5 pl-5">
              <li>Inspection takes <strong>1 to 2 business days</strong> upon package arrival.</li>
              <li>Approved refunds are issued to your original payment method within <strong>3 to 5 business days</strong>.</li>
              <li>Store Credit refunds are credited instantly to your TechStore wallet balance.</li>
            </ul>
          </section>
          <!-- Section 5 -->
          <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-4 rounded-3xl shadow-sm p-6 sm:p-8 scroll-mt-28" id="damaged-defective">
            <div class="flex items-center gap-x-3 border-b border-slate-100 dark:border-slate-800 pb-3">
              <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-8 w-8 text-sm font-inter font-bold flex items-center justify-center rounded-xl">
                5
              </div>
              <h2 class="text-slate-900 dark:text-white text-base sm:text-lg font-montserrat font-bold sm:leading-none flex-1">
                Damaged, Defective, or Wrong Items Sent
              </h2>
            </div>
            <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm font-inter leading-relaxed">
              If your order arrives damaged during transit or contains a defective hardware component:
            </p>
            <div class="bg-emerald-50/50 dark:bg-emerald-500/10 border border-emerald-200/60 dark:border-emerald-500/20 text-emerald-800 dark:text-emerald-300 text-xs sm:text-sm font-inter rounded-2xl p-4">
              TechStore covers 100% of return shipping fees for defective or damaged items. Contact support within 48 hours of delivery for an immediate free replacement.
            </div>
          </section>
          <!-- Section 6 -->
          <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-4 rounded-3xl shadow-sm p-6 sm:p-8 scroll-mt-28" id="warranty-claims">
            <div class="flex items-center gap-x-3 border-b border-slate-100 dark:border-slate-800 pb-3">
              <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-8 w-8 text-sm font-inter font-bold flex items-center justify-center rounded-xl">
                6
              </div>
              <h2 class="text-slate-900 dark:text-white text-base sm:text-lg font-montserrat font-bold sm:leading-none flex-1">
                Official 1-Year Hardware Warranty
              </h2>
            </div>
            <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm font-inter leading-relaxed">
              All TechStore hardware (headphones, keyboards, mice) includes an official 1-year manufacturer warranty covering internal mechanical and electronic defects beyond the 30-day return window.
            </p>
          </section>
          <!-- Section 7 -->
          <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-4 rounded-3xl shadow-sm p-6 sm:p-8 scroll-mt-28" id="contact-returns">
            <div class="flex items-center gap-x-3 border-b border-slate-100 dark:border-slate-800 pb-3">
              <div class="bg-orange-50 dark:bg-orange-500/10 text-orange-600 dark:text-orange-400 h-8 w-8 text-sm font-inter font-bold flex items-center justify-center rounded-xl">
                7
              </div>
              <h2 class="text-slate-900 dark:text-white text-base sm:text-lg font-montserrat font-bold sm:leading-none flex-1">
                Contact Returns Support
              </h2>
            </div>
            <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm font-inter leading-relaxed">
              Need help returning a product or checking your refund status? Reach out to our dedicated returns team:
            </p>
            <div class="bg-slate-50/70 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-800 text-xs sm:text-sm font-inter space-y-1 rounded-2xl p-4">
              <p class="text-slate-900 dark:text-white font-bold">TechStore Customer Support & Returns</p>
              <p class="text-slate-500">Email: <a href="mailto:returns@techstore.com" class="text-orange-600 dark:text-orange-400 hover:underline">returns@techstore.com</a></p>
              <p class="text-slate-500">Support Hours: Monday – Saturday, 8:00 AM – 8:00 PM EST</p>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>
  <!-- Footer -->
  <%- include("../partials/footer") %>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/user.js"></script>
</body>

</html>