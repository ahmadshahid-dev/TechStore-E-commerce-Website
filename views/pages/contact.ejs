<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Get in touch with TechStore customer support for orders, product queries, returns, and wholesale inquiries." />
  <meta name="keywords" content="Contact TechStore, customer support, tech store help, order inquiry">
  <title>Contact Us | TechStore</title>
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100
antialiased selection:bg-orange-500 selection:text-white">
  <!-- Header -->
  <%- include("../partials/header") %>
  <main>
    <!-- ==================== 1. HERO / INTRO SECTION ==================== -->
    <section class="relative border-b border-slate-200/80 dark:border-slate-800/80
    py-8 sm:py-10 lg:py-12 overflow-hidden">
      <!-- Ambient Glow -->
      <div class="bg-orange-500/10 w-96 h-96 absolute -top-24 left-1/2 -translate-x-1/2 rounded-full blur-3xl pointer-events-none"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <!-- Badge -->
        <div class="bg-orange-50 dark:bg-orange-950/40 inline-flex items-center gap-2 py-2.5 px-3.5 border border-orange-200 dark:border-orange-900/60 rounded-full shadow-sm mb-5">
          <span class="bg-orange-500 h-2 w-2 rounded-full animate-pulse"></span>
          <span class="text-orange-600 dark:text-orange-400 text-xs font-montserrat font-bold leading-none uppercase tracking-wider">
            We're Here To Help
          </span>
        </div>
        <h1 class="text-slate-900 dark:text-white text-3xl sm:text-4xl lg:text-5xl font-montserrat leading-none font-extrabold tracking-tight mb-2.5">
          Get In <span class="text-orange-600 dark:text-orange-400">Touch</span>
        </h1>
        <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base font-inter max-w-xl mx-auto leading-relaxed">
          Have questions about a product, order tracking, or warranty? Our dedicated support team is available 24/7.
        </p>
      </div>
    </section>
    <!-- ==================== 2. MAIN CONTACT SECTION (2-COLUMNS) ==================== -->
    <section class="border-b border-slate-200/80 dark:border-slate-800/80 py-8
    sm:py-10 lg:py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
          <!-- Left Column: Support Channels & Direct Info (Span 5) -->
          <div class="lg:col-span-5 space-y-6">
            <div class="space-y-1.5">
              <span class="text-orange-600 dark:text-orange-400 text-xs font-montserrat font-bold uppercase tracking-wider block">Direct Channels</span>
              <h2 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-bold  leading-none mb-2.5">
                Reach Out Directly
              </h2>
              <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm font-inter leading-relaxed">
                Prefer chatting directly? Use any of the channels below for fast responses.
              </p>
            </div>
            <!-- Contact Cards -->
            <div class="space-y-4">
              <!-- Card 1: Email -->
              <a class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm hover:shadow-md hover:border-orange-500/50 flex items-start gap-x-4 p-4 group" href="mailto:techstore@gmail.com">
                <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform ease-in-out duration-300">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-slate-900 dark:text-white text-sm font-montserrat font-bold">Email Us</h3>
                  <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">techstore@gmail.com</p>
                  <span class="text-emerald-600 dark:text-emerald-400 text-[0.70rem] font-inter">Avg reply time: &lt; 2 hours</span>
                </div>
              </a>
              <!-- Card 2: Phone / WhatsApp -->
              <a href="https://wa.me/923001500555" target="_blank" rel="noopener noreferrer" class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm hover:shadow-md hover:border-orange-500/50 flex items-start gap-x-4 p-4 group">
                <div class="bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform ease-in-out duration-300">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-slate-900 dark:text-white text-sm font-montserrat font-bold">Call / WhatsApp</h3>
                  <p class="text-slate-500 dark:text-slate-400 text-xs font-inter">+92 300 1500 555</p>
                  <span class="text-slate-400 text-[0.70rem] font-inter">Mon - Sat: 9:00 AM - 9:00 PM</span>
                </div>
              </a>
              <!-- Card 3: Location -->
              <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm flex items-start gap-x-4 p-4">
                <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-slate-900 dark:text-white text-sm font-montserrat font-bold">Store Location</h3>
                  <p class="text-slate-500 dark:text-slate-400 text-xs font-inter leading-relaxed">
                    Rahim Yar Khan, Punjab, Pakistan
                  </p>
                </div>
              </div>
            </div>
          </div>
          <!-- Right Column: Interactive Contact Form (Span 7) -->
          <div class="lg:col-span-7">
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-xl dark:shadow-2xl overflow-hidden">
              <!-- Form Header -->
              <div class="bg-gradient-to-b from-orange-500/10 via-transparent to-transparent border-b border-slate-100 dark:border-slate-800/60 p-6 sm:p-8 pb-4">
                <h2 class="text-slate-900 dark:text-white text-xl sm:text-2xl font-montserrat font-bold leading-none mb-2.5">
                  Send Us a Message
                </h2>
                <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm font-inter">
                  Fill out the form below and we will get back to you promptly.
                </p>
              </div>
              <!-- Form -->
              <form class="space-y-4 p-6 lg:p-8" id="contact-form">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <!-- Name -->
                  <div class="space-y-1.5">
                    <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="name">
                      Your Name <span class="text-rose-500">*</span>
                    </label>
                    <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400 rounded-xl px-4 py-2.5" type="text" name="name" id="name" autocomplete="name" placeholder="John Doe" required />
                    <p class="error text-rose-500 text-xs font-inter" id="error-name"></p>
                  </div>
                  <!-- Email -->
                  <div class="space-y-1.5">
                    <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="email">
                      Email Address <span class="text-rose-500">*</span>
                    </label>
                    <input class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400 rounded-xl px-4 py-2.5" type="email" name="email" id="email" autocomplete="email" placeholder="john@example.com" required />
                    <p class="error text-rose-500 text-xs font-inter" id="error-email"></p>
                  </div>
                </div>
                <!-- Subject Selection -->
                <div class="space-y-1.5">
                  <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="subject">
                    Subject <span class="text-rose-500">*</span>
                  </label>
                  <select class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400 rounded-xl px-4 py-3 cursor-pointer" name="subject" id="subject" required>
                    <option value="" disabled selected>Select an inquiry topic</option>
                    <option value="OrderInquiry">📦 Order Inquiry & Tracking</option>
                    <option value="ProductQuestion">🎧 Product Specifications & Help</option>
                    <option value="ShippingInformation">🚚 Shipping & Delivery Times</option>
                    <option value="ReturnsRefunds">🔄 Returns & Replacements</option>
                    <option value="WholesaleInquiry">💼 Bulk / Wholesale Orders</option>
                    <option value="Others">💬 Other Inquiry</option>
                  </select>
                  <p class="error text-rose-500 text-xs font-inter" id="error-subject"></p>
                </div>
                <!-- Message Box -->
                <div class="space-y-1.5">
                  <label class="text-slate-600 dark:text-slate-300 text-xs font-inter font-semibold uppercase tracking-wider block" for="message">
                    Your Message <span class="text-rose-500">*</span>
                  </label>
                  <textarea class="bg-slate-50/50 dark:bg-slate-800/50 text-slate-900 dark:text-white w-full text-sm font-inter border border-slate-300 dark:border-slate-700 focus:bg-white dark:focus:bg-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400 rounded-xl p-4 resize-none" name="message" id="message" rows="4" placeholder="Please describe how we can assist you..." required></textarea>
                  <p class="error text-rose-500 text-xs font-inter" id="error-message"></p>
                </div>
                <!-- Submit Button -->
                <button class="bg-orange-600 w-full text-white py-3 px-6 flex items-center justify-center gap-x-2 rounded-xl shadow-lg shadow-orange-500/25 hover:shadow-orange-500/35 hover:bg-orange-700 active:scale-[0.98] cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed transition ease-out duration-[250ms]" type="submit">
                  <svg class="Icon h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                  </svg>
                  <span class="Spinner h-4.25 w-4.25 border-[3px] border-orange-100 border-t-orange-500 shrink-0 rounded-full animate-spin drop-shadow-[0_0_4px_rgba(249,115,22,0.6)] hidden"></span>
                  <span class="Text text-sm font-montserrat font-semibold">Send Message</span>
                </button>
                <!-- Urgent Help Tip Box -->
                <div class="bg-slate-50 dark:bg-slate-800/50 border border-slate-200/80 dark:border-slate-700/60 rounded-xl flex items-start gap-2.5 p-3 ">
                  <span class="text-base">💡</span>
                  <p class="text-xs text-slate-600 dark:text-slate-400 font-inter leading-relaxed">
                    <strong>Need immediate assistance?</strong> You can also reach out to our WhatsApp hotline for real-time live support.
                  </p>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- ==================== 3. GOOGLE MAP SECTION ==================== -->
    <section class="backdrop-blur-md py-8 sm:py-10 lg:py-12 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-xl mx-auto space-y-1.5 mb-8 sm:mb-10">
          <span class="text-orange-600 dark:text-orange-400 text-xs font-montserrat font-bold uppercase tracking-wider block">Our Location</span>
          <h2 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-bold leading-none mb-2.5">
            Where To Find Us
          </h2>
          <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm font-inter">
            Drop by our headquarters or dispatch warehouse.
          </p>
        </div>
        <!-- Map Container -->
        <div class="border border-slate-200/80 dark:border-slate-800 shadow-xl 
        dark:shadow-2xl rounded-3xl overflow-hidden">
          <iframe class="w-full h-80 sm:h-96 md:h-[420px]" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d56146.70623137582!2d70.26280274427411!3d28.414152793542257!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39375c713b45db39%3A0x28af23c1672a0170!2sRahim%20Yar%20Khan%2C%20Pakistan!5e0!3m2!1sen!2s!4v1775320569326!5m2!1sen!2s" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
      </div>
    </section>
  </main>
  <!-- Footer -->
  <%- include("../partials/footer") %>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/app.js"></script>
</body>

</html>