<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Search Results | TechStore</title>
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100
antialiased selection:bg-orange-500 selection:text-white">
  <!-- Header -->
  <%- include("../partials/header") %>
  <!-- Main -->
  <main>
    <!-- ==================== 1. SEARCH HEADER BANNER ==================== -->
    <section class="dark:border-slate-800/80 bg-white/60 border-b border-slate-200/80 
    dark:bg-slate-900/60 backdrop-blur-md py-8 sm:py-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <!-- Breadcrumb & Search Title -->
          <div class="space-y-1.5">
            <div class="text-slate-500 dark:text-slate-400 text-xs font-inter flex items-center gap-x-2">
              <a href="/" class="hover:text-orange-600 dark:hover:text-orange-400 hover:transition-colors">Home</a>
              <span>/</span>
              <span class="text-slate-800 dark:text-slate-200 font-semibold">Search</span>
            </div>
            <h1 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-extrabold leading-none tracking-tight">
              Search <span class="text-orange-600 dark:text-orange-400">Products</span>
            </h1>
          </div>
          <!-- Quick Result Count Badge (If products exist) -->
          <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-700 dark:text-orange-300 w-fit text-xs font-montserrat font-bold border border-orange-200 dark:border-orange-900/50 rounded-xl flex items-center gap-2 py-1.5 px-3.5">
            <span class="bg-orange-500 h-2 w-2 rounded-full animate-pulse"></span>
            <span>Found <%= products.length %> <%= products.length === 1 ? 'Product' : 'Products' %></span>
          </div>
        </div>
      </div>
    </section>
    <!-- ==================== 2. MAIN RESULTS / EMPTY STATE SECTION ==================== -->
    <section class="backdrop-blur-md py-8 sm:py-10 lg:py-12 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- ================= SCENARIO A: ERROR OR NO RESULTS FOUND ================= -->
        <% if (error || !products || products.length === 0) { %>
        <div class="max-w-lg mx-auto text-center py-5 px-4 space-y-6">
          <!-- Modern Search-X Icon with Ambient Glow -->
          <div class="relative flex items-center justify-center">
            <div class="bg-orange-50 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 h-20 w-20 border border-orange-200/80 dark:border-orange-900/50 rounded-full shadow-sm flex items-center justify-center">
              <svg class="h-12 w-12 mt-0.5 ml-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search-x preview-icon"><path d="m13.5 8.5-5 5"/><path d="m8.5 8.5 5 5"/><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
          </div>
          <!-- Error Headings -->
          <div class="space-y-2">
            <h2 class="text-slate-900 dark:text-white text-2xl sm:text-3xl font-montserrat font-bold leading-none tracking-tight mb-2.5">
              <%= typeof error !== 'undefined' && error ? error : 'Search Not Found!' %>
            </h2>
            <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm font-inter leading-relaxed">
              We couldn't find any products matching your search keyword. Check your spelling or try searching for broader terms.
            </p>
          </div>
          <!-- In-Page Quick Search Box -->
          <form class="search-form max-w-md mx-auto" action="/search" method="GET" role="search" data-search="searchPage" data-suggestions="suggestionsListPage" aria-label="Site Search">
            <div class="relative">
              <label for="searchPage" class="sr-only">Search</label>
              <svg class="text-slate-400 h-4 w-4 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input class="bg-white dark:bg-slate-900 text-slate-900 dark:text-white w-full text-xs sm:text-sm font-inter border border-slate-300 dark:border-slate-800 focus:border-orange-500 focus:ring focus:ring-orange-500/20 focus:outline-none placeholder:text-slate-400 rounded-xl shadow-sm py-3 pl-10 pr-24" id="searchPage" type="search" name="search" autocomplete="off" placeholder="Search headphones, keyboards, mice..." required />
              <button type="submit" class="bg-orange-600 text-white text-xs font-montserrat font-bold absolute right-1.5 top-1/2 -translate-y-1/2 py-1.5 px-3.5 rounded-lg shadow-sm cursor-pointer hover:bg-orange-700 transition-colors">
                Search
              </button>
              <!-- Search Suggestions Dropdown -->
              <ul class="bg-white dark:bg-slate-900/95 w-full absolute top-full left-0 border border-slate-200/80 dark:border-slate-800/80 rounded-2xl shadow-xl dark:shadow-2xl z-50 py-3.5 hidden" id="suggestionsListPage" role="listbox"></ul>
            </div>
          </form>
          <!-- Popular Suggestions Chips -->
          <div class="pt-2.5">
            <span class="text-slate-400 text-xs font-inter block mb-2">Try popular categories:</span>
            <div class="flex flex-wrap items-center justify-center gap-2">
              <a href="/category/headphones" class="bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-xs font-inter font-medium border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm py-1.5 px-3 hover:text-orange-600 dark:hover:text-orange-400 hover:border-orange-500">
                🎧 Headphones
              </a>
              <a href="/category/keyboards" class="bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-xs font-inter font-medium border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm py-1.5 px-3 hover:text-orange-600 dark:hover:text-orange-400 hover:border-orange-500">
                ⌨️ Keyboards
              </a>
              <a href="/category/mice" class="bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-xs font-inter font-medium border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm py-1.5 px-3 hover:text-orange-600 dark:hover:text-orange-400 hover:border-orange-500">
                🖱️ Gaming Mice
              </a>
            </div>
          </div>
          <!-- Back to Home CTA -->
          <div class="pt-3.5">
            <a href="/" class="bg-slate-900 dark:bg-white text-white dark:text-slate-900 inline-flex items-center gap-2 rounded-xl shadow-md py-2.5 px-6 hover:bg-slate-800 transition-colors dark:hover:bg-slate-100">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
              </svg>
              <span class="text-xs font-montserrat font-bold">Back to Home</span>
            </a>
          </div>
        </div>
        <!-- ================= SCENARIO B: PRODUCTS FOUND GRID ================= -->
        <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 
          gap-4 sm:gap-6">
          <% products.forEach((product) => { %>
          <%- include("../partials/product", { product }) %>
          <% }) %>
        </div>
        <% } %>
      </div>
    </section>
  </main>
  <!-- Footer -->
  <%- include("../partials/footer") %>
  <!-- Scripts -->
  <script src="/js/script.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/user.js"></script>
</body>

</html>